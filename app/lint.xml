<?xml version="1.0" encoding="utf-8"?>
<!--
    Lint tolerates no warning in this project (SPEC §14). The exceptions
    below are the ones that would otherwise punish a deliberate state.
-->
<lint>
    <!--
        The started translation files still hold their English text, which a
        per-language spellchecker reads as a string of misspellings — "area"
        offered as "área" in the Spanish file, and so on for every word.

        The check is switched off for those files only, and comes back the
        moment a language is really translated: `values/` and `values-en/`
        keep it. Remove a folder from this list when its translation lands.
    -->
    <issue id="Typos">
        <ignore path="src/main/res/values-ar/strings.xml" />
        <ignore path="src/main/res/values-de/strings.xml" />
        <ignore path="src/main/res/values-es/strings.xml" />
        <ignore path="src/main/res/values-it/strings.xml" />
        <ignore path="src/main/res/values-nl/strings.xml" />
        <ignore path="src/main/res/values-pl/strings.xml" />
        <ignore path="src/main/res/values-pt/strings.xml" />
        <ignore path="src/main/res/values-zh/strings.xml" />
    </issue>

    <!--
        "My places" (SPEC §7.6) arrived written in English and in French, and
        the other thirty started files are owed it. They are a translation of
        their own (SPEC §9) and are written in one pass, by whoever writes the
        language rather than by whoever wrote the screen — seeding thirty files
        with English text would only make the gap harder to find.

        This is the one deliberate state on the list that is meant to be
        short-lived: delete this whole block the day those strings are
        translated, and lint will name any that were missed.
    -->
    <issue id="MissingTranslation">
        <ignore regexp="&quot;settings_place_|&quot;settings_section_places&quot;" />
    </issue>
</lint>
