{
  "version": 8,
  "name": "Roue Libre",
  "metadata": {
    "roue-libre:comment": [
      "Base map style — SPEC.md §4.2 and §7.",
      "",
      "Everything between double braces is replaced at load time: the colours",
      "come from the tokens in res/values/colors.xml, and the path to the",
      "tiles is only known at run time, since the file is installed in the",
      "application's private storage.",
      "",
      "No remote URL. The tiles are read from disk and the glyphs live in the",
      "APK: drawing the map sends no request out (§2, C3).",
      "",
      "No sprite sheet: markers are drawn as circles rather than icons. It is",
      "plainer, and it avoids embedding a sheet of images for a handful of",
      "symbols."
    ]
  },
  "glyphs": "asset://glyphs/{fontstack}/{range}.pbf",
  "sources": {
    "vector": {
      "type": "vector",
      "url": "mbtiles://{{tilesPath}}"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "{{map_land}}" }
    },
    {
      "id": "greenery",
      "type": "fill",
      "source": "vector",
      "source-layer": "landcover",
      "paint": { "fill-color": "{{map_greenery}}" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "vector",
      "source-layer": "water",
      "paint": { "fill-color": "{{map_water}}" }
    },
    {
      "id": "waterways",
      "type": "line",
      "source": "vector",
      "source-layer": "waterway",
      "paint": {
        "line-color": "{{map_water}}",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.8, 16, 4]
      }
    },
    {
      "id": "municipal-boundaries",
      "type": "line",
      "source": "vector",
      "source-layer": "boundary",
      "paint": {
        "line-color": "{{map_boundary}}",
        "line-width": 1,
        "line-dasharray": [3, 3]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "vector",
      "source-layer": "building",
      "minzoom": 15,
      "paint": {
        "fill-color": "{{map_building}}",
        "fill-outline-color": "{{map_building_edge}}",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 15, 0, 15.6, 1]
      }
    },
    {
      "id": "minor-roads",
      "type": "line",
      "source": "vector",
      "source-layer": "road_minor",
      "minzoom": 13,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "{{map_road_minor}}",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.6, 16, 6]
      }
    },
    {
      "id": "major-roads-outline",
      "type": "line",
      "source": "vector",
      "source-layer": "road_major",
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "{{map_road_major_edge}}",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1.4, 16, 12]
      }
    },
    {
      "id": "major-roads",
      "type": "line",
      "source": "vector",
      "source-layer": "road_major",
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "{{map_road_major}}",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.6, 16, 9]
      }
    },
    {
      "id": "railways",
      "type": "line",
      "source": "vector",
      "source-layer": "railway",
      "paint": {
        "line-color": "{{map_rail}}",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.5, 16, 2],
        "line-dasharray": [4, 3]
      }
    },
    {
      "id": "bus-stops",
      "type": "circle",
      "source": "vector",
      "source-layer": "busstop",
      "minzoom": 15,
      "paint": {
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 15, 1.2, 16, 2],
        "circle-color": "{{map_marker_minor}}",
        "circle-opacity": 0.7
      }
    },
    {
      "id": "landmarks",
      "type": "circle",
      "source": "vector",
      "source-layer": "poi",
      "minzoom": 13.5,
      "paint": {
        "circle-radius": 2.4,
        "circle-color": "{{map_marker_minor}}"
      }
    },
    {
      "id": "transit",
      "type": "circle",
      "source": "vector",
      "source-layer": "transit",
      "paint": {
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 10, 1.8, 16, 4.5],
        "circle-color": "{{map_label_strong}}",
        "circle-stroke-width": ["interpolate", ["linear"], ["zoom"], 12, 0, 14, 1.5],
        "circle-stroke-color": "{{map_label_halo}}"
      }
    },
    {
      "id": "street-labels",
      "type": "symbol",
      "source": "vector",
      "source-layer": "road_minor",
      "minzoom": 15,
      "filter": ["has", "name"],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "name"],
        "text-font": ["Atkinson Hyperlegible Regular"],
        "text-size": 11,
        "text-letter-spacing": 0.02,
        "text-max-angle": 35,
        "symbol-spacing": 260
      },
      "paint": {
        "text-color": "{{map_label}}",
        "text-halo-color": "{{map_label_halo}}",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "vector",
      "source-layer": "road_major",
      "minzoom": 13,
      "filter": ["has", "name"],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "name"],
        "text-font": ["Atkinson Hyperlegible Regular"],
        "text-size": 12,
        "text-max-angle": 35,
        "symbol-spacing": 300
      },
      "paint": {
        "text-color": "{{map_label}}",
        "text-halo-color": "{{map_label_halo}}",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "transit-labels",
      "type": "symbol",
      "source": "vector",
      "source-layer": "transit",
      "minzoom": 13,
      "filter": ["has", "name"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Atkinson Hyperlegible Regular"],
        "text-size": 11,
        "text-anchor": "left",
        "text-offset": [0.7, 0],
        "text-optional": true
      },
      "paint": {
        "text-color": "{{map_label}}",
        "text-halo-color": "{{map_label_halo}}",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "landmark-labels",
      "type": "symbol",
      "source": "vector",
      "source-layer": "poi",
      "minzoom": 14.5,
      "filter": ["has", "name"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Atkinson Hyperlegible Regular"],
        "text-size": 10.5,
        "text-anchor": "top",
        "text-offset": [0, 0.5],
        "text-max-width": 8,
        "text-optional": true
      },
      "paint": {
        "text-color": "{{map_label}}",
        "text-halo-color": "{{map_label_halo}}",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "municipality-labels",
      "type": "symbol",
      "source": "vector",
      "source-layer": "place",
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Atkinson Hyperlegible Bold"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10,
          ["case", ["==", ["get", "place"], "city"], 14, 10],
          14,
          ["case", ["==", ["get", "place"], "city"], 20, 13]
        ],
        "text-letter-spacing": 0.06,
        "text-max-width": 9,
        "text-transform": "uppercase"
      },
      "paint": {
        "text-color": "{{map_label_strong}}",
        "text-halo-color": "{{map_label_halo}}",
        "text-halo-width": 1.8
      }
    }
  ]
}
