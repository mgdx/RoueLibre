# Urban walking profile — Roue Libre
#
# Serves the two access legs of a walk → bike → walk journey (SPEC.md §5). It
# is written for the town: pavements, crossings, covered passages. It is not a
# hiking profile — no technical gradient, no sac_scale, no mountain path.
#
# The cost factors multiply distance. A factor of 2 means a detour of up to
# twice the length will be accepted to avoid that kind of way. They express
# COMFORT and nothing else: not one of them enters the duration the engine
# reports, which is what a journey is compared on (SPEC.md §6).
#
# The pace is the engine's own, and it is not uniform. BRouter times a foot
# profile with Tobler's hiking function, capped at the default `maxSpeed` of
# 6 km/h this file does not override, so every segment is timed on its own
# slope. Measured over six legs of the Lille graph on 16 August 2026 — 314 m to
# 10.2 km — whole legs come out between 1.39 and 1.44 m/s, that is 5.0 to
# 5.2 km/h; the spread comes from the descents, where the function reaches its
# ceiling.
#
# What the application does with that duration is scale it by the walking pace
# the user chose, in `core` and in plain Kotlin (SPEC.md §6, §7.6): the minutes
# are multiplied, the track and its distance untouched — the same streets are
# walked whether one dawdles or hurries. Until 16 August 2026 this comment said
# the application applied a uniform walking speed here. It never did: no code
# touched the engine's figure at all.
#
# Licence: GPLv3, like the rest of the project.

---context:global

assign validForFoot = true

# No spoken instructions: turn-by-turn navigation is out of scope (§13).
assign turnInstructionMode = 0

# Flat terrain. The Lille metropolis peaks at some fifty metres, and on foot a
# climb of that size justifies no detour at all.
assign downhillcost = 0
assign uphillcost = 0

---context:way

# A pedestrian turns without losing any time: no turn cost, and no cost of
# entering a way.
assign turncost = 0
assign initialcost = 0

# --- access --------------------------------------------------------------

# Pedestrians are explicitly refused.
assign foot_refused = foot=no|private|use_sidepath

# Way closed to all, with no explicit pedestrian permission.
assign closed_to_all =
  and access=no|private not foot=yes|designated|permissive

# Fast roads. They are legally forbidden to pedestrians and have no pavement;
# sending someone onto one would be dangerous, not merely unpleasant.
assign motorway_like = highway=motorway|motorway_link|trunk|trunk_link

assign is_forbidden = or foot_refused or closed_to_all motorway_like

# --- comfort -------------------------------------------------------------

# Ways made for walking, or from which cars are absent.
assign pedestrian_way =
  highway=footway|pedestrian|path|steps|corridor|platform|living_street

# Quiet ways where a pavement is the rule.
assign quiet_way = highway=residential|service|track|unclassified|road

assign costfactor

  switch is_forbidden 100000

  # Steps slow one down and rule out prams and wheelchairs; they remain
  # passable, hence a moderate penalty rather than a refusal.
  switch highway=steps 1.4

  switch pedestrian_way 1.0

  switch quiet_way 1.1

  # Main roads have pavements, but also noise, junctions and long crossings.
  # The penalty grows with the traffic.
  switch highway=tertiary|tertiary_link 1.3
  switch highway=secondary|secondary_link 1.7
  switch highway=primary|primary_link 2.2

  # A way of no recognised kind but permitted stays usable as a last resort.
  2.5

---context:node

# The obstacles that genuinely block the way. A barrier one can walk round —
# a chicane, a bollard — costs a pedestrian nothing, unlike a bike.
assign initialcost =
  switch or barrier=gate|lift_gate|swing_gate access=no|private 300
  0
