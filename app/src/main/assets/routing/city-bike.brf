# Profil vélo urbain — Roue Libre
#
# Sert le trajet principal, de station à station (SPEC.md §5). Il décrit un
# vélo de libre-service : lourd, une vingtaine de kilos, position droite,
# pneus étroits, pas de suspension, souvent pas de vitesses utiles. Ce n'est ni
# un vélo de route ni un VTT, et les profils amont — fastbike, mtb — le
# serviraient mal.
#
# Les facteurs de coût multiplient la distance. Un facteur de 2 signifie qu'on
# acceptera un détour allant jusqu'au double de la longueur pour éviter ce type
# de voie.
#
# Licence : GPLv3, comme le reste du projet.

---context:global

assign validForBikes = true

assign turnInstructionMode = 0

# La métropole lilloise est plate — une cinquantaine de mètres de dénivelé au
# total. La pénalité de montée n'est donc pas nulle, parce qu'un vélo de
# libre-service pèse lourd et grimpe mal, mais elle reste faible : elle ne
# doit pas provoquer de détour sur un terrain qui n'a pas de vraies côtes.
assign downhillcost = 0
assign downhillcutoff = 2.0
assign uphillcost = 40
assign uphillcutoff = 2.0

---context:way

# Chaque changement de direction coûte : ralentir, regarder, redémarrer un
# vélo lourd. Assez pour préférer un itinéraire simple à longueur égale, pas
# assez pour allonger sensiblement le trajet.
assign turncost = 60

# Coût d'entrée dans une voie : sert à décourager les enchaînements de petits
# tronçons hétérogènes.
assign initialcost = 0

# --- sens interdits ------------------------------------------------------

# Le double-sens cyclable est très répandu dans les zones 30 lilloises : le
# refuser interdirait la moitié du centre-ville.
assign bicycle_may_go_against =
  or oneway:bicycle=no
  or cycleway=opposite|opposite_lane|opposite_track
  highway=living_street|pedestrian

assign is_wrong_way =
  and reversedirection=yes
  and oneway=yes|true|1
  not bicycle_may_go_against

# --- accès ---------------------------------------------------------------

assign bicycle_refused = bicycle=no|private|use_sidepath

assign closed_to_all =
  and access=no|private not bicycle=yes|designated|permissive

# Voies rapides : interdites au vélo, et mortelles si l'on s'y trompe.
assign motorway_like = highway=motorway|motorway_link|trunk|trunk_link

assign is_forbidden =
  or is_wrong_way or bicycle_refused or closed_to_all motorway_like

# --- revêtement ----------------------------------------------------------

# Le pavé est partout dans le Nord, et c'est le vrai sujet de confort pour un
# vélo sans suspension à pneus étroits. Un pavé de qualité reste roulable, un
# pavé ancien secoue au point qu'on préfère nettement contourner.
assign surface_penalty =
  switch surface=asphalt|paved|concrete|paving_stones|metal|wood 1.0
  switch surface=sett 1.5
  switch surface=cobblestone 2.0
  switch surface=compacted|fine_gravel 1.3
  switch surface=gravel|ground|dirt|earth|grass|sand|mud 2.4
  # Revêtement non renseigné : en ville, c'est de l'asphalte neuf fois sur dix.
  1.0

# --- type de voie --------------------------------------------------------

# Aménagements faits pour le vélo.
assign cycle_way =
  or highway=cycleway
  or cyclestreet=yes
  or bicycle_road=yes
  and highway=path|footway bicycle=designated

# Voies apaisées où le vélo circule bien avec les voitures.
assign calm_way = highway=living_street|residential|service|unclassified|road

assign base_cost

  switch is_forbidden 100000

  # Les marches se franchissent vélo à la main. C'est possible, jamais
  # souhaitable, et un vélo de libre-service est trop lourd pour le faire de
  # bon cœur.
  switch highway=steps 40

  # Une aire piétonne se traverse au pas. Tolérée, jamais préférée.
  switch highway=pedestrian 3.0

  # Un trottoir sans autorisation cyclable : praticable à pied, à éviter.
  switch and highway=footway not bicycle=designated|yes 8.0

  switch cycle_way 1.0
  switch calm_way 1.2
  switch highway=track 1.8

  switch highway=tertiary|tertiary_link 1.5
  switch highway=secondary|secondary_link 2.1
  switch highway=primary|primary_link 3.0

  2.5

# Le coût final combine le type de voie et son revêtement : une piste cyclable
# pavée n'est pas une piste cyclable lisse.
assign costfactor
  switch equal base_cost 100000 100000
  multiply base_cost surface_penalty

---context:node

# Ce qui oblige à descendre de vélo, ou l'interdit franchement.
assign initialcost =
  switch bicycle=no|private 1000000
  # Une barrière à contourner coûte le temps de mettre pied à terre.
  switch barrier=gate|lift_gate|swing_gate|cycle_barrier|block|bollard 400
  # Un feu tricolore coûte une attente moyenne, ce qui justifie un léger
  # détour par un itinéraire qui en compte moins.
  switch highway=traffic_signals 120
  0
