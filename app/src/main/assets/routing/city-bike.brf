# City bike profile — Roue Libre
#
# Serves the main leg, from station to station (SPEC.md §5). It describes a
# bike-share bike: heavy, some twenty kilos, upright riding position, narrow
# tyres, no suspension, often no usable gears. It is neither a road bike nor a
# mountain bike, and the upstream profiles — fastbike, mtb — would serve it
# badly.
#
# The cost factors multiply distance. A factor of 2 means a detour of up to
# twice the length will be accepted to avoid that kind of way.
#
# Licence: GPLv3, like the rest of the project.

---context:global

assign validForBikes = true

assign turnInstructionMode = 0

# The Lille metropolis is flat — some fifty metres of climb in all. The uphill
# penalty is therefore not zero, because a bike-share bike is heavy and climbs
# poorly, but it stays low: it must not cause a detour on terrain that has no
# real hills.
assign downhillcost = 0
assign downhillcutoff = 2.0
assign uphillcost = 40
assign uphillcutoff = 2.0

---context:way

# Every change of direction costs: slowing down, looking, and getting a heavy
# bike moving again. Enough to prefer a simple route at equal length, not
# enough to lengthen the journey appreciably.
assign turncost = 60

# Cost of entering a way: discourages chains of short, mismatched sections.
assign initialcost = 0

# --- wrong ways ----------------------------------------------------------

# Contraflow cycling is very common in Lille's 30 km/h zones: refusing it
# would rule out half the city centre.
assign bicycle_may_go_against =
  or oneway:bicycle=no
  or cycleway=opposite|opposite_lane|opposite_track
  highway=living_street|pedestrian

assign is_wrong_way =
  and reversedirection=yes
  and oneway=yes|true|1
  not bicycle_may_go_against

# --- access --------------------------------------------------------------

assign bicycle_refused = bicycle=no|private|use_sidepath

assign closed_to_all =
  and access=no|private not bicycle=yes|designated|permissive

# Fast roads: forbidden to bikes, and deadly if one strays onto them.
assign motorway_like = highway=motorway|motorway_link|trunk|trunk_link

assign is_forbidden =
  or is_wrong_way or bicycle_refused or closed_to_all motorway_like

# --- surface -------------------------------------------------------------

# Cobbles are everywhere in the North, and they are the real comfort question
# for a bike with no suspension and narrow tyres. Good-quality setts stay
# rideable; old cobbles shake enough that one would clearly rather go round.
assign surface_penalty =
  switch surface=asphalt|paved|concrete|paving_stones|metal|wood 1.0
  switch surface=sett 1.5
  switch surface=cobblestone 2.0
  switch surface=compacted|fine_gravel 1.3
  switch surface=gravel|ground|dirt|earth|grass|sand|mud 2.4
  # Surface not stated: in town, it is asphalt nine times out of ten.
  1.0

# --- kind of way ---------------------------------------------------------

# Infrastructure built for cycling.
assign cycle_way =
  or highway=cycleway
  or cyclestreet=yes
  or bicycle_road=yes
  and highway=path|footway bicycle=designated

# Calmed streets where a bike mixes well with cars.
assign calm_way = highway=living_street|residential|service|unclassified|road

assign base_cost

  switch is_forbidden 100000

  # Steps are taken with the bike in hand. It is possible, never desirable,
  # and a bike-share bike is too heavy to do it willingly.
  switch highway=steps 40

  # A pedestrian area is crossed at walking pace. Tolerated, never preferred.
  switch highway=pedestrian 3.0

  # A pavement with no cycling permission: passable on foot, to be avoided.
  switch and highway=footway not bicycle=designated|yes 8.0

  switch cycle_way 1.0
  switch calm_way 1.2
  switch highway=track 1.8

  switch highway=tertiary|tertiary_link 1.5
  switch highway=secondary|secondary_link 2.1
  switch highway=primary|primary_link 3.0

  2.5

# The final cost combines the kind of way with its surface: a cobbled cycle
# track is not a smooth cycle track.
assign costfactor
  switch equal base_cost 100000 100000
  multiply base_cost surface_penalty

---context:node

# What forces one off the bike, or forbids it outright.
assign initialcost =
  switch bicycle=no|private 1000000
  # A barrier to get round costs the time of putting a foot down.
  switch barrier=gate|lift_gate|swing_gate|cycle_barrier|block|bollard 400
  # Traffic lights cost an average wait, which justifies a slight detour by a
  # route that has fewer of them.
  switch highway=traffic_signals 120
  0
