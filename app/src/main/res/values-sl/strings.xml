        <item quantity="one">kolo</item>
        <item quantity="two">kolesi</item>
        <item quantity="few">kolesa</item>
        <item quantity="other">koles</item>
    </plurals>
    <plurals name="counterpart_docks" tools:ignore="ImpliedQuantity">
        <item quantity="one">prosto mesto</item>
        <item quantity="two">prosti mesti</item>
        <item quantity="few">prosta mesta</item>
        <item quantity="other">prostih mest</item>
    </plurals>
    <string name="counterpart_none">—</string>

    <!-- The detail line under a station's name, in the list. %1$s is a
         distance or a postcode, %2$d the number of docking points — the
         capacity, hence "stojalo" and not "prosto mesto". -->
    <plurals name="station_detail_with_capacity">
        <item quantity="one">%1$s · %2$d stojalo</item>
        <item quantity="two">%1$s · %2$d stojali</item>
        <item quantity="few">%1$s · %2$d stojala</item>
        <item quantity="other">%1$s · %2$d stojal</item>
    </plurals>

    <!-- What a station's bikes are, where the network lends both kinds side by
         side. Each half is an adjective alone, agreeing with the neuter
         "kolo" the reader supplies: 1 navadno, 2 navadni, 3 navadna,
         5 navadnih. -->
    <string name="station_bikes_split">%1$s · %2$s</string>
    <plurals name="bikes_mechanical">
        <item quantity="one">%1$d navadno</item>
        <item quantity="two">%1$d navadni</item>
        <item quantity="few">%1$d navadna</item>
        <item quantity="other">%1$d navadnih</item>
    </plurals>
    <plurals name="bikes_electric">
        <item quantity="one">%1$d električno</item>
        <item quantity="two">%1$d električni</item>
        <item quantity="few">%1$d električna</item>
        <item quantity="other">%1$d električnih</item>
    </plurals>

    <!-- How old the availability figures are. Android writes this "pred 2
         dnevoma" (`settings:color_contrast_preview_email_send_date`), so
         "pred" carries the instrumental and the whole phrase is built here
         rather than in `freshness_fresh`. The instrumental plural is the same
         word at three as at five, which is why `few` and `other` read alike
         in these three plurals and only in these three. -->
    <string name="freshness_just_now">pravkar</string>
    <plurals name="freshness_seconds">
        <item quantity="one">pred %1$d sekundo</item>
        <item quantity="two">pred %1$d sekundama</item>
        <item quantity="few">pred %1$d sekundami</item>
        <item quantity="other">pred %1$d sekundami</item>
    </plurals>
    <plurals name="freshness_minutes">
        <item quantity="one">pred %1$d minuto</item>
        <item quantity="two">pred %1$d minutama</item>
        <item quantity="few">pred %1$d minutami</item>
        <item quantity="other">pred %1$d minutami</item>
    </plurals>
    <plurals name="freshness_hours">
        <item quantity="one">pred %1$d uro</item>
        <item quantity="two">pred %1$d urama</item>
        <item quantity="few">pred %1$d urami</item>
        <item quantity="other">pred %1$d urami</item>
    </plurals>
    <plurals name="freshness_days">
        <item quantity="one">pred %1$d dnevom</item>
        <item quantity="two">pred %1$d dnevoma</item>
        <item quantity="few">pred %1$d dnevi</item>
        <item quantity="other">pred %1$d dnevi</item>
    </plurals>
    <plurals name="freshness_months">
        <item quantity="one">pred %1$d mesecem</item>
        <item quantity="two">pred %1$d mesecema</item>
