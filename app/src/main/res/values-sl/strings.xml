    <string name="welcome_hello_title">Roue Libre</string>
    <string name="welcome_hello_body">Ta aplikacija prikazuje kolesa za souporabo na zemljevidu in izračuna pot od vrat do vrat: peš do postaje, vožnja s kolesom, nato peš do cilja.\n\nJe prosta in odprtokodna programska oprema. Brez računa, brez oglasov, brez sledilnikov.</string>
    <string name="welcome_privacy_title">Nič ne zapusti tega telefona</string>
    <string name="welcome_privacy_body">Poti se izračunajo na tem telefonu. Naslovi, ki jih iščete, se ne pošljejo nikomur, niti med tipkanjem.\n\nZgodovina se ne shranjuje: ne vaše poti, ne vaši položaji, ne vaši cilji.\n\nEdina zahteva, ki v vsakdanji rabi odide ven, sprašuje, koliko koles je na voljo.</string>
    <string name="welcome_fleet_title">Kaj pove kolo</string>
    <string name="welcome_fleet_body">Narisano kolo pove, kaj posoja vaše mesto.\n\nPodatek prihaja iz vira samega omrežja in ni ugibanje.</string>
    <string name="welcome_fleet_mechanical_only">Omrežje posoja samo navadna kolesa.</string>
    <string name="welcome_fleet_electric_only">Omrežje posoja samo električna kolesa.</string>
    <string name="welcome_fleet_mixed">Omrežje posoja obe vrsti.</string>

    <string name="welcome_data_title">Eno mesto, en prenos</string>
    <string name="welcome_data_body">Zemljevid, ulice in izračun poti so v napravi. Prav zato delujejo brez omrežja – in prav zato je treba podatke svojega mesta enkrat prenesti.\n\nZačnite torej z izbiro mesta. Za srednje veliko mestno območje računajte na približno štirideset megabajtov, za prestolnico več; velikost je napovedana pred prenosom.\n\nTo lahko storite tudi pozneje: do takrat ostaneta seznam postaj in njihova razpoložljivost uporabna.</string>
    <string name="welcome_step" tools:ignore="PluralsCandidate">%1$d od %2$d</string>
    <string name="welcome_continue">Nadaljuj</string>
    <string name="welcome_skip">Preskoči</string>
    <string name="welcome_choose_city">Izberi moje mesto</string>
    <string name="welcome_later">Pozneje</string>
    <string name="welcome_open">Znova preberi uvod</string>

