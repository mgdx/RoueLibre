    <string name="map_bikes_electric">Elektriskie</string>
    <string name="map_bikes_all_kinds_description">Tiek skaitīti visi velosipēdi. Pieskarieties, lai skaitītu tikai parastos.</string>
    <string name="map_bikes_mechanical_description">Tiek skaitīti parastie velosipēdi. Pieskarieties, lai skaitītu tikai elektriskos.</string>
    <string name="map_bikes_electric_description">Tiek skaitīti elektriskie velosipēdi. Pieskarieties, lai skaitītu visus.</string>
    <!-- The label under, or beside, a count. No item holds a number: the
         figure is written next to these words already.
         **Latvian departs from the English note here, and on purpose.** The
         English treats these as labels rather than as the tail of the phrase
         the count makes, because a language whose grammar reaches across the
         gap can be caught out by it. Latvian marks the case on the noun and
         nowhere else, so the agreed form IS the label: „14“ over VELOSIPĒDU
         reads right, where a nominative plural over the same figure would be
         plain wrong. Nothing is added at the head of the line, so the capitals
         and the line break cost nothing.
         The one case this leaves crooked is known: `StationAdapter.kt:167`
         resolves the category with `counterpart ?: 0`, so a station whose
         availability the network does not publish shows „—“ over BRĪVU VIETU,
         a genitive plural with no figure to govern. It is the least bad of the
         three forms there and it is accepted, but it is written down. -->
    <plurals name="counterpart_bikes" tools:ignore="ImpliedQuantity">
        <item quantity="one">velosipēds</item>
        <item quantity="zero">velosipēdu</item>
        <item quantity="other">velosipēdi</item>
    </plurals>
    <plurals name="counterpart_docks" tools:ignore="ImpliedQuantity">
        <item quantity="one">brīva vieta</item>
        <item quantity="zero">brīvu vietu</item>
        <item quantity="other">brīvas vietas</item>
    </plurals>
    <!-- Shown instead of the count when the station does not provide the service. -->
    <string name="counterpart_none">—</string>

    <!-- The detail line under a station's name, in the list. %1$s is the
         distance to the station, or its postcode when the position is
         unknown; %2$d is the number of docking points. -->
    <plurals name="station_detail_with_capacity">
        <item quantity="one">%1$s · %2$d statīvs</item>
        <item quantity="zero">%1$s · %2$d statīvu</item>
        <item quantity="other">%1$s · %2$d statīvi</item>
    </plurals>

    <!-- What a station's bikes are, shown only where the network lends both
         kinds. %1$s is the mechanical count, %2$s the electric one. -->
    <string name="station_bikes_split">%1$s · %2$s</string>
    <plurals name="bikes_mechanical">
        <item quantity="one">%1$d parastais</item>
        <item quantity="zero">%1$d parasto</item>
        <item quantity="other">%1$d parastie</item>
    </plurals>
    <plurals name="bikes_electric">
        <item quantity="one">%1$d elektriskais</item>
        <item quantity="zero">%1$d elektrisko</item>
        <item quantity="other">%1$d elektriskie</item>
    </plurals>

    <!-- The age of the availability figures. The preposition *pirms* is built
         into the plural so that both „Dati atjaunināti pirms 5 minūtēm“ and
         „Dati atjaunināti tikko“ come out right from one template. It governs the
         dative plural, which is one form for 5 as for 20, so `zero` and
         `other` read alike here and nowhere else in the file. -->
    <string name="freshness_just_now">tikko</string>
    <plurals name="freshness_seconds">
        <item quantity="one">pirms %1$d sekundes</item>
        <item quantity="zero">pirms %1$d sekundēm</item>
        <item quantity="other">pirms %1$d sekundēm</item>
    </plurals>
    <plurals name="freshness_minutes">
        <item quantity="one">pirms %1$d minūtes</item>
        <item quantity="zero">pirms %1$d minūtēm</item>
        <item quantity="other">pirms %1$d minūtēm</item>
    </plurals>
    <plurals name="freshness_hours">
        <item quantity="one">pirms %1$d stundas</item>
        <item quantity="zero">pirms %1$d stundām</item>
        <item quantity="other">pirms %1$d stundām</item>
    </plurals>
    <plurals name="freshness_days">
        <item quantity="zero">pirms %1$d dienām</item>
        <item quantity="one">pirms %1$d dienas</item>
        <item quantity="other">pirms %1$d dienām</item>
    </plurals>
    <plurals name="freshness_months">
        <item quantity="zero">pirms %1$d mēnešiem</item>
        <item quantity="one">pirms %1$d mēneša</item>
        <item quantity="other">pirms %1$d mēnešiem</item>
    </plurals>
