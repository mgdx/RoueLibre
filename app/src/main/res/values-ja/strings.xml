    <string name="settings_section_city">都市</string>
    <string name="settings_section_journey">経路</string>
    <string name="settings_section_display">表示</string>
    <string name="settings_section_data">オフラインデータ</string>

    <!-- The walking pace (SPEC §6, §7.6). Named in words and never in km/h: a
