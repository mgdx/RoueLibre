<?xml version="1.0" encoding="utf-8"?>
<!--
    Japanese translation.

    Translated from `values/strings.xml`, which is the source (SPEC §9). Its
    comments are carried over here, so that whoever touches a string next
    reads what its placeholders stand for and on which screen it appears.

    The typography is Japanese:
      · no spaces between words, and full-width punctuation — 。、「」（） —
        which already carries the space a Latin mark would need beside it;
      · figures, unit symbols and Latin names stay half-width, with a
        half-width space on each side of the Latin run: 「Wi-Fi に接続」,
        「GBFS 形式」, 「ODbL ライセンス」, 「バージョン %1$d です」;
      · a question keeps its mark, and the mark is full-width ？;
      · the separator the English writes `·` is `・` (U+30FB), set tight;
      · no apostrophe is written at all, so nothing here is escaped;
      · Japanese has one plural category, `other`, and CLDR gives it no
        other: every count has to read for any number, which is what the
        counters are for — 台 for bikes and racks, 分 for minutes, か所 for
        stations — and a count beside a kanji unit carries no leading zero,
        「1時間5分」 rather than the clock's 「1時間05分」;
      · the register is the plain です・ます Android itself writes, with no
        commercial keigo. SPEC §9 asks the French for `tu`; this is what that
        rule asks of Japanese, which has no `tu` to ask for.

    The words settled on, and why, are in docs/ja-glossary.md. See
    CONTRIBUTING.md to submit a correction.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <string name="app_name">Roue Libre</string>

    <!-- Main screen: the station list. -->
    <string name="stations_title">ステーション</string>

    <!-- The number of bikes available to borrow at a station. -->
    <plurals name="bikes_available">
        <item quantity="other">自転車%1$d台</item>
    </plurals>

    <!-- The number of free racks to return a bike into. -->
    <plurals name="docks_available">
        <item quantity="other">空きラック%1$d台</item>
    </plurals>

    <!-- Spoken by screen readers on a station's indicator.
         Example: 「駅前通り、自転車6台、空きラック26台」. -->
    <string name="station_content_description">%1$s、%2$s、%3$s</string>

    <!-- A station the network has taken out of service. Not 圏外, which is
         Android's word for a radio blackspot and says nothing about a rack. -->
    <string name="station_out_of_service">利用停止中</string>
    <string name="station_availability_unknown">空き状況不明</string>

    <!-- What a station is called when its feed publishes no name for it and no
         street to stand in for one. The station itself is kept: it is real and
         it holds bikes, and dropping it would take it off the map over a
         mistyped string. -->
    <string name="station_unnamed">名称のないステーション</string>

    <!-- Shown for a station the network publishes outside the area its data
         covers: it exists and its bikes are counted, but no map and no route
         reach it. The short form joins the rest of the row. -->
    <string name="station_beyond_area_short">地図の範囲外</string>
    <string name="station_beyond_area">このステーションは、インストール済みのデータが対象とする範囲の外にあります。自転車の数はリアルタイムで数えられますが、地図にも経路にも含められません。</string>

    <!-- The search field above the list. It filters stations by name; the
         address search is a different screen (SPEC §4.3). -->
    <string name="search_stations_hint">ステーションを検索</string>
    <string name="search_stations_clear">検索を消去</string>

    <!-- The list is empty because the search matches nothing.
         %1$s is what the user typed. -->
    <string name="stations_no_match_title">ステーションが見つかりません</string>
    <string name="stations_no_match_message">「%1$s」に一致するものはありません。つづりを確かめるか、検索を消去してください。</string>
    <string name="action_clear_search">検索を消去</string>

    <!-- Toggle between borrowing a bike and returning one (SPEC §7.1). -->
    <string name="mode_bikes">自転車</string>
    <string name="mode_docks">空きラック</string>
    <string name="mode_bikes_description">利用できる自転車を表示します</string>
    <string name="mode_docks_description">空きラックを表示します</string>

    <!-- Which bikes the markers count, where the network lends both kinds
         (SPEC §7.1). Named after what is shown, like the toggle beside it. -->
    <string name="map_bikes_all_kinds">すべての自転車</string>
    <string name="map_bikes_mechanical">一般自転車</string>
    <string name="map_bikes_electric">電動アシスト</string>
    <string name="map_bikes_all_kinds_description">すべての自転車を数えています。タップすると一般自転車だけを数えます。</string>
    <string name="map_bikes_mechanical_description">一般自転車を数えています。タップすると電動アシスト自転車だけを数えます。</string>
    <string name="map_bikes_electric_description">電動アシスト自転車を数えています。タップするとすべてを数えます。</string>

    <!-- The label beside a count, on a station's sheet and on a list row.
         No item holds a number, and none ever should: the figure is already
         painted in the disc these words stand next to, so writing it here
         would say it twice. Japanese nouns do not agree in number at all,
         which is why the single `other` reads correctly for every count.
         `CounterpartAgreementTest` fails the day a placeholder comes back. -->
    <plurals name="counterpart_bikes" tools:ignore="ImpliedQuantity">
        <item quantity="other">自転車</item>
    </plurals>
    <plurals name="counterpart_docks" tools:ignore="ImpliedQuantity">
        <item quantity="other">空きラック</item>
    </plurals>
    <!-- Shown instead of the count when the station does not provide the service. -->
    <string name="counterpart_none">—</string>

    <!-- The detail line under a station's name.
         %1$s is a postcode, %2$d the number of racks the station holds — its
         capacity, not its free racks. -->
    <plurals name="station_detail_with_capacity">
        <item quantity="other">%1$s・ラック%2$d台</item>
    </plurals>

    <!-- What a station's bikes are, shown only where the network lends both
         kinds side by side. %1$s is the mechanical count, %2$s the electric
         one, each already agreed in number. -->
    <string name="station_bikes_split">%1$s・%2$s</string>
    <plurals name="bikes_mechanical">
        <item quantity="other">一般車%1$d台</item>
    </plurals>
    <plurals name="bikes_electric">
        <item quantity="other">電動アシスト車%1$d台</item>
    </plurals>

    <!-- The age of the displayed data (SPEC §4.1). -->
    <string name="freshness_just_now">たった今</string>
    <plurals name="freshness_seconds">
        <item quantity="other">%1$d秒前</item>
    </plurals>
    <plurals name="freshness_minutes">
        <item quantity="other">%1$d分前</item>
    </plurals>
    <plurals name="freshness_hours">
        <item quantity="other">%1$d時間前</item>
    </plurals>
    <string name="freshness_long_ago">1日以上前</string>
    <!-- Attached to the age when the data is no longer current.
         Example: 「古いデータ・12分前」. -->
    <string name="freshness_stale">古いデータ・%1$s</string>
    <!-- %1$s is an age, 「5分前」 for instance — and 「たった今」 under five
         seconds, which is why the template carries no particle. -->
    <string name="freshness_fresh">更新：%1$s</string>
    <string name="freshness_never">未更新</string>

    <!-- An empty screen: an invitation to act, not a statement (SPEC §7). -->
    <string name="stations_empty_title">ステーションが読み込まれていません</string>
    <string name="stations_empty_message">一覧を下に引っ張ると、サービスのステーションを取得します。</string>

    <!-- Actions. One gesture keeps one name from the button to the confirmation. -->
    <string name="action_refresh">更新</string>
    <string name="action_retry">再試行</string>

    <!-- The map screen (SPEC §7.1). -->
    <string name="map_open_list">ステーションの一覧を見る</string>
    <!-- The attribution carried by the map itself (SPEC §4.5). It is left in
         English: this is the wording OpenStreetMap asks for, and it fits on
         one line. The full attribution is in "about". -->
    <string name="map_attribution">© OpenStreetMap contributors</string>
    <!-- The "locate me" button and what it can answer (SPEC §7.1, §10). A
         refusal never prompts again: it is noted, not argued with. -->
    <string name="map_locate_me">現在地</string>
    <string name="map_location_denied">位置情報がないので、出発地点を地図か住所で指定してください。</string>
    <string name="map_location_unavailable">現在地を取得できません。位置情報がオンになっているか確かめて、もう一度お試しください。</string>
    <string name="map_outside_city_title">別の地域にいます</string>
    <string name="map_outside_city_message">現在地は%1$sが対象とする範囲の外にあるため、この地図には表示できません。今いる都市を選ぶと、そのステーションを見られます。</string>
    <string name="map_outside_city_brief">現在地は%1$sが対象とする範囲の外にあります。</string>

    <string name="map_needs_tiles_title">地図データがインストールされていません</string>
    <string name="map_needs_tiles_message">ストレージ画面から地図データをインストールしてください。それまでの間も、ステーションの一覧は使えます。</string>
    <!-- The same screen, but before a city has even been designated: it is
         not a file that is missing but the frame for everything else
         (SPEC §15.1). -->
    <string name="map_needs_city_title">どの都市にしますか？</string>
    <string name="map_needs_city_message">利用する都市圏を選んでください。データはそのあとで、一度だけダウンロードします。</string>

    <!-- First launch (SPEC §7.9). We explain how something works, we are not
         selling anything: short sentences, active voice, no jargon. -->
    <string name="welcome_hello_title">Roue Libre</string>
    <string name="welcome_hello_body">このアプリは、シェアサイクルのステーションを地図に表示し、ドアからドアまでの経路を計算します。ステーションまで歩き、自転車で走り、残りを歩く経路です。\n\nオープンソースの自由なソフトウェアです。アカウントも、広告も、トラッカーもありません。</string>
    <string name="welcome_privacy_title">この端末から何も出ていきません</string>
    <string name="welcome_privacy_body">経路はこの端末の中で計算します。検索した住所は、入力している間も含めて、誰にも送信されません。\n\n履歴は残しません。移動も、現在地も、目的地もです。\n\n通常の利用で外に出る通信は、自転車が何台あるかを尋ねるものだけです。</string>
    <string name="welcome_fleet_title">自転車の絵が示すもの</string>
    <string name="welcome_fleet_body">描かれている自転車は、その都市が貸し出す種類を示します。\n\nサービス自身のフィードから読み取ったもので、推測ではありません。</string>
    <string name="welcome_fleet_mechanical_only">このサービスは一般自転車だけを貸し出します。</string>
    <string name="welcome_fleet_electric_only">このサービスは電動アシスト自転車だけを貸し出します。</string>
    <string name="welcome_fleet_mixed">このサービスは両方の種類を貸し出します。</string>

    <string name="welcome_data_title">都市ごとに、ダウンロードは一度</string>
    <string name="welcome_data_body">地図も、道路も、経路の計算も、端末の中にあります。だからこそ通信なしで動きますが、そのために、都市のデータを一度だけダウンロードする必要があります。\n\nまずは都市を選んでください。中規模の都市圏でおよそ 40 MB、首都ならそれ以上です。サイズはダウンロードの前に表示されます。\n\nあとから行うこともできます。それまでの間も、ステーションの一覧と空き状況は使えます。</string>
    <!-- Position in the sequence: 「1/3」. This is not a number agreement but
         a progress marker — the second number does not vary with the first —
         hence the absence of a plural.
         %1$d is the page number, %2$d how many there are. -->
    <string name="welcome_step" tools:ignore="PluralsCandidate">%1$d/%2$d</string>
    <string name="welcome_continue">次へ</string>
    <string name="welcome_skip">スキップ</string>
    <string name="welcome_choose_city">都市を選ぶ</string>
    <string name="welcome_later">あとで</string>
    <string name="welcome_open">紹介をもう一度読む</string>

    <!-- What's new after an update (SPEC §7.10). -->
    <string name="whats_new_title">新機能</string>
    <string name="whats_new_done">続行</string>
    <string name="whats_new_nothing">このバージョンにリリースノートはありません。</string>
    <string name="whats_new_open">新機能を見る</string>

    <!-- A place received from another application (SPEC §7.8). -->
    <string name="incoming_place_default_label">受け取った場所</string>
    <string name="incoming_show_me">表示</string>
    <string name="incoming_needs_index">この住所はオフラインの住所インデックスで調べる必要がありますが、インストールされていません。</string>
    <!-- %1$s is the text received from the other application. -->
    <string name="incoming_address_not_found">「%1$s」は、対象とする範囲のどの住所とも一致しません。</string>
    <string name="incoming_outside_coverage">この場所は、インストール済みのデータが対象とする範囲の外にあります。ここへ向かう経路は計算できません。</string>

    <!-- Favourites (SPEC §7.5). -->
