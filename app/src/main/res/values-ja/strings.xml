    <string name="settings_walking_pace_title">歩くペース</string>
    <string name="settings_walking_pace_slow">ゆっくり</string>
    <string name="settings_walking_pace_normal">ふつう</string>
    <string name="settings_walking_pace_brisk">速め</string>
