    <!-- The welcome carousel, shown once on first launch. -->
    <string name="welcome_hello_title">Roue Libre</string>
    <string name="welcome_hello_body">Ta aplikacja pokazuje rowery miejskie na mapie i wyznacza trasę od drzwi do drzwi: dojście do stacji, przejazd rowerem, a potem reszta drogi pieszo.\n\nTo wolne oprogramowanie o otwartym kodzie. Bez konta, bez reklam, bez śledzenia.</string>
    <string name="welcome_privacy_title">Nic nie opuszcza tego telefonu</string>
    <string name="welcome_privacy_body">Trasy są wyznaczane na tym telefonie. Adresy, których szukasz, nie trafiają do nikogo — nawet w trakcie pisania.\n\nŻadna historia nie jest zapisywana: ani Twoje przejazdy, ani pozycje, ani cele.\n\nJedyne zapytanie, które w codziennym użyciu wychodzi na zewnątrz, pyta o liczbę dostępnych rowerów.</string>
    <string name="welcome_fleet_title">Co mówi rower</string>
    <string name="welcome_fleet_body">Narysowany rower mówi, co wypożycza Twoje miasto.\n\nWynika to z danych samej sieci, nigdy ze zgadywania.</string>
    <string name="welcome_fleet_mechanical_only">Sieć wypożycza tylko zwykłe rowery.</string>
    <string name="welcome_fleet_electric_only">Sieć wypożycza tylko rowery elektryczne.</string>
    <string name="welcome_fleet_mixed">Sieć wypożycza oba rodzaje.</string>

    <string name="welcome_data_title">Jedno miasto, jedno pobranie</string>
    <string name="welcome_data_body">Mapa, ulice i wyznaczanie tras działają na urządzeniu. Właśnie dlatego obywają się bez sieci — i dlatego dane Twojego miasta trzeba raz pobrać.\n\nZacznij więc od jego wyboru. Dla średniej wielkości aglomeracji to około czterdziestu megabajtów, dla stolicy więcej; rozmiar jest podawany przed pobraniem.\n\nMożesz to zrobić także później: do tego czasu lista stacji i dostępność rowerów działają normalnie.</string>
    <string name="welcome_step" tools:ignore="PluralsCandidate">%1$d z %2$d</string>
    <string name="welcome_continue">Dalej</string>
    <string name="welcome_skip">Pomiń</string>
