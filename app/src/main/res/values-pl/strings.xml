<?xml version="1.0" encoding="utf-8"?>
<!--
    Polish translation.

    A translation of `values/strings.xml`, which is the source and the only
    file Android falls back on. The `name` attributes are never touched, the
    placeholders keep their number and their kind, and <plurals> carry the four
    categories Polish distinguishes — `one`, `few`, `many`, `other`. The `few`
    form covers 2-4 but also 22-24 and 32-34, while 12-14 fall into `many`, so
    each form is written to read correctly for every number it takes, not only
    for the smallest.

    Typography of Polish:
      · quotation marks are „ … ”, never « » and never straight quotes;
      · a non-breaking space (U+00A0) follows the one-letter words — w, i, z,
        a, o, u — which may not be left at the end of a line;
      · the diacritics are written in full: ą ć ę ł ń ó ś ź ż;
      · the apostrophe, where a name carries one (Vélib’), is ’ (U+2019) and
        never the straight quote, which is why nothing here is escaped;
      · the dash that breaks a sentence is — with a space on either side.

    Polish declines: a sentence built around a placeholder has to stay correct
    whatever the placeholder holds, so the wording is turned around rather than
    a case ending being glued onto a `%1$s`.

    The terms this file holds to, and the reason for each, are in
    docs/pl-glossary.md. See CONTRIBUTING.md to submit a correction.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <string name="app_name">Roue Libre</string>

    <!-- Main screen: the station list. -->
    <string name="stations_title">Stacje</string>

    <!-- The number of bikes available to borrow at a station. -->
    <plurals name="bikes_available">
        <item quantity="one">%1$d rower</item>
        <item quantity="few">%1$d rowery</item>
        <item quantity="many">%1$d rowerów</item>
        <item quantity="other">%1$d roweru</item>
    </plurals>

    <!-- The number of free docks to return a bike to. -->
    <plurals name="docks_available">
        <item quantity="one">%1$d wolne miejsce</item>
        <item quantity="few">%1$d wolne miejsca</item>
        <item quantity="many">%1$d wolnych miejsc</item>
        <item quantity="other">%1$d wolnego miejsca</item>
    </plurals>

    <!-- Spoken by screen readers on a station's indicator.
         Example: "Marszałkowska, 6 rowerów, 26 wolnych miejsc". -->
    <string name="station_content_description">%1$s, %2$s, %3$s</string>
    <string name="station_out_of_service">Nie działa</string>
    <string name="station_availability_unknown">Nieznana dostępność</string>

    <!-- What a station is called when its feed publishes no name for it and no
         street to stand in for one. The station itself is kept: it is real and
         it holds bikes, and dropping it would take it off the map over a
         mistyped string. -->
    <string name="station_unnamed">Stacja bez nazwy</string>

    <!-- Shown for a station the network publishes outside the area its data
         covers: it exists and its bikes are counted, but no map and no route
         reach it. The short form joins the rest of the row. -->
    <string name="station_beyond_area_short">poza mapą</string>
    <string name="station_beyond_area">Ta stacja leży poza obszarem, który obejmują zainstalowane dane. Jej rowery są liczone na bieżąco, ale nie sięga do niej ani mapa, ani droga.</string>

