    <string name="mode_docks">Wolne miejsca</string>
    <string name="mode_bikes_description">Pokaż dostępne rowery</string>
    <string name="mode_docks_description">Pokaż wolne miejsca</string>

    <!-- Which bikes the markers count, where the network lends both kinds
         (SPEC §7.1). Named after what is shown, like the toggle beside it. -->
    <string name="map_bikes_all_kinds">Wszystkie rowery</string>
    <string name="map_bikes_mechanical">Zwykłe</string>
    <string name="map_bikes_electric">Elektryczne</string>
    <string name="map_bikes_all_kinds_description">Liczone są wszystkie rowery. Kliknij, aby liczyć tylko zwykłe.</string>
    <string name="map_bikes_mechanical_description">Liczone są zwykłe rowery. Kliknij, aby liczyć tylko elektryczne.</string>
    <string name="map_bikes_electric_description">Liczone są rowery elektryczne. Kliknij, aby liczyć wszystkie.</string>

    <!-- The label beside a count, on a station's sheet and on a list row.
         No item holds a number, and none ever should: the figure is already
         painted in the disc these words stand next to, so writing it here
         would say it twice. The word alone agrees, which is why these are
         plurals resolved with the count and formatted with nothing. -->
    <plurals name="counterpart_bikes" tools:ignore="ImpliedQuantity">
        <item quantity="one">rower</item>
        <item quantity="few">rowery</item>
        <item quantity="many">rowerów</item>
        <item quantity="other">roweru</item>
    </plurals>
    <plurals name="counterpart_docks" tools:ignore="ImpliedQuantity">
        <item quantity="one">wolne miejsce</item>
        <item quantity="few">wolne miejsca</item>
        <item quantity="many">wolnych miejsc</item>
        <item quantity="other">wolnego miejsca</item>
    </plurals>
    <string name="counterpart_none">—</string>

    <!-- The detail line under a station's name, in the list.
         %1$s is the distance to the station when the reader's position is
         known, and its postcode when it is not — never both, and never a
         label saying which. %2$d is the number of docking points. -->
    <plurals name="station_detail_with_capacity">
        <item quantity="one">%1$s · %2$d stojak</item>
        <item quantity="few">%1$s · %2$d stojaki</item>
        <item quantity="many">%1$s · %2$d stojaków</item>
        <item quantity="other">%1$s · %2$d stojaka</item>
    </plurals>

    <!-- What a station's bikes are, shown only where the network lends both
         kinds side by side. %1$s is the mechanical count, %2$s the electric
         one, each already agreed in number. The adjectives stand in for
         "zwykłe rowery" and "rowery elektryczne", elided as in English. -->
    <string name="station_bikes_split">%1$s · %2$s</string>
    <plurals name="bikes_mechanical">
        <item quantity="one">%1$d zwykły</item>
        <item quantity="few">%1$d zwykłe</item>
        <item quantity="many">%1$d zwykłych</item>
        <item quantity="other">%1$d zwykłego</item>
    </plurals>
    <plurals name="bikes_electric">
        <item quantity="one">%1$d elektryczny</item>
        <item quantity="few">%1$d elektryczne</item>
        <item quantity="many">%1$d elektrycznych</item>
        <item quantity="other">%1$d elektrycznego</item>
    </plurals>

