<?xml version="1.0" encoding="utf-8"?>
<!--
    Famille de corps de texte : Atkinson Hyperlegible, régulière et grasse.
    Deux graisses suffisent ; en embarquer davantage alourdirait l'APK sans
    servir aucune vue.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/atkinson_regular"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/atkinson_bold"
        android:fontStyle="normal"
        android:fontWeight="700" />
</font-family>
