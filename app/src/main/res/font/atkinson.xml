<?xml version="1.0" encoding="utf-8"?>
<!--
    The body text family: Atkinson Hyperlegible, regular and bold. Two weights
    are enough; embedding more would enlarge the APK without serving any
    view.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/atkinson_regular"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/atkinson_bold"
        android:fontStyle="normal"
        android:fontWeight="700" />
</font-family>
