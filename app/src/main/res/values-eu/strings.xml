    <string name="about_title">About</string>
    <string name="about_open">About</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy_body">No account, no adverts, no tracker, no unique identifier. Nothing you search for or compute leaves this phone: addresses, journeys and your position stay here, and are not kept. The only request that goes out in everyday use fetches bike availability. Datasets are downloaded only when you ask.</string>
    <string name="about_attributions_title">Data sources</string>
    <string name="about_attribution_gbfs">Bike availability: the open data of the network served, published in the GBFS format. In France it is indexed on transport.data.gouv.fr.</string>
    <string name="about_attribution_osm">Map, routing and landmarks: © OpenStreetMap contributors, ODbL licence.</string>
    <string name="about_attribution_ban">Addresses and house numbers: Base Adresse Nationale, ODbL licence.</string>
    <string name="about_attribution_brouter">Routing: BRouter, MIT licence, over OpenStreetMap data.</string>
    <string name="about_attribution_maplibre">Map rendering: MapLibre Native, two-clause BSD licence.</string>
    <string name="about_links_title">Opening a place from another app</string>
    <string name="about_links_body">“geo:” links and addresses shared as plain text come straight here: pick Roue Libre in Android’s chooser. Links from mapping websites need permission: Settings → Apps → Roue Libre → Open by default → Add link.</string>
    <string name="about_licence_title">Licence</string>
    <string name="about_licence_body">Roue Libre is free software, released under the GNU GPL version 3. You may use it, study it, modify it and pass it on.</string>
    <string name="about_open_repository">View the source code</string>
    <string name="about_open_sources">Sources city by city</string>
    <string name="about_open_licences">Component licences</string>

