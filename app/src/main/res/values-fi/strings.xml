        <item quantity="one">%1$d pyörä</item>
        <item quantity="other">%1$d pyörää</item>
    </plurals>

    <!-- The number of free docks to return a bike to. -->
    <plurals name="docks_available">
        <item quantity="one">%1$d vapaa paikka</item>
        <item quantity="other">%1$d vapaata paikkaa</item>
    </plurals>

