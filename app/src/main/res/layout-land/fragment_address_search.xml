<?xml version="1.0" encoding="utf-8"?>
<!--
    Address search (SPEC §4.3), lying down.

    Same screen, same views, same reading — what changes is what the answers
    are measured against. Stacked as in portrait, everything above the list
    costs the same dp whichever way the phone is held: a bar, a field, a line
    of reassurance. On a Fairphone 3 turned sideways with Gboard open the
    window stops at 397 px, the stack takes it all, and the list this screen
    exists for was drawn nowhere: the answers to `vesle` only appeared once the
    keyboard was folded away, which is the one moment the reader no longer
    needs them. `adjustResize` cannot fix that — it hands back a window the
    stack has already spent.

    So the bar and the field share the width with the answers instead of the
    height. Nothing spans both columns: the answers start at the top of the
    screen and end at the bottom of it, and what the keyboard gives back is
    theirs alone.

    Half and not some finer split for the reason written in
    `layout-land/fragment_welcome.xml`: half a sideways Fairphone 3 is 411 dp,
    which is exactly the width the portrait screen gives the same rows, so an
    address wraps and reads as it always has. **The half is a percentage
    anchored to one edge, and no bias**: a bias is measured from the left
    whichever way the language runs, and this screen is read right to left in
    Arabic. Each column carries one anchor and its own half, so the two mirror
    together with the language.

    **The way back stays in the top corner and does not scroll**, which is
    where portrait keeps it and the one corner a keyboard never reaches: the
    keyboard rises from the bottom edge, and everything it can cover is at the
    bottom of the screen. A way back that moved house between two ways of
    holding the phone would be one more thing to look for, and one that scrolled
    out of the column would be a way back only for somebody who had not typed.

    **Under it the column scrolls**, which is what a text size can do to it
    rather than what it can do to the letters (SPEC §7, and the comment beside
    `mode_toggle` in `fragment_map.xml`). At ×2.0 a bar and a field come to
    more than a sideways window holds once the keyboard is up; the field, being
    the focused view, is scrolled back into sight by the scroll view itself
    when the keyboard opens, and nothing is cut.

    What does go is the line of reassurance: the search is explained where
    there is room to explain it, and the sentence about nothing leaving the
    device is worth less than the answers it would push off a sideways screen.
    It keeps its identifier, gone rather than absent, since a view missing from
    one configuration is generated nullable and the fragment would stop
    compiling.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- The bar, at the top of the field's column and no wider than it. -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.5"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/address_search_title"
        app:titleTextAppearance="@style/TextAppearance.RoueLibre.Title" />

    <!-- What is left of the column under the bar, and as much height as the
         field asks for. -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_s"
            android:paddingBottom="@dimen/space_m">

            <!-- `flagNoExtractUi`, as in portrait: it is what refuses the
                 keyboard's own full-screen copy of this field, and this
                 arrangement would be for nothing under one. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/search_field"
                style="@style/Widget.RoueLibre.SearchField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_l"
                android:layout_marginEnd="@dimen/space_l"
                android:hint="@string/address_search_hint"
                app:endIconContentDescription="@string/address_search_clear"
                app:endIconMode="clear_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/search_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:inputType="textPostalAddress"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.RoueLibre.Body" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Gone, and under the field where portrait keeps it, so that the
                 day a sideways screen has room for it again it is already in
                 its place. -->
            <TextView
                android:id="@+id/privacy_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_l"
                android:layout_marginTop="@dimen/space_s"
                android:layout_marginEnd="@dimen/space_l"
                android:text="@string/address_search_privacy"
                android:textAppearance="@style/TextAppearance.RoueLibre.Secondary"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- The answers, in the other half, from the top of the screen to the
         bottom of it. Nothing costs them height any more, neither the bar nor
         the field, so what the keyboard gives back is theirs. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/results"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/colorSurface"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/empty_state"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.5"
        tools:itemCount="4"
        tools:listitem="@layout/item_address" />

    <!-- An empty screen: an invitation to act, not a statement (SPEC §7).

         Above the list and not over it, exactly as in portrait and for the
         reasons written there — what changes is only that "above" now means at
         the top of the answers' column, which is also the top of the screen.
         Its side spacing is the ordinary one and not portrait's wide one: the
         column it centres itself in is already half a screen, and it takes its
         edges from the list rather than a half of its own, so the two cannot
         come apart. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/empty_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginTop="@dimen/space_s"
        android:layout_marginEnd="@dimen/space_l"
        android:visibility="gone"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/results"
        app:layout_constraintStart_toStartOf="@id/results"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.RoueLibre.Title"
                tools:text="Aucune adresse trouvée" />

            <TextView
                android:id="@+id/empty_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.RoueLibre.Secondary"
                tools:text="Rien ne correspond à « rue de la lune »." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/empty_action"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginTop="@dimen/space_l"
                android:visibility="gone"
                tools:text="Gérer les données hors ligne"
                tools:visibility="visible" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
