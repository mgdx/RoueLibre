    <!-- The label under, or beside, a count. No item holds a number: the
         figure is painted next to these words already.
         Two things decide what goes in each item, and neither is the tamyiz.
         `zero` is what an unknown count resolves to — `StationDetailSheet`
         and `StationAdapter` both call `getQuantityString(…, count ?: 0)` and
         both say an unknown count reads as the plural — so it carries the
         plural and not the singular. And on a list row the label is stacked
         under the figure, set in `TextAppearance.RoueLibre.Label`, and read
         as a word standing on its own. So `many` is written bare, without
         the accusative tanwin the same word carries in `bikes_available`
         where the numeral really is beside it — and `two` drops the dual for
         the same reason, the dual being the strongest numeral agreement of
         all: it says "two" itself, and `دراجتان` stacked under a ٢ repeats
         the figure instead of naming the thing counted. -->
    <plurals name="counterpart_bikes" tools:ignore="ImpliedQuantity">
        <item quantity="zero">دراجات</item>
        <item quantity="one">دراجة</item>
        <item quantity="two">دراجات</item>
        <item quantity="few">دراجات</item>
        <item quantity="many">دراجة</item>
        <item quantity="other">دراجة</item>
    </plurals>
    <plurals name="counterpart_docks" tools:ignore="ImpliedQuantity">
        <item quantity="zero">مواقف شاغرة</item>
        <item quantity="one">موقف شاغر</item>
        <item quantity="two">مواقف شاغرة</item>
        <item quantity="few">مواقف شاغرة</item>
        <item quantity="many">موقف شاغر</item>
        <item quantity="other">موقف شاغر</item>
    </plurals>
    <string name="counterpart_none">—</string>

