<?xml version="1.0" encoding="utf-8"?>
<!--
    The search field's outline: discreet at rest, the signal hue once focused.
    The outline is never the only cue of selection — the caret and the floating
    label say so too.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/signal" android:state_focused="true" />
    <item android:color="@color/outline" />
</selector>
