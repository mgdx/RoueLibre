<?xml version="1.0" encoding="utf-8"?>
<!--
    Contour du champ de recherche : discret au repos, teinte de signal une fois
    saisi. Le contour n'est jamais le seul indice de sélection — le curseur et
    le libellé flottant le disent aussi.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/signal" android:state_focused="true" />
    <item android:color="@color/trait" />
</selector>
