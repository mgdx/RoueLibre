    <!-- The label under, or beside, a count. No item holds a number, and none
         ever should: the figure is written next to these words already. On a
         list row the label is stacked under the figure and set in capitals, so
         it is read as a word of its own — which is exactly what a Hungarian
         numeral wants, since the noun behind a figure stays singular anyway. -->
    <plurals name="counterpart_bikes" tools:ignore="ImpliedQuantity">
        <item quantity="one">kerékpár</item>
        <item quantity="other">kerékpár</item>
    </plurals>
    <plurals name="counterpart_docks" tools:ignore="ImpliedQuantity">
        <item quantity="one">szabad hely</item>
        <item quantity="other">szabad hely</item>
    </plurals>
    <string name="counterpart_none">—</string>

    <!-- The detail line under a station's name, in the list.
         %1$s is the distance to the station when the reader's position is
         known, and its postcode when it is not. %2$d is the number of docking
         points — the capacity, which is *dokkoló* and not *szabad hely*: the
         sheet shows both figures side by side. -->
    <plurals name="station_detail_with_capacity">
        <item quantity="one">%1$s · %2$d dokkoló</item>
        <item quantity="other">%1$s · %2$d dokkoló</item>
    </plurals>

