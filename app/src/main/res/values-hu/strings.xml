    <string name="welcome_hello_title">Roue Libre</string>
    <string name="welcome_hello_body">Ez az alkalmazás térképen mutatja a közösségi kerékpárokat, és háztól házig tartó útvonaltervet készít: gyaloglás egy állomásig, kerékpározás, majd gyaloglás a célig.\n\nIngyenes és nyílt forráskódú. Nincs fiók, nincs reklám, nincs nyomkövető.</string>
    <string name="welcome_privacy_title">Semmi nem hagyja el ezt a telefont</string>
    <!-- The English is scrupulously impersonal here, and Hungarian keeps it:
         no *mi*, no „nem őrzünk meg”. What is stated is a property of the
         software, not a promise from somebody. -->
    <string name="welcome_privacy_body">Az útvonaltervek ezen a telefonon készülnek. A keresett címek senkihez nem jutnak el, még gépelés közben sem.\n\nSemmilyen előzmény nem marad meg: sem az útvonaltervek, sem a pozíciók, sem az úti célok.\n\nHétköznapi használatban az egyetlen kimenő kérés azt kérdezi meg, hány kerékpár érhető el.</string>
    <string name="welcome_fleet_title">Amit a kerékpár elárul</string>
    <string name="welcome_fleet_body">A rajzolt kerékpár megmutatja, mit kölcsönöz a városod.\n\nEz a hálózat saját adatfolyamából olvasható ki, sosem találgatás eredménye.</string>
    <string name="welcome_fleet_mechanical_only">A hálózat csak hagyományos kerékpárokat kölcsönöz.</string>
    <string name="welcome_fleet_electric_only">A hálózat csak elektromos kerékpárokat kölcsönöz.</string>
    <string name="welcome_fleet_mixed">A hálózat mindkét fajtát kölcsönzi.</string>

    <string name="welcome_data_title">Egy város, egy letöltés</string>
    <string name="welcome_data_body">A térkép, az utcák és az útvonalszámítás az eszközön van. Ettől működnek hálózat nélkül – és ezért kell egyszer letölteni a városod adatait.\n\nKezdd tehát a város kiválasztásával. Egy közepes méretű agglomerációnál számíts nagyjából negyven megabájtra, egy fővárosnál többre; a méret a letöltés előtt kiderül.\n\nMeg is teheted később: addig is használható marad az állomáslista és az állomások elérhetősége.</string>
    <string name="welcome_step" tools:ignore="PluralsCandidate">%1$d / %2$d</string>
    <string name="welcome_continue">Tovább</string>
    <string name="welcome_skip">Kihagyás</string>
    <string name="welcome_choose_city">Városom kiválasztása</string>
    <string name="welcome_later">Később</string>
    <string name="welcome_open">A bemutatkozás újraolvasása</string>

