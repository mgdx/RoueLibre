    <string name="street_bike_charge">电量 %1$d%%</string>
    <!-- Said in place of the line above where the network publishes no
         percentage. %1$s is a distance, already rounded and written in the
         reader's units. -->
    <string name="street_bike_range">约剩 %1$s 续航</string>
