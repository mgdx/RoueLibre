    <!-- What the vehicle feed adds under the split, where the setting that
         reads it is on (SPEC §7.2, §7.6): the charge of each electric bike,
         fullest first, and the bikes out of service. Up to three parts, joined
         by the separator; the lists inside a part are joined by the system in
         the reader's language, so the placeholder receives "92 %, 78 % and
         40 %" already written. -->
    <string name="station_bikes_detail_separator">" · "</string>
    <!-- %1$d is one bike's charge as a whole percentage. The doubled sign is a
         literal per cent, not a placeholder. -->
    <string name="station_bike_charge_value">%1$d%%</string>
    <!-- %1$s is the list of percentages, one per electric bike on offer. -->
    <string name="station_bikes_battery">电量 %1$s</string>
    <!-- Said where the network publishes ranges and no percentage. %1$s is the
         list of distances, each already written in the reader's units. -->
    <string name="station_bikes_range">约剩 %1$s 续航</string>
    <!-- Said instead of the two lists above past four bikes: %1$s is the
         lowest figure, %2$s the highest, each already written. -->
    <string name="station_bikes_battery_spread">电量 %1$s 到 %2$s</string>
    <string name="station_bikes_range_spread">约剩 %1$s 到 %2$s 续航</string>
    <!-- The row unfolding the bike-by-bike list under the summary. It
         names no figure: the count already stands in the disc above, and a
         second one here read as a contradiction wherever the network's two
         feeds are out of step. -->
    <string name="station_bikes_list_title">该站点自行车明细</string>
    <!-- Said under that row, with the list open, where the count above and
         the list below cannot both be right. -->
    <string name="station_bikes_feeds_disagree">该列表来自与上方数量不同的数据源，两者在此并不一致。Roue Libre 不做取舍，按发布的原样同时呈现。</string>
    <!-- The one word a line of the list adds where the feed says the bike
         is booked; "out of service" reuses the station's own word. -->
    <string name="station_bike_reserved">已预约</string>
    <plurals name="station_bikes_out_of_service">
