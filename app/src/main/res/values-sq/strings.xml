    <!-- The label under, or beside, a count. No item holds a number, and none
         ever should: the figure is written next to these words already. The
         word alone agrees, which is why these are plurals resolved with the
         count and formatted with nothing. On a list row the label is set in
         capitals, on its own line under the figure, so it has to read as a
         word standing alone and not as the tail of a phrase — which is what
         "vende të lira" does. -->
    <plurals name="counterpart_bikes" tools:ignore="ImpliedQuantity">
        <item quantity="one">biçikletë</item>
        <item quantity="other">biçikleta</item>
    </plurals>
    <plurals name="counterpart_docks" tools:ignore="ImpliedQuantity">
        <item quantity="one">vend i lirë</item>
        <item quantity="other">vende të lira</item>
    </plurals>
    <string name="counterpart_none">—</string>

    <!-- The detail line under a station's name, in the list. %1$s is the
         distance to the station, or its postcode when the position is not
         known. %2$d is the number of docking points, counted as a total: the
         parking place itself, not the free spot a bike goes into. -->
    <plurals name="station_detail_with_capacity">
        <item quantity="one">%1$s · %2$d vend parkimi</item>
        <item quantity="other">%1$s · %2$d vende parkimi</item>
    </plurals>

    <!-- What a station's bikes are, shown only where the network lends both
         kinds side by side. %1$s is the mechanical count, %2$s the electric
         one, each already agreed in number. -->
    <string name="station_bikes_split">%1$s · %2$s</string>
    <plurals name="bikes_mechanical">
        <item quantity="one">%1$d mekanike</item>
        <item quantity="other">%1$d mekanike</item>
    </plurals>
    <plurals name="bikes_electric">
        <item quantity="one">%1$d elektrike</item>
        <item quantity="other">%1$d elektrike</item>
    </plurals>

    <!-- How old the availability is. All of these are read inside another
         sentence — "Përditësuar %1$s" — so they start in lower case. -->
    <string name="freshness_just_now">pikërisht tani</string>
    <plurals name="freshness_seconds">
        <item quantity="one">%1$d sekondë më parë</item>
        <item quantity="other">%1$d sekonda më parë</item>
