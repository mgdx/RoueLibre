    <plurals name="freshness_minutes">
        <item quantity="one">%1$d minutë më parë</item>
        <item quantity="other">%1$d minuta më parë</item>
    </plurals>
    <plurals name="freshness_hours">
        <item quantity="one">%1$d orë më parë</item>
        <item quantity="other">%1$d orë më parë</item>
    </plurals>
