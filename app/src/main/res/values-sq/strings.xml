        <item quantity="one">%1$d biçikletë</item>
        <item quantity="other">%1$d biçikleta</item>
    </plurals>

    <!-- The number of free docks to return a bike to. -->
    <plurals name="docks_available">
        <item quantity="one">%1$d vend i lirë</item>
        <item quantity="other">%1$d vende të lira</item>
    </plurals>

    <!-- Spoken by screen readers on a station's indicator.
         Example: "Rruga B, 6 biçikleta, 26 vende të lira". -->
    <string name="station_content_description">%1$s, %2$s, %3$s</string>
    <string name="station_out_of_service">Jashtë shërbimit</string>
    <string name="station_out_of_service_since">%1$s · të dhënat e fundit %2$s</string>
    <string name="station_availability_unknown">Disponueshmëria nuk dihet</string>

    <!-- What a station is called when its feed publishes no name for it and no
         street to stand in for one. -->
    <string name="station_unnamed">Stacion pa emër</string>

    <!-- Shown for a station the network publishes outside the area its data
         covers. The short form joins the rest of the row. -->
