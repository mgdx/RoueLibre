    <!-- The welcome carousel, shown once on first launch. -->
    <string name="welcome_hello_title">Roue Libre</string>
    <string name="welcome_hello_body">Denne app viser delecykler på et kort og beregner en rejse fra dør til dør: gå til en station, cykl, og gå det sidste stykke.\n\nDen er gratis og open source. Ingen konto, ingen reklamer, ingen tracker.</string>
    <string name="welcome_privacy_title">Intet forlader denne telefon</string>
    <string name="welcome_privacy_body">Rejser beregnes på denne telefon. De adresser, du slår op, sendes ikke til nogen, heller ikke mens du skriver.\n\nDer gemmes ingen historik: hverken dine rejser, dine positioner eller dine destinationer.\n\nDen eneste forespørgsel, der går ud i daglig brug, spørger, hvor mange cykler der er ledige.</string>
    <string name="welcome_fleet_title">Hvad cyklen fortæller</string>
    <string name="welcome_fleet_body">Den tegnede cykel fortæller, hvad din by udlåner.\n\nDet læses fra netværkets eget feed og gættes aldrig.</string>
    <string name="welcome_fleet_mechanical_only">Netværket udlåner kun mekaniske cykler.</string>
    <string name="welcome_fleet_electric_only">Netværket udlåner kun elektriske cykler.</string>
    <string name="welcome_fleet_mixed">Netværket udlåner begge slags.</string>

    <string name="welcome_data_title">Én by, én download</string>
    <string name="welcome_data_body">Kortet, vejene og ruteberegningen ligger på enheden. Det er det, der får dem til at virke uden internet – og det betyder, at din bys data skal hentes én gang.\n\nSå begynd med at vælge den. Regn med omkring fyrre megabyte for et mellemstort byområde, mere for en hovedstad; størrelsen oplyses, før der hentes.\n\nDu kan også gøre det senere: indtil da er stationslisten og tilgængeligheden stadig brugbar.</string>
    <string name="welcome_step" tools:ignore="PluralsCandidate">%1$d af %2$d</string>
    <string name="welcome_continue">Fortsæt</string>
    <string name="welcome_skip">Spring over</string>
    <string name="welcome_choose_city">Vælg min by</string>
    <string name="welcome_later">Senere</string>
    <string name="welcome_open">Læs introduktionen igen</string>

