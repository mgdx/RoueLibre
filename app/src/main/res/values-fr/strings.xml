<?xml version="1.0" encoding="utf-8"?>
<!--
    French translation.

    It was the application's source language until the project stopped being
    a Lille one; the strings are still written first here in spirit, since the
    interface's tone was set in French, but `values/` is what Android falls
    back on and English is what it holds.

    Rules, the same as everywhere: positional placeholders, <plurals> for
    anything that agrees, apostrophes escaped (l\'instant), and the `name`
    attributes left untouched. See CONTRIBUTING.md.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <string name="app_name">Roue Libre</string>

    <!-- Main screen: the station list. -->
    <string name="stations_title">Stations</string>

