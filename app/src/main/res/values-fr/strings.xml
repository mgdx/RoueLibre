    <!-- First launch (SPEC §7.9). We explain how something works, we are not
         selling anything: short sentences, active voice, no jargon. -->
    <string name="welcome_hello_title">Roue Libre</string>
    <string name="welcome_hello_body">Cette application montre les vélos en libre-service sur une carte, et calcule un itinéraire porte-à-porte : marche jusqu’à une station, vélo, puis marche jusqu’au bout.\n\nElle est libre et ouverte. Pas de compte, pas de publicité, pas de mouchard.</string>
    <string name="welcome_privacy_title">Rien ne sort d’ici</string>
    <string name="welcome_privacy_body">Les itinéraires sont calculés sur ce téléphone. Les adresses que tu cherches ne sont envoyées à personne, pas même pendant la frappe.\n\nAucun historique n’est conservé : ni tes trajets, ni tes positions, ni tes destinations.\n\nLa seule requête qui part en usage courant demande combien de vélos sont disponibles.</string>
    <string name="welcome_fleet_title">Ce que dit le vélo</string>
    <string name="welcome_fleet_body">Le vélo dessiné dit ce que ta ville prête.\n\nC’est lu dans le flux du réseau lui-même, jamais deviné.</string>
    <string name="welcome_fleet_mechanical_only">Le réseau ne prête que des vélos mécaniques.</string>
    <string name="welcome_fleet_electric_only">Le réseau ne prête que des vélos électriques.</string>
    <string name="welcome_fleet_mixed">Le réseau prête les deux sortes.</string>

    <string name="welcome_data_title">Une ville, un téléchargement</string>
    <string name="welcome_data_body">La carte, les rues et le calcul d’itinéraire vivent sur l’appareil. C’est ce qui les rend utilisables sans réseau — et cela suppose de télécharger les données de ta ville, une fois.\n\nCommence donc par la choisir. Compte une quarantaine de mégaoctets pour une agglomération de taille moyenne, davantage pour une capitale ; la taille est annoncée avant le téléchargement.\n\nTu peux aussi le faire plus tard : en attendant, la liste des stations et leurs disponibilités restent utilisables.</string>
    <!-- Position in the sequence: "1 sur 3". This is not a number agreement
         but a progress marker — the second number does not vary with the
         first — hence the absence of a plural.
         %1$d is the page number, %2$d how many there are. -->
    <string name="welcome_step" tools:ignore="PluralsCandidate">%1$d sur %2$d</string>
    <string name="welcome_continue">Continuer</string>
    <string name="welcome_skip">Passer</string>
    <string name="welcome_choose_city">Choisir ma ville</string>
    <string name="welcome_later">Plus tard</string>
    <string name="welcome_open">Revoir la présentation</string>

