<?xml version="1.0" encoding="utf-8"?>
<!--
    Lithuanian translation.

    A translation of `values/strings.xml`, which is the source and the only
    file Android falls back on. The `name` attributes are never touched, the
    placeholders keep their number and their kind, and <plurals> carry the four
    categories Lithuanian distinguishes — `one`, `few`, `many`, `other`.

    What each category actually covers is particular to Lithuanian, and each
    form is written to read correctly for every number it takes:
      · `one`   — 1, 21, 31, 101… but never 11. Nominative singular.
      · `few`   — 2 to 9, 22 to 29, 32 to 39… but never 12 to 19. Nominative
                  plural.
      · `many`  — decimal numbers only (1,5). Genitive singular.
      · `other` — everything else, which is 0, 10, 11 to 19, 20, 30, 100…
                  Genitive plural.

    Typography of Lithuanian:
      · quotation marks are „ … “, never « » and never straight quotes;
      · the dash that breaks a sentence is – (U+2013), with a space on either
        side, and not the em dash of the English file;
      · foreign product and brand names are set in „ “, as Android's own
        Lithuanian does — „OpenStreetMap“, „BRouter“, „Roue Libre“, and
        „Wi-Fi“ with them wherever it stands inside a sentence
        (android:wifi_available_sign_in → *Prisijungti prie „Wi-Fi“ tinklo*);
        only a label standing alone is written bare, which is a case this
        file does not have;
      · the diacritics are written in full: ą č ę ė į š ų ū ž;
      · the apostrophe, where a name carries one (Vélib’), is ’ (U+2019) and
        never the straight quote, which is why nothing here is escaped.

    Lithuanian declines over seven cases, all of them suffixes: a sentence
    built around a placeholder has to stay correct whatever the placeholder
    holds, so the wording is turned around — the placeholder put in the
    nominative, or set in „ “ in apposition to a noun — rather than a case
    ending being glued onto a `%1$s`.

    The register is the polite plural (jūs), which is what Android speaks in
    Lithuanian.

    The terms this file holds to, and the reason for each, are in
    docs/lt-glossary.md. See CONTRIBUTING.md to submit a correction.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <string name="app_name">Roue Libre</string>

    <!-- Main screen: the station list. -->
    <string name="stations_title">Stotelės</string>

    <!-- The number of bikes available to borrow at a station. -->
    <plurals name="bikes_available">
        <item quantity="one">%1$d dviratis</item>
        <item quantity="few">%1$d dviračiai</item>
        <item quantity="many">%1$d dviračio</item>
        <item quantity="other">%1$d dviračių</item>
    </plurals>

    <!-- The number of free docks to return a bike to. -->
    <plurals name="docks_available">
        <item quantity="one">%1$d laisva vieta</item>
        <item quantity="few">%1$d laisvos vietos</item>
        <item quantity="many">%1$d laisvos vietos</item>
        <item quantity="other">%1$d laisvų vietų</item>
    </plurals>

    <!-- Spoken by screen readers on a station's indicator.
         Example: "Katedra, 6 dviračiai, 26 laisvos vietos". -->
    <string name="station_content_description">%1$s, %2$s, %3$s</string>
    <string name="station_out_of_service">Paslaugos neteikiamos</string>
    <string name="station_availability_unknown">Nežinomas prieinamumas</string>

    <!-- What a station is called when its feed publishes no name for it and no
         street to stand in for one. The station itself is kept: it is real and
         it holds bikes, and dropping it would take it off the map over a
         mistyped string. -->
    <string name="station_unnamed">Stotelė be pavadinimo</string>

    <!-- Shown for a station the network publishes outside the area its data
         covers: it exists and its bikes are counted, but no map and no route
         reach it. The short form joins the rest of the row. -->
    <string name="station_beyond_area_short">už žemėlapio ribų</string>
    <string name="station_beyond_area">Ši stotelė yra už teritorijos, kurią apima įdiegti duomenys. Jos dviračiai skaičiuojami realiuoju laiku, bet jos nepasiekia nei žemėlapis, nei maršrutas.</string>

    <string name="search_stations_hint">Ieškoti stotelės</string>
    <string name="search_stations_clear">Išvalyti paiešką</string>
    <string name="stations_no_match_title">Stotelių nerasta</string>
    <string name="stations_no_match_message">Pagal „%1$s“ nieko nerasta. Patikrinkite rašybą arba išvalykite paiešką.</string>
    <string name="action_clear_search">Išvalyti paiešką</string>

    <!-- The map's two counting modes: bikes to take, or free docks to leave
         one in. -->
    <string name="mode_bikes">Dviračiai</string>
    <string name="mode_docks">Laisvos vietos</string>
    <string name="mode_bikes_description">Rodyti laisvus dviračius</string>
    <string name="mode_docks_description">Rodyti laisvas vietas</string>

    <!-- Which bikes the markers count, where the network lends both kinds
         (SPEC §7.1). Named after what is shown, like the toggle beside it. -->
    <string name="map_bikes_all_kinds">Visi dviračiai</string>
    <string name="map_bikes_mechanical">Mechaniniai</string>
    <string name="map_bikes_electric">Elektriniai</string>
    <string name="map_bikes_all_kinds_description">Skaičiuojami visi dviračiai. Palieskite, kad būtų skaičiuojami tik mechaniniai.</string>
    <string name="map_bikes_mechanical_description">Skaičiuojami mechaniniai dviračiai. Palieskite, kad būtų skaičiuojami tik elektriniai.</string>
    <string name="map_bikes_electric_description">Skaičiuojami elektriniai dviračiai. Palieskite, kad būtų skaičiuojami visi.</string>

    <!-- The label under, or beside, a count. No item holds a number, and none
         ever should: the figure is written next to these words already, so
         writing it here would say it twice. On a list row the label is stacked
         under the figure and set in capitals, so each form has to read as a
         word standing on its own — which the Lithuanian genitive does. -->
    <plurals name="counterpart_bikes" tools:ignore="ImpliedQuantity">
        <item quantity="one">dviratis</item>
        <item quantity="few">dviračiai</item>
        <item quantity="many">dviračio</item>
        <item quantity="other">dviračių</item>
    </plurals>
    <plurals name="counterpart_docks" tools:ignore="ImpliedQuantity">
        <item quantity="one">laisva vieta</item>
        <item quantity="few">laisvos vietos</item>
        <item quantity="many">laisvos vietos</item>
        <item quantity="other">laisvų vietų</item>
    </plurals>
    <string name="counterpart_none">—</string>

    <!-- The detail line under a station's name, in the list.
         %1$s is the distance to the station when the reader's position is
         known, and its postcode when it is not — never both, and never a
         label saying which. %2$d is the number of docking points, which is
         the station's whole capacity and not what is free of it. -->
    <plurals name="station_detail_with_capacity">
        <item quantity="one">%1$s · %2$d stovas</item>
        <item quantity="few">%1$s · %2$d stovai</item>
        <item quantity="many">%1$s · %2$d stovo</item>
        <item quantity="other">%1$s · %2$d stovų</item>
    </plurals>

    <!-- What a station's bikes are, shown only where the network lends both
         kinds side by side. %1$s is the mechanical count, %2$s the electric
         one, each already agreed in number. -->
    <string name="station_bikes_split">%1$s · %2$s</string>
    <plurals name="bikes_mechanical">
        <item quantity="one">%1$d mechaninis</item>
        <item quantity="few">%1$d mechaniniai</item>
        <item quantity="many">%1$d mechaninio</item>
        <item quantity="other">%1$d mechaninių</item>
    </plurals>
    <plurals name="bikes_electric">
        <item quantity="one">%1$d elektrinis</item>
        <item quantity="few">%1$d elektriniai</item>
        <item quantity="many">%1$d elektrinio</item>
        <item quantity="other">%1$d elektrinių</item>
    </plurals>

    <!-- How old the availability figures are. All of these follow "Atnaujinta"
         below, so they are written as the answer to "when": "prieš" takes the
         accusative, and a numeral above ten takes the genitive plural after
         it. -->
    <string name="freshness_just_now">ką tik</string>
    <plurals name="freshness_seconds">
        <item quantity="one">prieš %1$d sekundę</item>
        <item quantity="few">prieš %1$d sekundes</item>
        <item quantity="many">prieš %1$d sekundės</item>
        <item quantity="other">prieš %1$d sekundžių</item>
    </plurals>
    <plurals name="freshness_minutes">
        <item quantity="one">prieš %1$d minutę</item>
        <item quantity="few">prieš %1$d minutes</item>
        <item quantity="many">prieš %1$d minutės</item>
        <item quantity="other">prieš %1$d minučių</item>
    </plurals>
    <plurals name="freshness_hours">
        <item quantity="one">prieš %1$d valandą</item>
        <item quantity="few">prieš %1$d valandas</item>
        <item quantity="many">prieš %1$d valandos</item>
        <item quantity="other">prieš %1$d valandų</item>
    </plurals>
    <plurals name="freshness_days">
        <item quantity="one">prieš %1$d dieną</item>
        <item quantity="few">prieš %1$d dienas</item>
        <item quantity="many">prieš %1$d dienos</item>
        <item quantity="other">prieš %1$d dienų</item>
    </plurals>
    <plurals name="freshness_months">
        <item quantity="one">prieš %1$d mėnesį</item>
        <item quantity="few">prieš %1$d mėnesius</item>
        <item quantity="many">prieš %1$d mėnesio</item>
        <item quantity="other">prieš %1$d mėnesių</item>
    </plurals>
