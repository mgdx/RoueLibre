<?xml version="1.0" encoding="utf-8"?>
<!--
    The languages Android's own per-application language settings offer for
    this application, from Android 13 on (SPEC §7.6, §9).

    The same list the chooser in the settings screen offers, and it has to be:
    the two write one and the same stored choice, and a language offered in one
    place and not the other would look like a defect.

    That list is TRANSLATED_LANGUAGES, in `ui/Locales.kt`, and NOT the folders
    under `res/values-*/` nor the entries of `localeFilters`, of which there are
    more:
    most of those files still hold the English text, and offering "Deutsch" to
    hand back English would be worse than offering no German at all.

    This file cannot be computed — Android reads it from the APK's resources —
    so it is the one place where that list is written a second time. A unit
    test reads this very file and fails if the two ever disagree; see
    `CONTRIBUTING.md` for the places a new translation has to be declared in.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="ar" />
    <locale android:name="bs" />
    <locale android:name="cs" />
    <locale android:name="da" />
    <locale android:name="de" />
    <locale android:name="el" />
    <locale android:name="en" />
    <locale android:name="es" />
    <locale android:name="fi" />
    <locale android:name="fr" />
    <locale android:name="hr" />
    <locale android:name="hu" />
    <locale android:name="it" />
    <locale android:name="ja" />
    <locale android:name="lt" />
    <locale android:name="lv" />
    <locale android:name="nb" />
    <locale android:name="nl" />
    <locale android:name="pl" />
    <locale android:name="pt" />
    <locale android:name="ro" />
    <locale android:name="sk" />
    <locale android:name="sl" />
    <locale android:name="sq" />
    <locale android:name="sv" />
    <locale android:name="tr" />
</locale-config>
