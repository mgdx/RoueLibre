<?xml version="1.0" encoding="utf-8"?>
<!--
    Typographic tokens — SPEC.md §7.

    Two families, each chosen for a precise reason.

    · Bricolage Grotesque (SIL OFL) carries the figures and the titles. Bike
      counts are the application's central information; they deserve letters
      with character, and this grotesque has it — wide, open figures,
      recognisable from a distance.

    · Atkinson Hyperlegible (SIL OFL, Braille Institute of America) carries
      everything else. It was drawn for low vision: the slashed zero, the
      serifed "1" and the curved "l" are distinct from one another. For an
      application read while walking, that is not an ornament.

    Both are embedded in the APK: no font is downloaded, which would go
    through a third-party service (SPEC §2, C2 and C3).

    Bricolage is distributed as a variable font, but `fontVariationSettings`
    only exists from API 28 on: on an Android 8 the requested weights would be
    ignored and the titles would show thin. Two static instances are therefore
    frozen at generation time, at the only weights used. Together they weigh
    182 kB against 408 kB for the complete variable font — the compatibility
    constraint also lightened the APK. See tools/README.md for the
    regeneration command.

    The figures are set in fixed pitch ("tnum") wherever they line up in a
    column, so the list does not jitter on every refresh.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="UnusedResources">

    <!-- Screen and section titles. -->
    <style name="TextAppearance.RoueLibre.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/bricolage_semibold</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Body text, station names. -->
    <style name="TextAppearance.RoueLibre.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <!-- Supporting information: distance, postcode, age of the data. -->
    <style name="TextAppearance.RoueLibre.Secondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="android:textSize">@dimen/text_secondary</item>
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!--
        The application's name on the opening screen (SPEC §7.0). The title
        face, one size above the title: alone on a green field under a 160dp
        mark, the title size read as a caption. The colour changes too, this
        text sitting on the identity's green and not on the theme's paper.
    -->
    <style name="TextAppearance.RoueLibre.Intro" parent="TextAppearance.RoueLibre.Title">
        <item name="android:textSize">@dimen/text_intro</item>
        <item name="android:textColor">@color/identity_ink</item>
    </style>

    <!-- Short labels, in spaced capitals. -->
    <style name="TextAppearance.RoueLibre.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!--
        Every piece of running text in the application, justified.

        Hung on the theme's `android:textViewStyle` rather than written into
        each layout: a paragraph that has to remember to ask for the house
        setting is one that will eventually forget, and the same reasoning
        already governs the button style below.

        Justification only ever moves lines that have a line after them, so a
        label, a station name or a figure — anything that fits on one line — is
        left exactly as it was. What changes is the paragraphs: "about",
        the welcome pages, the release notes.

        Hyphenation comes with it, and is not decoration. Justifying without
        it stretches the word spaces of a narrow column until rivers of white
        run down the page, which on a phone held at arm's length is worse than
        the ragged edge it replaced. Android turns hyphenation off by default,
        for speed; here the text is short enough for that not to be a concern.
    -->
    <style name="Widget.RoueLibre.Text" parent="Widget.MaterialComponents.TextView">
        <item name="android:justificationMode">inter_word</item>
        <item name="android:hyphenationFrequency">normal</item>
    </style>

    <!--
        The main action button. Material rounds a filled button into a pill
        through a shape role the theme's global radius override does not
        reach — the same escape the toggle below had to close. Left alone, the
        eight buttons that carry a screen's main action would be the only pills
        in an interface whose one round element is the availability indicator,
        and the signature would stop being a signature.

        The style is hung on `materialButtonStyle` in the theme rather than
        quoted screen by screen: a button that has to remember to ask for the
        house shape is one that will eventually forget.
    -->
    <style name="Widget.RoueLibre.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.RoueLibre</item>
        <item name="android:textAppearance">@style/TextAppearance.RoueLibre.Body</item>
    </style>

    <!--
        The bikes / docks toggle. The default Material style colours the
        active state with `colorSecondaryContainer`, a role the project's token
        set does not use: rather than divert that role for the whole theme, the
        toggle carries its own state lists.
    -->
    <style name="Widget.RoueLibre.Toggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/toggle_background</item>
        <item name="strokeColor">@color/signal</item>
        <item name="android:textColor">@color/toggle_text</item>
        <item name="iconTint">@color/toggle_text</item>
        <item name="android:textAppearance">@style/TextAppearance.RoueLibre.Body</item>
        <!-- Material rounds its buttons into pills through a separate shape
             role, which the global radius override does not reach. Without
             this, the toggle would be the interface's second round element and
             would steal the indicator's thunder. -->
        <item name="shapeAppearance">@style/ShapeAppearance.RoueLibre</item>
    </style>

    <!--
        The search field. Like the toggle, it carries its own colours rather
        than diverting Material roles for the whole theme.
    -->
    <style name="Widget.RoueLibre.SearchField"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/field_stroke</item>
        <item name="boxStrokeWidth">@dimen/stroke</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="hintTextColor">@color/signal</item>
        <item name="android:textColorHint">@color/ink_soft</item>
        <item name="endIconTint">@color/ink_soft</item>
        <item name="shapeAppearance">@style/ShapeAppearance.RoueLibre</item>
    </style>

    <!--
        The availability indicator's figure has no style here: the view that
        draws it paints straight onto the canvas, without a TextView, and reads
        its size from @dimen/text_indicator. One more TextAppearance would be a
        token nothing could apply.
    -->

</resources>
