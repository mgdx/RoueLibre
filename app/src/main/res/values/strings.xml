<?xml version="1.0" encoding="utf-8"?>
<!--
    Français par défaut (SPEC §9). Aucune chaîne n'est écrite dans le code
    Kotlin ni dans un layout.

    Règles pour les contributeurs :
      · placeholders positionnels (%1$s, %2$d), jamais de concaténation :
        l'ordre des mots change d'une langue à l'autre ;
      · <plurals> pour tout ce qui s'accorde ;
      · un commentaire au-dessus de chaque chaîne ambiguë.
    Voir CONTRIBUTING.md pour proposer une traduction.
-->
<resources>

    <string name="app_name">Roue Libre</string>

    <!-- Écran principal : liste des stations. -->
    <string name="stations_title">Stations</string>

    <!-- Nombre de vélos empruntables dans une station. -->
    <plurals name="bikes_available">
        <item quantity="one">%1$d vélo</item>
        <item quantity="other">%1$d vélos</item>
    </plurals>

    <!-- Nombre de places libres pour rendre un vélo. -->
    <plurals name="docks_available">
        <item quantity="one">%1$d place</item>
        <item quantity="other">%1$d places</item>
    </plurals>

    <!-- Lu par les lecteurs d'écran sur l'indicateur d'une station.
         Exemple : « Rue Nationale, 6 vélos, 26 places ». -->
    <string name="station_content_description">%1$s, %2$s, %3$s</string>

    <string name="station_out_of_service">Hors service</string>
    <string name="station_availability_unknown">Disponibilité inconnue</string>

    <!-- Champ de recherche au-dessus de la liste. Il filtre les stations par
         leur nom ; la recherche d'adresses est un autre écran (SPEC §4.3). -->
    <string name="search_stations_hint">Chercher une station</string>
    <string name="search_stations_clear">Effacer la recherche</string>

    <!-- Liste vide parce que la recherche ne correspond à rien.
         %1$s est ce que l'utilisateur a tapé. -->
    <string name="stations_no_match_title">Aucune station trouvée</string>
    <string name="stations_no_match_message">Rien ne correspond à « %1$s ». Vérifie l\'orthographe, ou efface la recherche.</string>
    <string name="action_clear_search">Effacer la recherche</string>

    <!-- Bascule entre emprunter un vélo et rendre un vélo (SPEC §7.1). -->
    <string name="mode_bikes">Vélos</string>
    <string name="mode_docks">Places</string>
    <string name="mode_bikes_description">Afficher les vélos disponibles</string>
    <string name="mode_docks_description">Afficher les places libres</string>

    <!-- Étiquette du compte secondaire, sous le chiffre de droite. -->
    <string name="counterpart_bikes">vélos</string>
    <string name="counterpart_docks">places</string>
    <!-- Affiché à la place du compte quand la station ne rend pas le service. -->
    <string name="counterpart_none">—</string>

    <!-- Ligne de détail sous le nom d'une station.
         %1$s est un code postal, %2$d le nombre de points d'attache. -->
    <plurals name="station_detail_with_capacity">
        <item quantity="one">%1$s · %2$d point d\'attache</item>
        <item quantity="other">%1$s · %2$d points d\'attache</item>
    </plurals>

    <!-- Âge de la donnée affichée (SPEC §4.1). -->
    <string name="freshness_just_now">à l\'instant</string>
    <plurals name="freshness_seconds">
        <item quantity="one">il y a %1$d seconde</item>
        <item quantity="other">il y a %1$d secondes</item>
    </plurals>
    <plurals name="freshness_minutes">
        <item quantity="one">il y a %1$d minute</item>
        <item quantity="other">il y a %1$d minutes</item>
    </plurals>
    <plurals name="freshness_hours">
        <item quantity="one">il y a %1$d heure</item>
        <item quantity="other">il y a %1$d heures</item>
    </plurals>
    <string name="freshness_long_ago">il y a plus d\'un jour</string>
    <!-- Accolé à l'âge quand la donnée n'est plus à jour.
         Exemple : « Données figées · il y a 12 minutes ». -->
    <string name="freshness_stale">Données figées · %1$s</string>
    <string name="freshness_fresh">Mis à jour %1$s</string>
    <string name="freshness_never">Jamais mis à jour</string>

    <!-- Écran vide : une invitation à agir, pas un constat (SPEC §7). -->
    <string name="stations_empty_title">Aucune station chargée</string>
    <string name="stations_empty_message">Tire la liste vers le bas pour récupérer les stations du réseau.</string>

    <!-- Actions. Un même geste porte le même nom du bouton à la confirmation. -->
    <string name="action_refresh">Rafraîchir</string>
    <string name="action_retry">Réessayer</string>

    <!-- Écran carte (SPEC §7.1). -->
    <string name="map_open_list">Voir la liste des stations</string>
    <!-- Attribution portée par la carte elle-même (SPEC §4.5). Tient sur une
         ligne ; l'attribution complète du réseau est dans « À propos ». -->
    <string name="map_attribution">© les contributeurs OpenStreetMap</string>
    <!-- Bouton « me localiser » et ce qu'il peut répondre (SPEC §7.1, §10).
         Le refus ne relance jamais : il est constaté, pas discuté. -->
    <string name="map_locate_me">Me localiser</string>
    <string name="map_location_denied">Sans localisation, désigne ton point de départ sur la carte ou par une adresse.</string>
    <string name="map_location_unavailable">Position introuvable. Vérifie que la localisation est activée, puis réessaie.</string>

    <string name="map_needs_tiles_title">La carte a besoin du fond de carte</string>
    <string name="map_needs_tiles_message">Installe le fond de carte depuis l\'écran de stockage. En attendant, la liste des stations reste utilisable.</string>

    <!-- Réglages (SPEC §7.6). -->
    <string name="settings_title">Réglages</string>
    <string name="settings_open">Réglages</string>
    <string name="settings_data_title">Données hors ligne</string>
    <string name="settings_theme_title">Thème</string>
    <string name="settings_theme_system">Système</string>
    <string name="settings_theme_light">Clair</string>
    <string name="settings_theme_dark">Sombre</string>
    <string name="settings_handling_title">Temps de prise et de dépose</string>
    <string name="settings_handling_explanation">Ajoutés au trajet, et pris en compte dans le choix des stations.</string>
    <string name="settings_pickup">Prendre le vélo</string>
    <string name="settings_dropoff">Rendre le vélo</string>
    <string name="settings_sources_title">Sources des données</string>
    <string name="settings_gbfs_url">Adresse du flux de disponibilité</string>
    <string name="settings_manifest_url">Adresse du manifeste des données</string>
    <string name="settings_sources_explanation">Laisse ces champs vides pour employer les adresses fournies avec l\'application. Les changer permet de servir un autre réseau, ou de te passer de l\'hébergeur par défaut.</string>
    <string name="settings_reset_default">Rétablir l\'adresse par défaut</string>

    <!-- « À propos » (SPEC §7.7). Les attributions y sont dues, pas offertes :
         les producteurs de données et les bibliothèques employées l'exigent. -->
    <string name="about_title">À propos</string>
    <string name="about_open">À propos</string>
    <!-- %1$s est le numéro de version, par exemple « 0.1.0-alpha ». -->
    <string name="about_version">Version %1$s</string>

    <string name="about_privacy_title">Vie privée</string>
    <string name="about_privacy_body">Aucun compte, aucune publicité, aucun mouchard, aucun identifiant unique. Rien de ce que tu cherches ou de ce que tu calcules ne quitte ce téléphone : les adresses, les itinéraires et ta position restent ici, et ne sont pas conservés. La seule requête qui part en usage courant récupère la disponibilité des vélos. Les jeux de données ne sont téléchargés que sur ta demande.</string>

    <string name="about_attributions_title">Sources des données</string>
    <string name="about_attribution_osm">Fond de carte, itinéraires et points de repère : © les contributeurs OpenStreetMap, licence ODbL.</string>
    <string name="about_attribution_ban">Adresses et numéros de voirie : Base Adresse Nationale, licence ODbL.</string>
    <string name="about_attribution_brouter">Calcul d\'itinéraire : BRouter, licence MIT, sur des données OpenStreetMap.</string>
    <string name="about_attribution_maplibre">Affichage de la carte : MapLibre Native, licence BSD à deux clauses.</string>

    <string name="about_licence_title">Licence</string>
    <string name="about_licence_body">Roue Libre est un logiciel libre, publié sous licence GNU GPL version 3. Tu peux l\'utiliser, l\'étudier, le modifier et le redistribuer.</string>
    <string name="about_open_repository">Voir le code source</string>
    <string name="about_open_licences">Licences des composants</string>
    <string name="about_licences_title">Licences</string>
    <string name="about_no_browser">Aucun navigateur n\'est installé sur cet appareil.</string>

    <!-- Recherche d'itinéraire (SPEC §7.3). -->
    <string name="journey_title">Itinéraire</string>
    <string name="journey_open">Chercher un itinéraire</string>
    <string name="journey_origin_empty">Partir d\'où ?</string>
    <string name="journey_destination_empty">Aller où ?</string>
    <string name="journey_choose_origin">Partir d\'où ?</string>
    <string name="journey_choose_destination">Aller où ?</string>
    <string name="journey_swap">Intervertir le départ et l\'arrivée</string>
    <string name="journey_hint">Le trajet est calculé sur l\'appareil : marche jusqu\'à une station, vélo, puis marche jusqu\'au bout.</string>
    <string name="journey_compute">Calculer l\'itinéraire</string>

    <!-- Les quatre façons de désigner un point (SPEC §7.3). -->
    <string name="journey_source_my_position">Ma position</string>
    <string name="journey_source_address">Une adresse</string>
    <string name="journey_source_favourite">Une station favorite</string>
    <string name="journey_source_on_map">Un point sur la carte</string>
    <string name="journey_no_favourite">Aucune station en favori pour l\'instant. Ouvre une station et touche l\'étoile pour l\'ajouter.</string>
    <string name="journey_pick_crosshair">Point visé</string>
    <string name="journey_pick_confirm">Choisir ce point</string>
    <string name="journey_picked_point">Point sur la carte</string>

    <!-- Résultat d'itinéraire (SPEC §7.4). -->
    <string name="journey_result_title">Trajet</string>
    <!-- %1$s est la durée à pied, %2$s celle à vélo, %3$s la distance totale. -->
    <string name="journey_summary">dont %1$s à pied et %2$s à vélo · %3$s</string>
    <string name="journey_alternatives">Couples de stations</string>
    <!-- %1$s est la station de départ, %2$s celle d\'arrivée. -->
    <string name="journey_alternative_stations">%1$s → %2$s</string>
    <!-- %1$s est un nombre de vélos, %2$s un nombre de places. -->
    <string name="journey_alternative_detail">%1$s au départ · %2$s à l\'arrivée</string>
    <string name="journey_recompute">Recalculer</string>
    <!-- %1$s est le nom de la station. -->
    <string name="journey_step_to_station">Marcher jusqu\'à %1$s</string>
    <string name="journey_step_ride">Pédaler jusqu\'à %1$s</string>
    <string name="journey_step_to_destination">Marcher jusqu\'à l\'arrivée</string>
    <string name="journey_step_walk_all">Marcher jusqu\'à l\'arrivée</string>
    <!-- Le SPEC §6 impose de le dire quand le vélo ne fait pas gagner de temps.
         %1$s est la durée à pied. -->
    <string name="journey_walking_is_faster">À pied, tu y serais plus vite : %1$s.</string>
    <!-- %1$s est la distance à pied. -->
    <string name="journey_walk_only">à pied, sur %1$s — aucun trajet à vélo n\'est possible ici.</string>

    <!-- Pourquoi aucun trajet à vélo n'a été retenu (SPEC §6). Chaque cas dit
         ce qui s'est passé, jamais un code technique. -->
    <string name="journey_none_title">Pas de trajet</string>
    <string name="journey_no_bike_nearby">Aucune station avec un vélo près du départ. Réessaie plus tard, ou pars d\'un autre point.</string>
    <string name="journey_no_dock_nearby">Aucune station avec une place libre près de l\'arrivée. Réessaie plus tard, ou vise un autre point.</string>
    <string name="journey_no_route">Aucun chemin praticable entre ces deux points.</string>
    <string name="journey_graph_missing">Le graphe de routage n\'est pas installé. Ajoute-le depuis l\'écran de stockage.</string>
    <string name="journey_outside_coverage">Ce point est hors de la zone couverte par les données installées.</string>
    <string name="journey_no_stations">Aucune station connue. Rafraîchis la liste des stations, puis réessaie.</string>

    <!-- Durées, formatées par les API de localisation (SPEC §9).
         %1$d est un nombre de minutes ; %1$d h et %2$02d min pour les heures. -->
    <string name="duration_minutes">%1$d min</string>
    <string name="duration_hours_minutes">%1$d h %2$02d</string>

    <!-- Détail d'une station (SPEC §7.2). -->
    <plurals name="docks_total">
        <item quantity="one">%1$d point d\'attache</item>
        <item quantity="other">%1$d points d\'attache</item>
    </plurals>
    <!-- %1$s est le nombre de points d'attache, %2$s l'âge de la donnée. -->
    <string name="station_capacity_and_age">%1$s · %2$s</string>
    <!-- Une station sans adresse propre — au milieu d'un rond-point, d'une
         place — est située par rapport à la voie la plus proche.
         %1$s est un nom de voie. -->
    <string name="station_address_nearby">À proximité de %1$s</string>
    <string name="station_favourite_add">Mettre en favori</string>
    <string name="station_favourite_remove">Retirer des favoris</string>
    <string name="station_open_in_navigation">Ouvrir dans une appli de navigation</string>
    <string name="station_no_navigation_app">Aucune application de cartographie n\'est installée sur cet appareil.</string>

    <!-- Recherche d'adresses dans l'index hors ligne (SPEC §4.3). À ne pas
         confondre avec le champ qui filtre la liste des stations. -->
    <string name="address_search_title">Chercher une adresse</string>
    <string name="address_search_hint">Numéro, rue, commune</string>
    <string name="address_search_clear">Effacer la recherche</string>
    <string name="address_search_privacy">Tout se cherche sur l\'appareil. Rien n\'est envoyé, pas même pendant la frappe.</string>

    <!-- Une adresse trouvée. Le numéro et le nom de la voie sont assemblés par
         ressource, jamais par concaténation : l'ordre change d'une langue à
         l'autre (SPEC §9).
         %1$s est le numéro (« 12 », « 12 bis »), %2$s le nom de la voie. -->
    <string name="address_with_number">%1$s %2$s</string>
    <!-- %1$d est le numéro, %2$s son indice de répétition (« bis », « ter »). -->
    <string name="address_number_with_suffix">%1$d %2$s</string>
    <!-- %1$s est un code postal, %2$s une commune. -->
    <string name="address_locality">%1$s %2$s</string>
    <!-- %1$s est le lieu, %2$s une distance déjà formatée. -->
    <string name="address_detail">%1$s · %2$s</string>
    <!-- Dit quand le numéro cherché n'est pas dans l'index et qu'un voisin a
         servi de repère. %1$s est la ligne de détail. -->
    <string name="address_detail_approximate">%1$s · position approchée</string>
    <!-- Lu par les lecteurs d'écran sur une ligne de résultat.
         %1$s est l'adresse, %2$s son contexte. -->
    <string name="address_content_description">%1$s, %2$s</string>

    <!-- Écran de recherche vide : chaque situation appelle un geste différent. -->
    <string name="address_search_prompt_title">Où vas-tu ?</string>
    <string name="address_search_prompt_message">Tape un nom de rue, avec ou sans numéro. Les gares, universités et grandes places se cherchent aussi.</string>
    <string name="address_no_match_title">Aucune adresse trouvée</string>
    <!-- %1$s est ce que l'utilisateur a tapé. -->
    <string name="address_no_match_message">Rien ne correspond à « %1$s ». Essaie le nom de la rue seul, ou ajoute la commune.</string>
    <string name="address_needs_index_title">La recherche a besoin de l\'index d\'adresses</string>
    <string name="address_needs_index_message">Installe l\'index depuis l\'écran de stockage. Il reste sur l\'appareil et ne part jamais sur le réseau.</string>
    <string name="address_unreadable_title">Index d\'adresses illisible</string>

    <!-- Point trouvé, posé sur la carte. Lu par les lecteurs d'écran :
         l'adresse d'abord, l'action ensuite. %1$s est l'adresse trouvée. -->
    <string name="map_picked_place_description">%1$s. Appuyer pour effacer ce point.</string>

    <!-- Distances, formatées par les API de localisation (SPEC §9).
         %1$d est un nombre de mètres, %1$s un nombre de kilomètres déjà écrit
         dans la langue de l'interface. -->
    <string name="distance_metres">%1$d m</string>
    <string name="distance_kilometres">%1$s km</string>

    <string name="action_back">Revenir</string>

    <!-- Écran « stockage » : ce que l'application occupe, et comment le
         reprendre (SPEC §4.4). -->
    <string name="storage_title">Stockage</string>
    <string name="storage_open">Gérer les données hors ligne</string>
    <string name="storage_intro">La carte, le calcul d\'itinéraire et la recherche d\'adresses fonctionnent sans réseau. Ils demandent trois jeux de données, à installer une fois.</string>
    <!-- %1$s est une taille déjà formatée, par exemple « 42,5 Mo ». -->
    <string name="storage_total">%1$s occupés sur cet appareil</string>
    <string name="storage_nothing_installed">Aucune donnée installée</string>

    <string name="dataset_tiles">Fond de carte</string>
    <string name="dataset_tiles_purpose">Affiche la carte sans réseau</string>
    <string name="dataset_routing">Graphe de routage</string>
    <string name="dataset_routing_purpose">Calcule les itinéraires sur l\'appareil</string>
    <string name="dataset_addresses">Index d\'adresses</string>
    <string name="dataset_addresses_purpose">Cherche les rues sans rien envoyer</string>

    <string name="dataset_absent">Pas installé</string>
    <!-- %1$s est une taille, %2$s une date. Exemple : « 35,0 Mo · 9 août 2026 ». -->
    <string name="dataset_installed">%1$s · %2$s</string>
    <string name="dataset_import">Importer</string>
    <string name="dataset_replace">Remplacer</string>
    <string name="dataset_delete">Supprimer</string>
    <!-- %1$s est le nom du jeu de données. -->
    <string name="dataset_delete_description">Supprimer %1$s</string>
    <!-- %1$s est le nom du jeu de données. -->
    <string name="dataset_imported">%1$s installé</string>
    <string name="dataset_deleted">%1$s supprimé</string>

    <!-- Refus d'importation : chaque cas dit quoi faire. -->
    <string name="dataset_rejected_empty">Le fichier choisi est vide.</string>
    <!-- %1$s est le nom attendu du fichier, par exemple « tiles.mbtiles ». -->
    <string name="dataset_rejected_format">Ce fichier n\'est pas celui attendu. Choisis le fichier « %1$s » produit par les scripts de génération.</string>
    <!-- %1$d est la version trouvée, %2$d celle que l'application sait lire. -->
    <string name="dataset_rejected_version">Ce fichier est en version de format %1$d, et cette version de l\'application lit la version %2$d. Mets l\'application à jour.</string>
    <string name="dataset_rejected_checksum">Le fichier ne correspond pas à son empreinte : il est incomplet ou abîmé. Retélécharge-le.</string>
    <string name="dataset_rejected_transfer">La copie du fichier a échoué. Vérifie l\'espace libre et réessaie.</string>

    <!-- Messages d'erreur : ce qui s'est passé, et quoi faire. Sans excuses,
         sans code technique (SPEC §7 et §14). -->
    <string name="error_offline">Pas de connexion. Les dernières disponibilités connues restent affichées.</string>
    <string name="error_timeout">Le serveur du réseau met trop de temps à répondre. Réessaie dans un moment.</string>
    <!-- %1$d est le code HTTP renvoyé par le serveur. -->
    <string name="error_server_refused">Le serveur du réseau a renvoyé une erreur (%1$d). Réessaie plus tard.</string>
    <string name="error_malformed">Les données reçues sont illisibles. Vérifie l\'adresse du flux dans les réglages.</string>
    <!-- %1$s est le nom d'un flux GBFS, par exemple « station_status ». -->
    <string name="error_feed_unavailable">Le réseau ne publie pas le flux « %1$s ». Vérifie l\'adresse du flux dans les réglages.</string>
    <!-- %1$s est un numéro de version, par exemple « 4.0 ». -->
    <string name="error_unsupported_version">Ce réseau publie ses données en version %1$s, que cette version de l\'application ne sait pas lire. Mets l\'application à jour.</string>
    <string name="error_local_storage">Impossible de lire les données enregistrées sur l\'appareil.</string>

</resources>
