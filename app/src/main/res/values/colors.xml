<?xml version="1.0" encoding="utf-8"?>
<!--
    Colour tokens — light theme. SPEC.md §7.

    Six named colours, and an availability scale derived from one of them. No
    colour is written into a layout: everything goes through these resources,
    and the dark theme redefines the same names in values-night/colors.xml.

    Direction: "slate". A cool blue-grey for the background, ink almost black
    but never black, and ONE signal hue — a deep teal — carrying both
    availability and interaction. The boldness is spent in a single place, the
    availability indicator; everything else is calm.

    The availability scale is a ramp of INK DENSITY over a single hue: the more
    bikes there are, the more ink there is. It is therefore legible whatever
    the form of colour blindness, and the figure is shown on top in any case —
    colour never carries the information alone.

    Contrasts verified (WCAG 2.1): the lowest in the set is 5.07:1.
-->
<resources>

    <!-- The screen's background. -->
    <color name="papier">#E8ECEF</color>
    <!-- Surfaces laid on the background: list rows, sheets, fields. The
         separation is tonal, without a drop shadow. -->
    <color name="surface">#FAFCFD</color>
    <!-- Main text and strokes. Never pure black. -->
    <color name="encre">#0E1519</color>
    <!-- Secondary text, captions, units. -->
    <color name="encre_douce">#56656F</color>
    <!-- The signal hue: availability and interactive elements. -->
    <color name="signal">#00636F</color>
    <!-- Draws the eye to what is missing: no bike, no dock, out of service. -->
    <color name="alerte">#9C4A00</color>

    <!-- The availability scale, derived from the signal hue. -->
    <color name="dispo_faible">#B8D5D8</color>
    <color name="dispo_moyenne">#5BA1AA</color>
    <color name="dispo_bonne">#00636F</color>
    <!-- The figure laid on each of the three fills. -->
    <color name="dispo_faible_encre">#0E1519</color>
    <color name="dispo_moyenne_encre">#0E1519</color>
    <color name="dispo_bonne_encre">#FFFFFF</color>

    <!-- Ink laid on a flat of the signal hue: active button, well-stocked
         indicator. It inverts from one theme to the other. -->
    <color name="surface_on_signal">#FAFCFD</color>

    <!-- Separator strokes, field outlines. -->
    <color name="trait">#CCD5DA</color>

    <!-- The signal hue lightened, for inverted surfaces — the alert bar in particular, whose background is dark even in the light theme. -->
    <color name="signal_inverse">#3FBFCE</color>

    <!-- The background of inverted surfaces. -->
    <color name="surface_inverse">#0E1519</color>

    <!-- Ink laid on an inverted surface. -->
    <color name="encre_inverse">#FAFCFD</color>

    <!--
        The base map's palette (SPEC §7).

        Deliberately DESATURATED: the map is scenery, the stations are the
        subject. Every hue is pulled towards grey so the teal markers stand out
        without having to shout.

        These tokens are injected into assets/map/style.json at load time: the
        style holds no hard-coded colour, and the dark theme changes only these
        values, never the layers' structure.
    -->
    <color name="map_land">#EEF1F3</color>
    <color name="map_water">#C9D7DD</color>
    <color name="map_greenery">#DCE4DC</color>
    <color name="map_building">#E2E7EB</color>
    <color name="map_building_edge">#D3DADF</color>
    <color name="map_road_major">#FFFFFF</color>
    <color name="map_road_major_edge">#D2D9DE</color>
    <color name="map_road_minor">#F8FAFB</color>
    <color name="map_rail">#BAC4CA</color>
    <color name="map_boundary">#C0CAD1</color>
    <color name="map_label">#4B5A63</color>
    <color name="map_label_strong">#28353D</color>
    <color name="map_label_halo">#EEF1F3</color>
    <color name="map_marker_minor">#93A1A9</color>

</resources>
