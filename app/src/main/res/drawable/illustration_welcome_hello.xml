<?xml version="1.0" encoding="utf-8"?>
<!--
    What the application is, in one drawing (SPEC §7.9, first page): a journey
    walk → bike → walk, laid on the map it happens on.

    It is deliberately illustration_journey, redrawn over a base map rather than
    invented afresh: the same journey, drawn on three screens — here, the search
    screen and the map's own markers — must be recognised as one object. What
    the map adds is the sentence's first half, "shared bikes on a map".

    The scenery is quiet on purpose. It borrows the base map's own tokens, so
    the picture and the real map are the same map, and every one of them is a
    step darker in the dark theme without this file knowing about it.

    The two ends of the journey are filled with the surface colour rather than
    left transparent, unlike illustration_journey: over a map, a see-through
    disc takes the colour of whatever lies beneath and the figure stops reading.

    Mirrored in right-to-left languages, for the same reason as
    illustration_journey: the drawing tells a sequence.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="180dp"
    android:height="105dp"
    android:autoMirrored="true"
    android:viewportWidth="240"
    android:viewportHeight="140">

    <!-- The scenery, clipped to the frame: a map is a window on a city, and a
         street that ran past the frame would say the opposite. -->
    <group>
        <clip-path android:pathData="M14,4 H226 A10,10 0 0 1 236,14 V126 A10,10 0 0 1 226,136 H14 A10,10 0 0 1 4,126 V14 A10,10 0 0 1 14,4 Z" />

        <path
            android:fillColor="@color/map_land"
            android:pathData="M14,4 H226 A10,10 0 0 1 236,14 V126 A10,10 0 0 1 226,136 H14 A10,10 0 0 1 4,126 V14 A10,10 0 0 1 14,4 Z" />

        <!-- A park and a river: two landmarks are enough to read a fragment of
             city, and a third would compete with the journey. -->
        <path
            android:fillColor="@color/map_greenery"
            android:pathData="M22,10 H74 A6,6 0 0 1 80,16 V44 A6,6 0 0 1 74,50 H22 A6,6 0 0 1 16,44 V16 A6,6 0 0 1 22,10 Z" />
        <path
            android:pathData="M4,118 C56,108 88,130 148,116 C196,105 214,100 236,104"
            android:strokeColor="@color/map_water"
            android:strokeWidth="14" />

        <!-- Streets, drawn as the base map draws them: a casing, then the
             carriageway. The white fill alone is invisible on a pale ground. -->
        <path
            android:pathData="M52,4 V136 M192,4 V136 M4,26 H236"
            android:strokeColor="@color/map_road_minor_edge"
            android:strokeWidth="12" />
        <path
            android:pathData="M52,4 V136 M192,4 V136 M4,26 H236"
            android:strokeColor="@color/map_road_minor"
            android:strokeWidth="10" />
    </group>

    <!-- The frame itself, over the scenery so the stroke stays a hairline. -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M14,4 H226 A10,10 0 0 1 236,14 V126 A10,10 0 0 1 226,136 H14 A10,10 0 0 1 4,126 V14 A10,10 0 0 1 14,4 Z"
        android:strokeColor="@color/outline"
        android:strokeWidth="2" />

    <!-- The journey, at the height that centres it in the frame. -->
    <group android:translateY="50">

        <!-- Departure, on foot: outlined, because nothing is waiting there. -->
        <path
            android:fillColor="@color/surface"
            android:pathData="M20,6a14,14 0 1,0 0.1,0z"
            android:strokeColor="@color/ink_soft"
            android:strokeWidth="2" />
        <group
            android:scaleX="0.7"
            android:scaleY="0.7"
            android:translateX="11.6"
            android:translateY="11.6">
            <path
                android:fillColor="@color/ink"
                android:pathData="M13.5,5.5c1.1,0 2,-0.9 2,-2s-0.9,-2 -2,-2 -2,0.9 -2,2 0.9,2 2,2zM9.8,8.9L7,23h2.1l1.8,-8 2.1,2v6h2v-7.5l-2.1,-2 0.6,-3C14.8,12 16.8,13 19,13v-2c-1.9,0 -3.5,-1 -4.3,-2.4l-1,-1.6c-0.4,-0.6 -1,-1 -1.7,-1 -0.3,0 -0.5,0.1 -0.8,0.1L6,8.3V13h2V9.6l1.8,-0.7" />
        </group>

        <!-- Walking to the departure station: dashed, like the walk legs of
             the journey screen. -->
        <path
            android:pathData="M38,20h7 M49,20h7 M60,20h7"
            android:strokeColor="@color/ink_soft"
            android:strokeLineCap="round"
            android:strokeWidth="2" />

        <!-- Departure station: a solid disc, ringed with the surface colour so
             it lifts off whatever the map puts underneath. -->
        <path
            android:fillColor="@color/signal"
            android:pathData="M85,5a15,15 0 1,0 0.1,0z"
            android:strokeColor="@color/surface"
            android:strokeWidth="2" />
        <group
            android:scaleX="0.7"
            android:scaleY="0.7"
            android:translateX="76.6"
            android:translateY="11.6">
            <path
                android:fillColor="@color/surface_on_signal"
                android:pathData="M15.5,5.5c1.1,0 2,-0.9 2,-2s-0.9,-2 -2,-2 -2,0.9 -2,2 0.9,2 2,2zM5,12c-2.8,0 -5,2.2 -5,5s2.2,5 5,5 5,-2.2 5,-5 -2.2,-5 -5,-5zM5,20.5c-1.9,0 -3.5,-1.6 -3.5,-3.5s1.6,-3.5 3.5,-3.5 3.5,1.6 3.5,3.5 -1.6,3.5 -3.5,3.5zM10.8,10.5l2.4,-2.4 0.8,0.8c1.3,1.3 3,2.1 5.1,2.1V9c-1.5,0 -2.7,-0.6 -3.6,-1.5l-1.9,-1.9c-0.5,-0.4 -1,-0.6 -1.6,-0.6s-1.1,0.2 -1.4,0.6L7.8,8.4c-0.4,0.4 -0.6,0.9 -0.6,1.4 0,0.6 0.2,1.1 0.6,1.4L11,14v5h2v-6.2l-2.2,-2.3zM19,12c-2.8,0 -5,2.2 -5,5s2.2,5 5,5 5,-2.2 5,-5 -2.2,-5 -5,-5zM19,20.5c-1.9,0 -3.5,-1.6 -3.5,-3.5s1.6,-3.5 3.5,-3.5 3.5,1.6 3.5,3.5 -1.6,3.5 -3.5,3.5z" />
        </group>

        <!-- The ride: one unbroken line, the journey's main leg. -->
        <path
            android:pathData="M102,20h36"
            android:strokeColor="@color/signal"
            android:strokeLineCap="round"
            android:strokeWidth="3" />

        <!-- Arrival station: the same disc, since one leaves a station and
             reaches a station. -->
        <path
            android:fillColor="@color/signal"
            android:pathData="M155,5a15,15 0 1,0 0.1,0z"
            android:strokeColor="@color/surface"
            android:strokeWidth="2" />
        <group
            android:scaleX="0.7"
            android:scaleY="0.7"
            android:translateX="146.6"
            android:translateY="11.6">
            <path
                android:fillColor="@color/surface_on_signal"
                android:pathData="M15.5,5.5c1.1,0 2,-0.9 2,-2s-0.9,-2 -2,-2 -2,0.9 -2,2 0.9,2 2,2zM5,12c-2.8,0 -5,2.2 -5,5s2.2,5 5,5 5,-2.2 5,-5 -2.2,-5 -5,-5zM5,20.5c-1.9,0 -3.5,-1.6 -3.5,-3.5s1.6,-3.5 3.5,-3.5 3.5,1.6 3.5,3.5 -1.6,3.5 -3.5,3.5zM10.8,10.5l2.4,-2.4 0.8,0.8c1.3,1.3 3,2.1 5.1,2.1V9c-1.5,0 -2.7,-0.6 -3.6,-1.5l-1.9,-1.9c-0.5,-0.4 -1,-0.6 -1.6,-0.6s-1.1,0.2 -1.4,0.6L7.8,8.4c-0.4,0.4 -0.6,0.9 -0.6,1.4 0,0.6 0.2,1.1 0.6,1.4L11,14v5h2v-6.2l-2.2,-2.3zM19,12c-2.8,0 -5,2.2 -5,5s2.2,5 5,5 5,-2.2 5,-5 -2.2,-5 -5,-5zM19,20.5c-1.9,0 -3.5,-1.6 -3.5,-3.5s1.6,-3.5 3.5,-3.5 3.5,1.6 3.5,3.5 -1.6,3.5 -3.5,3.5z" />
        </group>

        <!-- Walking to the destination. -->
        <path
            android:pathData="M173,20h7 M184,20h7 M195,20h7"
            android:strokeColor="@color/ink_soft"
            android:strokeLineCap="round"
            android:strokeWidth="2" />

        <!-- Destination, on foot: outlined, like the departure. -->
        <path
            android:fillColor="@color/surface"
            android:pathData="M220,6a14,14 0 1,0 0.1,0z"
            android:strokeColor="@color/ink_soft"
            android:strokeWidth="2" />
        <group
            android:scaleX="0.7"
            android:scaleY="0.7"
            android:translateX="211.6"
            android:translateY="11.6">
            <path
                android:fillColor="@color/ink"
                android:pathData="M13.5,5.5c1.1,0 2,-0.9 2,-2s-0.9,-2 -2,-2 -2,0.9 -2,2 0.9,2 2,2zM9.8,8.9L7,23h2.1l1.8,-8 2.1,2v6h2v-7.5l-2.1,-2 0.6,-3C14.8,12 16.8,13 19,13v-2c-1.9,0 -3.5,-1 -4.3,-2.4l-1,-1.6c-0.4,-0.6 -1,-1 -1.7,-1 -0.3,0 -0.5,0.1 -0.8,0.1L6,8.3V13h2V9.6l1.8,-0.7" />
        </group>
    </group>
</vector>
