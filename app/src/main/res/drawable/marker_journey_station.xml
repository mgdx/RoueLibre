<?xml version="1.0" encoding="utf-8"?>
<!--
    A journey station on the map: the disc of the "journey" illustration, at
    marker size.

    Filled in the signal hue with the bike glyph laid on it, exactly as the
    departure and arrival stations are drawn on the search screen
    (illustration_journey): the same journey, drawn twice, must be recognised
    from one screen to the other.

    A surface ring separates it from whatever the base map puts underneath —
    the station markers of the main map are ringed the same way.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="36dp"
    android:height="36dp"
    android:viewportWidth="36"
    android:viewportHeight="36">

    <path
        android:fillColor="@color/signal"
        android:pathData="M18,3a15,15 0 1,0 0.1,0z"
        android:strokeColor="@color/surface"
        android:strokeWidth="2" />

    <!-- The bike glyph of ic_bike, at the scale the illustration uses. -->
