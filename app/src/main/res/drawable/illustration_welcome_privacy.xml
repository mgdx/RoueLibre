        android:fillColor="@color/surface"
        android:pathData="M36,6 H100 A12,12 0 0 1 112,18 V122 A12,12 0 0 1 100,134 H36 A12,12 0 0 1 24,122 V18 A12,12 0 0 1 36,6 Z"
        android:strokeColor="@color/ink"
        android:strokeWidth="2.5" />

    <!-- What is on the screen, clipped to it: a journey being worked out, on
         the base map's own colours. -->
    <group>
        <clip-path android:pathData="M38,18 H98 A6,6 0 0 1 104,24 V110 A6,6 0 0 1 98,116 H38 A6,6 0 0 1 32,110 V24 A6,6 0 0 1 38,18 Z" />

        <path
