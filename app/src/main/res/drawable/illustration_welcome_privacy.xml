        android:scaleY="0.5"
        android:translateX="86"
        android:translateY="31">
        <path
            android:fillColor="@color/surface"
            android:pathData="M12,0C6.48,0 2,4.48 2,10c0,7.5 10,20 10,20s10,-12.5 10,-20C22,4.48 17.52,0 12,0z" />
        <path
            android:fillColor="@color/signal"
            android:pathData="M12,1.6C7.36,1.6 3.6,5.36 3.6,10c0,6.4 8.4,17.4 8.4,17.4s8.4,-11 8.4,-17.4C20.4,5.36 16.64,1.6 12,1.6z" />
        <path
