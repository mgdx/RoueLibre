<?xml version="1.0" encoding="utf-8"?>
<!--
    Colour tokens — dark theme. SPEC.md §7.

    The same names as in the light theme, with redefined values. This is not an
    inversion: the background is a blued slate rather than black, the signal
    hue is lightened to hold on a dark background, and the availability scale
    inverts in luminance — on a dark background, "more ink" becomes "more
    light".

    Contrasts verified: the lowest in the set is 4.84:1.
-->
<resources>

    <color name="paper">#0E1418</color>
    <color name="surface">#172027</color>
    <color name="ink">#E7EDF1</color>
    <color name="ink_soft">#93A3AD</color>
    <color name="signal">#3FBFCE</color>
    <color name="alert">#E0913F</color>

    <color name="availability_low">#1B3D44</color>
    <color name="availability_medium">#22707C</color>
    <color name="availability_good">#3FBFCE</color>
    <color name="availability_low_ink">#E7EDF1</color>
    <color name="availability_medium_ink">#E7EDF1</color>
    <color name="availability_good_ink">#0E1418</color>

    <!-- Ink laid on a flat of the signal hue. -->
    <color name="surface_on_signal">#0E1418</color>

    <color name="outline">#2A363F</color>

    <!-- The signal hue darkened, for inverted surfaces. -->
    <color name="signal_inverse">#00636F</color>

    <!-- The background of inverted surfaces. -->
    <color name="surface_inverse">#E7EDF1</color>

    <!-- Ink laid on an inverted surface. -->
    <color name="ink_inverse">#0E1418</color>

    <!-- The base map's palette, dark theme. The same desaturation with
         inverted values: the map stays scenery under the markers. -->
    <color name="map_land">#11171C</color>
    <color name="map_water">#16232B</color>
    <color name="map_greenery">#17211C</color>
    <color name="map_building">#1A222A</color>
    <color name="map_building_edge">#222C35</color>
    <color name="map_road_major">#2A343C</color>
    <color name="map_road_major_edge">#3A464F</color>
    <color name="map_road_minor">#1D262D</color>
    <color name="map_rail">#39454D</color>
    <color name="map_boundary">#33404A</color>
    <color name="map_label">#93A3AD</color>
    <color name="map_label_strong">#C9D6DE</color>
    <color name="map_label_halo">#11171C</color>
    <color name="map_marker_minor">#5A6A75</color>

</resources>
