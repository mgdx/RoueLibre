<?xml version="1.0" encoding="utf-8"?>
<!--
    Jetons de couleur — thème sombre. SPEC.md §7.

    Mêmes noms qu'en thème clair, valeurs redéfinies. Ce n'est pas une
    inversion : le fond est une ardoise bleutée et non du noir, la teinte de
    signal est éclaircie pour tenir sur fond sombre, et l'échelle de
    disponibilité s'inverse en luminance — sur fond sombre, « plus d'encre »
    devient « plus de lumière ».

    Contrastes vérifiés : le plus faible du jeu est de 4,84:1.
-->
<resources>

    <color name="papier">#0E1418</color>
    <color name="surface">#172027</color>
    <color name="encre">#E7EDF1</color>
    <color name="encre_douce">#93A3AD</color>
