    <color name="dispo_moyenne_encre">#E7EDF1</color>
    <color name="dispo_bonne_encre">#0E1418</color>

    <!-- Encre posée sur un aplat de la teinte de signal. -->
    <color name="surface_on_signal">#0E1418</color>

    <color name="trait">#2A363F</color>

    <!-- Teinte de signal assombrie, pour les surfaces inversées. -->
