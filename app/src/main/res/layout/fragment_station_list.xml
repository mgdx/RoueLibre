<?xml version="1.0" encoding="utf-8"?>
<!--
    The provisional main screen: the station list.

    Stage (1) of SPEC §16 — "fetching and displaying GBFS data as a list". The
    map takes its place at stage (3); this list stays reachable, notably when
    the offline datasets are not installed yet and the application is limited to
    availability (SPEC §4.4).
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginTop="@dimen/space_l"
        android:text="@string/stations_title"
        android:textAppearance="@style/TextAppearance.RoueLibre.Title"
        app:layout_constraintEnd_toStartOf="@id/open_map"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- The title stops at the innermost icon, not at the outermost: the three
         icons sit side by side, and a title box running under the first of
         them only looks harmless while the text is left-aligned. In Arabic it
         is right-aligned, and "Stations" was printed under the star. -->

    <!-- The settings, at the edge where the map keeps them too (SPEC §7.1), so
         one gesture finds them from either screen. They are also the way to the
         offline data, which is why no fourth icon leads there: their own "manage
         offline data" line does (SPEC §4.4), and four controls beside the title
         leave the title nothing. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/open_settings"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginEnd="@dimen/space_s"
        android:contentDescription="@string/settings_open"
        app:icon="@drawable/ic_settings"
        app:iconTint="@color/ink"
        app:layout_constraintBottom_toBottomOf="@id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/title" />

    <!-- Favourites (SPEC §7.5): beside the complete list, since they are an
         extract of it. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/open_favourites"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:contentDescription="@string/favourites_open"
        app:icon="@drawable/ic_favourite"
        app:iconTint="@color/ink"
        app:layout_constraintBottom_toBottomOf="@id/title"
        app:layout_constraintEnd_toStartOf="@id/open_settings"
        app:layout_constraintTop_toTopOf="@id/title" />

    <!-- The way to the map, here whatever is behind this list (SPEC §7.6). It
         used to be shown only where this list was the screen the application
         opened on, and it vanished the moment one came back to the list from the
         map — which stacks a second list — leaving the map reachable by nothing
         but repeated back gestures. A way out that appears and disappears with
         the depth of the back stack cannot be learnt. Pressed, it returns to the
         map behind rather than building another: see StationListFragment. The
         title's box stops here, this being the innermost of the three. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/open_map"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:contentDescription="@string/stations_open_map"
        app:icon="@drawable/ic_map_place"
        app:iconTint="@color/ink"
        app:layout_constraintBottom_toBottomOf="@id/title"
        app:layout_constraintEnd_toStartOf="@id/open_favourites"
        app:layout_constraintTop_toTopOf="@id/title" />

    <!-- The data's age, required by SPEC §4.1. Not justified, for the reason
         given under `Widget.RoueLibre.SettingsLabel`: it is a status line and
         not a paragraph, and at the largest text sizes it takes two lines —
         the first of which, spread bank to bank, reads as something other than
         one sentence. -->
    <TextView
        android:id="@+id/freshness"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginEnd="@dimen/space_l"
        android:justificationMode="none"
        android:textAppearance="@style/TextAppearance.RoueLibre.Secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title"
        tools:text="Mis à jour il y a 12 secondes" />

    <!--
        Filters the list by station name. Not to be confused with the address
        search of SPEC §4.3, which queries the offline index.
    -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/search_field"
        style="@style/Widget.RoueLibre.SearchField"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginTop="@dimen/space_m"
        android:layout_marginEnd="@dimen/space_l"
        android:hint="@string/search_stations_hint"
        app:endIconContentDescription="@string/search_stations_clear"
        app:endIconMode="clear_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/freshness">

        <!-- `flagNoExtractUi`: in landscape the keyboard otherwise takes the
             whole screen for a copy of this field, and the results that
             follow every keystroke stay hidden until it is folded away. -->
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/search_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:inputType="text"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.RoueLibre.Body" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- The "bikes" / "docks" toggle (SPEC §7.1). -->
    <io.github.mgdx.rouelibre.ui.ToggleRow
        android:id="@+id/mode_toggle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginTop="@dimen/space_m"
        android:layout_marginEnd="@dimen/space_l"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/search_field"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mode_bikes"
            style="@style/Widget.RoueLibre.Toggle.Choice"
            android:text="@string/mode_bikes" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mode_docks"
            style="@style/Widget.RoueLibre.Toggle.Choice"
            android:text="@string/mode_docks" />
    </io.github.mgdx.rouelibre.ui.ToggleRow>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_m"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mode_toggle">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/stations"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurface"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/list_room_under_the_last_row"
            android:scrollbars="vertical"
            tools:itemCount="6"
            tools:listitem="@layout/item_station" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!--
        An empty screen: an invitation to act, not a statement (SPEC §7).
    -->
    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_xxl"
        android:layout_marginEnd="@dimen/space_xxl"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/swipe_refresh"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/swipe_refresh"
        tools:visibility="visible">

        <TextView
            android:id="@+id/empty_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.RoueLibre.Title"
            tools:text="Aucune station chargée" />

        <TextView
            android:id="@+id/empty_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.RoueLibre.Secondary"
            tools:text="Tire la liste vers le bas pour récupérer les stations du réseau." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/empty_action"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginTop="@dimen/space_l"
            tools:text="Rafraîchir" />
    </LinearLayout>

    <!--
        Nearest station first (SPEC §7.2), where the thumb is: over the list,
        at the bottom edge, as the map keeps its own controls (SPEC §7.1). It
        is the only thing this screen offers to do to the list under it — the
        three icons beside the title lead away from it — so it stands alone
        and away from them.

        It is the map's "locate me" in shape and in gesture, and not in colour:
        that one is a pale disc because it sits on a map, and a pale disc on
        this screen would be a white circle on a white list. It takes the
        signal green, which no other control on this screen wears.

        Last in the layout, so it draws over the rows: nothing is constrained
        to it, and the list carries a bottom padding of its own so the last row
        can be scrolled clear of it.
    -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/locate_me"
        style="@style/Widget.Material3.Button.IconButton.Filled"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginEnd="@dimen/space_m"
        android:layout_marginBottom="@dimen/space_m"
        android:contentDescription="@string/stations_order_by_distance"
        app:backgroundTint="@color/signal"
        app:icon="@drawable/ic_my_location"
        app:iconTint="@color/surface_on_signal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        That the button is working, while the fix is waited for. The press can
        run to ten seconds indoors (`DeviceLocation.REQUEST_TIMEOUT`), and the
        button going dead was the whole of the answer for that long: a tester
        pressing it from outside the served city read those seconds as a button
        that does nothing, and the sentence that came at the end of them was
        gone before the next look.

        A ring around the button rather than a banner: it lasts exactly as long
        as the wait, where a banner fades after three seconds and a half in the
        middle of one, and it sits under the thumb that has just pressed —
        which is where the eye is. It takes the green button's own foreground,
        so the pressed control reads as one thing rather than two.

        **It never flashes for a wait too short to need it.** A fix obtained
        seconds ago and precise enough comes back on the spot, and something
        appearing and vanishing within a frame or two is worse than nothing at
        all. `showDelay` holds it back for half a second, and `minHideDelay`
        keeps it up for that long once shown: below half a second the press is
        answered before anything appears, and the two are the library's own
        doing rather than timing written by hand here.

        Nothing for the screen reader to read: it announces the button, which
        is disabled for the whole of the wait, and the answer comes as a
        message that is spoken.
    -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/locating"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:importantForAccessibility="no"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/surface_on_signal"
        app:indicatorInset="0dp"
        app:layout_constraintBottom_toBottomOf="@id/locate_me"
        app:layout_constraintEnd_toEndOf="@id/locate_me"
        app:layout_constraintStart_toStartOf="@id/locate_me"
        app:layout_constraintTop_toTopOf="@id/locate_me"
        app:minHideDelay="500"
        app:showDelay="500"
        app:trackColor="@android:color/transparent"
        app:trackThickness="2dp"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
