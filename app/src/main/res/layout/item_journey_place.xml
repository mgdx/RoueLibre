<?xml version="1.0" encoding="utf-8"?>
<!--
    A place the journey passes through (SPEC §7.4): one of its two ends, or one
    of the two stations.

    The marker is the map's own — outlined disc with a walking figure for an end
    of the journey, filled disc with a bike for a station — so the row and the
    point drawn on the previous screen are recognised as the same thing.

    The role is named above the place rather than left to be inferred: on this
    screen a station's name and a destination's address sit in the same column,
    and only the label tells the reader which is which.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/space_s"
    android:paddingBottom="@dimen/space_s">

    <ImageView
        android:id="@+id/marker"
        android:layout_width="@dimen/journey_place_marker"
        android:layout_height="@dimen/journey_place_marker"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/role"
        tools:src="@drawable/marker_journey_station" />

    <TextView
        android:id="@+id/role"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:textAppearance="@style/TextAppearance.RoueLibre.Label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/marker"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Departure station" />

    <TextView
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.RoueLibre.Body"
        app:layout_constraintEnd_toEndOf="@id/role"
        app:layout_constraintStart_toStartOf="@id/role"
        app:layout_constraintTop_toBottomOf="@id/role"
        tools:text="Gare Lille Flandres" />

    <!-- The street the station stands in, read off the offline index. Absent
         when the index knows nothing near enough, and on a journey's end, whose
         label already says where it is. -->
    <TextView
        android:id="@+id/address"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.RoueLibre.Secondary"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/role"
        app:layout_constraintStart_toStartOf="@id/role"
        app:layout_constraintTop_toBottomOf="@id/name"
        tools:text="12 Rue Nationale · 59800 Lille"
        tools:visibility="visible" />

    <!-- What the station held when the journey was worked out. SPEC §6 asks
         that it always be shown: it is what lets the user judge the risk they
         are taking on a station with a single bike left. -->
    <TextView
        android:id="@+id/availability"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.RoueLibre.Secondary"
        android:textColor="@color/ink"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/role"
        app:layout_constraintStart_toStartOf="@id/role"
        app:layout_constraintTop_toBottomOf="@id/address"
        tools:text="8 bikes available · 40 docks"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
