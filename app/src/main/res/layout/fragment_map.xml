<?xml version="1.0" encoding="utf-8"?>
<!--
    The main screen: the map (SPEC §7.1).

    The controls are at the bottom, within thumb reach: SPEC §7 asks for an
    interface usable one-handed.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/map"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
        Attribution, mandatory and visible on the map itself (SPEC §4.5).
        Text rather than an info button: "visible" means read without having to
        open anything.
    -->
    <TextView
        android:id="@+id/attribution"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/map_label_halo"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="@dimen/space_s"
        android:paddingTop="2dp"
        android:paddingEnd="@dimen/space_s"
        android:paddingBottom="2dp"
        android:text="@string/map_attribution"
        android:textAllCaps="false"
        android:textAppearance="@style/TextAppearance.RoueLibre.Label"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- The data's age, required by SPEC §4.1, laid over the map. -->
    <TextView
        android:id="@+id/freshness"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_m"
        android:background="@drawable/pill_surface"
        android:paddingStart="@dimen/space_m"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/space_m"
        android:paddingBottom="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.RoueLibre.Secondary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Mis à jour il y a 12 secondes" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/open_settings"
        style="@style/Widget.Material3.Button.IconButton.Filled"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_margin="@dimen/space_m"
        android:contentDescription="@string/settings_open"
        app:backgroundTint="@color/surface"
        app:icon="@drawable/ic_settings"
        app:iconTint="@color/ink"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/open_list"
        style="@style/Widget.Material3.Button.IconButton.Filled"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginEnd="@dimen/space_m"
        android:layout_marginBottom="@dimen/space_m"
        android:contentDescription="@string/map_open_list"
        app:backgroundTint="@color/surface"
        app:icon="@drawable/ic_list"
        app:iconTint="@color/ink"
        app:layout_constraintBottom_toTopOf="@id/attribution"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Journey search (SPEC §7.3), the function the application exists to
         provide: it is therefore the largest of the controls. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/open_journey"
        style="@style/Widget.Material3.Button.IconButton.Filled"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginEnd="@dimen/space_m"
        android:layout_marginBottom="@dimen/space_s"
        android:contentDescription="@string/journey_open"
        app:backgroundTint="@color/signal"
        app:icon="@drawable/ic_bike"
        app:iconTint="@color/surface_on_signal"
        app:layout_constraintBottom_toTopOf="@id/locate_me"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Locate me (SPEC §7.1). The permission is requested here alone, at
         the moment the user understands why (SPEC §10). -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/locate_me"
        style="@style/Widget.Material3.Button.IconButton.Filled"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginEnd="@dimen/space_m"
        android:layout_marginBottom="@dimen/space_s"
        android:contentDescription="@string/map_locate_me"
        app:backgroundTint="@color/surface"
        app:icon="@drawable/ic_my_location"
        app:iconTint="@color/ink"
        app:layout_constraintBottom_toTopOf="@id/open_search"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Address search (SPEC §4.3), within thumb reach like the other main
         controls. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/open_search"
        style="@style/Widget.Material3.Button.IconButton.Filled"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginEnd="@dimen/space_m"
        android:layout_marginBottom="@dimen/space_s"
        android:contentDescription="@string/address_search_title"
        app:backgroundTint="@color/surface"
        app:icon="@drawable/ic_search"
        app:iconTint="@color/ink"
        app:layout_constraintBottom_toTopOf="@id/open_list"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        The point found by the search. It carries its label rather than its
        coordinates: "12 bis Rue Nationale" reads back, "50.63 / 3.06" does
        not. A tap clears it.
    -->
    <TextView
        android:id="@+id/picked_place"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_marginEnd="@dimen/space_m"
        android:layout_marginBottom="@dimen/space_m"
        android:background="@drawable/pill_surface"
        android:drawablePadding="@dimen/space_s"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:minHeight="@dimen/touch_target_min"
        android:paddingStart="@dimen/space_m"
        android:paddingEnd="@dimen/space_m"
        android:textAppearance="@style/TextAppearance.RoueLibre.Body"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_place"
        app:layout_constraintBottom_toTopOf="@id/mode_toggle"
        app:layout_constraintEnd_toStartOf="@id/open_search"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="12 bis Rue Nationale"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mode_toggle"
        style="@style/Widget.RoueLibre.Toggle"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginStart="@dimen/space_m"
        android:layout_marginBottom="@dimen/space_m"
        app:layout_constraintBottom_toTopOf="@id/attribution"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Vélos" />

    <!--
        The "pick a point" mode (SPEC §7.3): the map moves under a fixed
        crosshair, rather than waiting for a precise tap. One aims by moving the
        map, which leaves what is being aimed at visible.
    -->
    <ImageView
        android:id="@+id/pick_crosshair"
        android:layout_width="@dimen/space_xxl"
        android:layout_height="@dimen/space_xxl"
        android:contentDescription="@string/journey_pick_crosshair"
        android:src="@drawable/ic_crosshair"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/pick_confirm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target_min"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginEnd="@dimen/space_l"
        android:layout_marginBottom="@dimen/space_l"
        android:text="@string/journey_pick_confirm"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/attribution"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

    <!--
        Without a base map installed, the screen explains and offers the two
        ways on: install, or make do with the list. SPEC §4.4 makes it an
        accepted degraded mode, not a breakdown.
    -->
    <LinearLayout
        android:id="@+id/missing_tiles"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?android:attr/colorBackground"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xxl"
        android:paddingEnd="@dimen/space_xxl"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <TextView
            android:id="@+id/missing_tiles_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/map_needs_tiles_title"
            android:textAppearance="@style/TextAppearance.RoueLibre.Title" />

        <TextView
            android:id="@+id/missing_tiles_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center"
            android:text="@string/map_needs_tiles_message"
            android:textAppearance="@style/TextAppearance.RoueLibre.Secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/missing_tiles_storage"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/storage_open" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/missing_tiles_list"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/map_open_list"
            android:textColor="@color/signal" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
