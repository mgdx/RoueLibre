<?xml version="1.0" encoding="utf-8"?>
<!--
    Écran principal : la carte (SPEC §7.1).

    Les commandes sont en bas, à portée du pouce : le SPEC §7 demande une
    interface utilisable à une main.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/map"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
        Attribution, obligatoire et visible sur la carte elle-même (SPEC §4.5).
        Un texte plutôt qu'un bouton d'information : « visible » veut dire lu
        sans avoir à ouvrir quoi que ce soit.
    -->
    <TextView
        android:id="@+id/attribution"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/map_label_halo"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="@dimen/space_s"
        android:paddingTop="2dp"
        android:paddingEnd="@dimen/space_s"
        android:paddingBottom="2dp"
        android:text="@string/map_attribution"
        android:textAllCaps="false"
        android:textAppearance="@style/TextAppearance.RoueLibre.Label"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Âge de la donnée, exigé par le SPEC §4.1, posé sur la carte. -->
    <TextView
        android:id="@+id/freshness"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_m"
        android:background="@drawable/pill_surface"
        android:paddingStart="@dimen/space_m"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/space_m"
        android:paddingBottom="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.RoueLibre.Secondary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Mis à jour il y a 12 secondes" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/open_storage"
        style="@style/Widget.Material3.Button.IconButton.Filled"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_margin="@dimen/space_m"
        android:contentDescription="@string/storage_open"
        app:backgroundTint="@color/surface"
        app:icon="@drawable/ic_storage"
        app:iconTint="@color/encre"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/open_list"
        style="@style/Widget.Material3.Button.IconButton.Filled"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginEnd="@dimen/space_m"
        android:layout_marginBottom="@dimen/space_m"
        android:contentDescription="@string/map_open_list"
        app:backgroundTint="@color/surface"
        app:icon="@drawable/ic_list"
        app:iconTint="@color/encre"
        app:layout_constraintBottom_toTopOf="@id/attribution"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mode_toggle"
        style="@style/Widget.RoueLibre.Toggle"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginStart="@dimen/space_m"
        android:layout_marginBottom="@dimen/space_m"
        app:layout_constraintBottom_toTopOf="@id/attribution"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Vélos" />

    <!--
        Sans fond de carte installé, l'écran explique et propose les deux
        suites possibles : installer, ou se contenter de la liste. Le SPEC
        §4.4 en fait un mode dégradé assumé, pas une panne.
    -->
    <LinearLayout
        android:id="@+id/missing_tiles"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?android:attr/colorBackground"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xxl"
        android:paddingEnd="@dimen/space_xxl"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/map_needs_tiles_title"
            android:textAppearance="@style/TextAppearance.RoueLibre.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center"
            android:text="@string/map_needs_tiles_message"
            android:textAppearance="@style/TextAppearance.RoueLibre.Secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/missing_tiles_storage"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/storage_open" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/missing_tiles_list"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/map_open_list"
            android:textColor="@color/signal" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
