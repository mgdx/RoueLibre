<?xml version="1.0" encoding="utf-8"?>
<!--
    One leg of the journey (SPEC §7.4), on the detail screen.

    The icon says the mode, the text says what to do and where, the duration
    stays right-aligned so the three legs compare at a glance. The icon is
    inset, so that this row's text stands in the same column as the text of the
    places it runs between (item_journey_place), whose marker is wider.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/touch_target_min"
    android:paddingTop="@dimen/space_s"
    android:paddingBottom="@dimen/space_s">

    <ImageView
        android:id="@+id/mode_icon"
        android:layout_width="@dimen/space_xl"
        android:layout_height="@dimen/space_xl"
        android:layout_marginStart="@dimen/space_s"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/ink_soft"
        tools:src="@drawable/ic_walk" />

    <!-- Both lines name a thing rather than run on, so both refuse the
         justification and the hyphenation the theme gives every text view, as
         the station rows of item_station.xml do. At the largest text sizes
         "Ride to Theatre Sebastopol" wraps, and justified its first line came
         out bank to bank with a hand's breadth between the words. -->
    <TextView
        style="@style/Widget.RoueLibre.Name"
        android:id="@+id/label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:textAppearance="@style/TextAppearance.RoueLibre.Body"
        app:layout_constraintEnd_toStartOf="@id/duration"
        app:layout_constraintStart_toEndOf="@id/mode_icon"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Marcher jusqu'à Gare Lille Flandres" />

    <TextView
        style="@style/Widget.RoueLibre.Name"
        android:id="@+id/detail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.RoueLibre.Secondary"
        app:layout_constraintEnd_toEndOf="@id/label"
        app:layout_constraintStart_toStartOf="@id/label"
        app:layout_constraintTop_toBottomOf="@id/label"
        tools:text="650 m · 8 vélos disponibles" />

    <TextView
        android:id="@+id/duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:fontFamily="@font/bricolage_semibold"
        android:fontFeatureSettings="tnum"
        android:textAppearance="@style/TextAppearance.RoueLibre.Body"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/label"
        tools:text="9 min" />

</androidx.constraintlayout.widget.ConstraintLayout>
