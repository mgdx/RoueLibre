<?xml version="1.0" encoding="utf-8"?>
<!--
    Favourites (SPEC §7.5).

    The same rows as the station list: they are the same stations, and learning
    two layouts for one object would be work asked of the user.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/favourites_title"
        app:titleTextAppearance="@style/TextAppearance.RoueLibre.Title" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginEnd="@dimen/space_l"
        android:layout_marginBottom="@dimen/space_s"
        android:text="@string/favourites_reorder_hint"
        android:textAppearance="@style/TextAppearance.RoueLibre.Secondary"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/stations"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/colorSurface"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hint"
        tools:itemCount="4"
        tools:listitem="@layout/item_station" />

    <!-- An empty screen: an invitation to act, not a statement (SPEC §7). -->
    <TextView
        android:id="@+id/empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_xxl"
        android:layout_marginEnd="@dimen/space_xxl"
        android:gravity="center"
        android:text="@string/journey_no_favourite"
        android:textAppearance="@style/TextAppearance.RoueLibre.Secondary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/stations"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/stations"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
