<?xml version="1.0" encoding="utf-8"?>
<!--
    First launch (SPEC §7.9).

    A screen, not a dialog: the content is too dense for a modal window, and it
    must be readable again from "about".

    The text is short and the way out always available: "later" hides nothing,
    it postpones. We explain how something works, we are not selling anything.

    Each page carries a drawing above its buttons. It is not decoration filling
    a void: what a page says in three sentences — a journey walk-bike-walk, a
    boundary nothing crosses, a city downloaded once — is a shape before it is
    a paragraph, and the reader who skips the text still leaves with it.

    The fleet page is the exception, and it hides that drawing: its three marks
    each carry a sentence, so they belong to the text (SPEC §7.9).

    This is the page standing up. Lying down it is laid out otherwise — see
    `layout-land/fragment_welcome.xml`, where the reason is written: stacked
    over a sideways screen, these same parts left the paragraph two lines and
    a half. The views are the same there and carry the same identifiers, and
    what they write comes from the same `view_welcome_page_text.xml`.

    The side spacing is set with margins on each child, not with padding on the
    root: fitsSystemWindows replaces the padding of the view it is set on with
    the window insets, and the padding declared here used to be silently
    dropped — the text ran into both edges of the screen.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- The page's title, and it refuses the justification the theme gives
         every text view — as the settings screen's own headings do, for the
         reason written there and one more.

         Justifying spreads a line bank to bank, and reaching the far bank is
         worth breaking a word for: at the largest text sizes "Une ville, un
         téléchargement" came out as "Une ville, un téléchar" filling the line
         to the pixel, with "gement" underneath. That reads as a title cut off
         at the edge of the screen, which is what it is. Unjustified, the line
         breaks at the space and the word stays whole. -->
    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginTop="@dimen/space_xxl"
        android:layout_marginEnd="@dimen/space_l"
        android:justificationMode="none"
        android:textAppearance="@style/TextAppearance.RoueLibre.Title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Roue Libre" />

    <!-- The room the text and the drawing share, between the title and the
         step label, and it is a layout of its own for one reason: a widget
         measured as `wrap` is measured against the height of the layout that
         holds it, and against nothing else.

         The text container asks for the height of its content, capped at what
         it is measured against. Held straight in the screen, that cap was the
         screen — so at the largest text sizes the container claimed a height
         the room below the title could not hold, and a chain that no longer
         fits does not shrink: it spills. The paragraph was written over the
         step label, over the button and over the link below it, and the
         container never scrolled because it was never made shorter than what
         it held.

         Given a layout of its own, the cap becomes this room, less the
         padding — so the container ends up either at its content's height or
         at the room's, and in the second case it is shorter than the text and
         scrolls, which is what SPEC §14 asks of a page that no longer fits.

         The spacing above and below is this layout's padding rather than the
         children's margins, and that is the point of it: padding is taken off
         the height the children are measured against, a margin is not. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/page_body"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginEnd="@dimen/space_l"
        android:paddingTop="@dimen/space_l"
        android:paddingBottom="@dimen/space_l"
        app:layout_constraintBottom_toTopOf="@id/step"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title">

        <!-- The text hangs from the title, and the bias is what says so.

             This container and the drawing under it constrain one another,
             which makes them a chain, and a spread chain ignores the bias: on
             the three pages that carry a drawing this attribute changes
             nothing, and the drawing goes on taking the height the text
             leaves. The fleet page hides the drawing, the chain is then gone,
             and the container is left with the whole room to itself — which
             the default bias of 0.5 spent by centring the text in it, a third
             of the screen of nothing under the title. At 0 the text stays
             where it is on every other page. -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/body_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/illustration"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintHeight_default="wrap"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0">

            <!-- The paragraph and, on the fleet page, the three marks. They
                 live in a layout of their own, shared with the arrangement of
                 `layout-land`, so that the two cannot drift apart. -->
            <include
                android:id="@+id/page_text"
                layout="@layout/view_welcome_page_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </androidx.core.widget.NestedScrollView>

        <!-- The drawing of the current page. Purely decorative: it repeats
             what the text above says, so a screen reader must not read it a
             second time.

             Placed under the text rather than above it: the text is what one
             reads first, and the drawing is what one is left looking at.

             It takes the height the text leaves rather than a written-down
             size: a fixed height leaves a hole on the short pages and steals
             from the text on the long ones. The text is measured first and
             capped at the room it is in; the drawing gets the remainder, and
             fitCenter keeps its proportions whatever that turns out to be.

             So it shrinks as the font grows, and at the largest sizes it goes
             altogether rather than pushing a paragraph below the fold. That is
             the right order: the drawing helps the text, it does not replace
             it — and it is why the fleet page's marks are not put here: what
             may vanish must not be what carries the meaning. -->
        <ImageView
            android:id="@+id/illustration"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_l"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/body_container"
            app:layout_constraintVertical_weight="2"
            tools:src="@drawable/illustration_welcome_hello" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/step"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginBottom="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.RoueLibre.Label"
        app:layout_constraintBottom_toTopOf="@id/next"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="1 SUR 3" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/next"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target_min"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginEnd="@dimen/space_l"
        android:layout_marginBottom="@dimen/space_s"
        app:layout_constraintBottom_toTopOf="@id/skip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Continuer" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/skip"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target_min"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginEnd="@dimen/space_l"
        android:layout_marginBottom="@dimen/space_l"
        android:textColor="@color/signal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Passer" />

</androidx.constraintlayout.widget.ConstraintLayout>
