<?xml version="1.0" encoding="utf-8"?>
<!--
    First launch (SPEC §7.9).

    A screen, not a dialog: the content is too dense for a modal window, and it
    must be readable again from "about".

    The text is short and the way out always available: "later" hides nothing,
    it postpones. We explain how something works, we are not selling anything.

    Each page carries a drawing above its buttons. It is not decoration filling
    a void: what a page says in three sentences — a journey walk-bike-walk, a
    boundary nothing crosses, a city downloaded once — is a shape before it is
    a paragraph, and the reader who skips the text still leaves with it.

    The fleet page is the exception, and it hides that drawing: its three marks
    each carry a sentence, so they belong to the text (SPEC §7.9).

    The side spacing is set with margins on each child, not with padding on the
    root: fitsSystemWindows replaces the padding of the view it is set on with
    the window insets, and the padding declared here used to be silently
    dropped — the text ran into both edges of the screen.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginTop="@dimen/space_xxl"
        android:layout_marginEnd="@dimen/space_l"
        android:textAppearance="@style/TextAppearance.RoueLibre.Title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Roue Libre" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/body_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginTop="@dimen/space_l"
        android:layout_marginEnd="@dimen/space_l"
        app:layout_constraintBottom_toTopOf="@id/illustration"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_goneMarginBottom="@dimen/space_l">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textAppearance="@style/TextAppearance.RoueLibre.Body"
                tools:text="Application libre et ouverte, sans compte, sans publicité, sans mouchard." />

            <!-- The three station marks, shown by the fleet page alone.

                 They are the very discs the map draws for a journey's
                 stations, at their own size, so the reader meets the mark here
                 and recognises it there rather than learning a symbol twice.

                 They sit in the text that scrolls and not in the drawing's
                 place below: that place is meant to shrink and then go
                 altogether at the largest font sizes, which is right for a
                 decoration and wrong for a sentence carrying the meaning.

                 Each line is one view, the mark being the sentence's own
                 leading drawable: it is decorative, the sentence saying what it
                 says, and a screen reader reads three lines each in one piece.
                 The text wraps past the mark rather than under it, so a long
                 sentence keeps its indent instead of running back to the
                 margin. -->
            <LinearLayout
                android:id="@+id/fleet_marks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/space_m"
                    android:gravity="center_vertical"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/welcome_fleet_mechanical_only"
                    android:textAppearance="@style/TextAppearance.RoueLibre.Body"
                    app:drawableStartCompat="@drawable/marker_journey_station" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:drawablePadding="@dimen/space_m"
                    android:gravity="center_vertical"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/welcome_fleet_electric_only"
                    android:textAppearance="@style/TextAppearance.RoueLibre.Body"
                    app:drawableStartCompat="@drawable/marker_journey_station_electric" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:drawablePadding="@dimen/space_m"
                    android:gravity="center_vertical"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/welcome_fleet_mixed"
                    android:textAppearance="@style/TextAppearance.RoueLibre.Body"
                    app:drawableStartCompat="@drawable/marker_journey_station_mixed" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- The drawing of the current page. Purely decorative: it repeats what
         the text above says, so a screen reader must not read it a second
         time.

         Placed under the text rather than above it: the text is what one reads
         first, and the drawing is what one is left looking at.

         It takes the height the text leaves rather than a written-down size: a
         fixed height leaves a hole on the short pages and steals from the text
         on the long ones. The text is measured first and capped at what the
         screen has; the drawing gets the remainder, and fitCenter keeps its
         proportions whatever that turns out to be.

         So it shrinks as the font grows, and at the largest sizes it goes
         altogether rather than pushing a paragraph below the fold. That is the
         right order: the drawing helps the text, it does not replace it — and
         it is why the fleet page's marks are not put here: what may vanish
         must not be what carries the meaning. -->
    <ImageView
        android:id="@+id/illustration"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginTop="@dimen/space_l"
        android:layout_marginEnd="@dimen/space_l"
        android:layout_marginBottom="@dimen/space_l"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toTopOf="@id/step"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/body_container"
        app:layout_constraintVertical_weight="2"
        tools:src="@drawable/illustration_welcome_hello" />

    <TextView
        android:id="@+id/step"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginBottom="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.RoueLibre.Label"
        app:layout_constraintBottom_toTopOf="@id/next"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="1 SUR 3" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/next"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target_min"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginEnd="@dimen/space_l"
        android:layout_marginBottom="@dimen/space_s"
        app:layout_constraintBottom_toTopOf="@id/skip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Continuer" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/skip"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target_min"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginEnd="@dimen/space_l"
        android:layout_marginBottom="@dimen/space_l"
        android:textColor="@color/signal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Passer" />

</androidx.constraintlayout.widget.ConstraintLayout>
