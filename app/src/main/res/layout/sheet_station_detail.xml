<?xml version="1.0" encoding="utf-8"?>
<!--
    A station's detail (SPEC §7.2), in a sheet sliding up from the bottom.

    Both counts are shown side by side, each with its indicator: leaving needs a
    bike, arriving needs a dock, and whoever opens this sheet may be after
    either. It is the application's only view that gives both at one glance.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/space_l"
    android:paddingTop="@dimen/space_m"
    android:paddingEnd="@dimen/space_l"
    android:paddingBottom="@dimen/space_l">

    <TextView
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.RoueLibre.Title"
        app:layout_constraintEnd_toStartOf="@id/favourite"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Gare Lille Flandres" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/favourite"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        app:icon="@drawable/ic_favourite"
        app:iconTint="@color/signal"
        app:layout_constraintBottom_toBottomOf="@id/name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/name" />

    <!-- The address derived from the offline index: the network's feed
         publishes none. Hidden when the index is absent or knows nothing near
         enough — better to say nothing than to name the wrong street. -->
    <TextView
        android:id="@+id/address"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.RoueLibre.Secondary"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/name"
        tools:text="12 Rue Nationale · 59800 Lille"
        tools:visibility="visible" />

    <!-- A state banner, shown only when the station does not provide its
         service: a station that works has no need to announce itself. -->
    <TextView
        android:id="@+id/service_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:background="@drawable/pill_surface"
        android:paddingStart="@dimen/space_m"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/space_m"
        android:paddingBottom="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.RoueLibre.Body"
        android:textColor="@color/alert"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/address"
        tools:text="Hors service"
        tools:visibility="visible" />

    <!-- Both indicators ask for their own size rather than being given one:
         they hold a figure, and that figure follows the system's font size
         (SPEC §7). -->
    <io.github.mgdx.rouelibre.ui.stations.AvailabilityIndicatorView
        android:id="@+id/bikes_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/service_state" />

    <TextView
        android:id="@+id/bikes_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:text="@string/counterpart_bikes"
        android:textAppearance="@style/TextAppearance.RoueLibre.Label"
        app:layout_constraintBottom_toBottomOf="@id/bikes_indicator"
        app:layout_constraintStart_toEndOf="@id/bikes_indicator"
        app:layout_constraintTop_toTopOf="@id/bikes_indicator" />

    <io.github.mgdx.rouelibre.ui.stations.AvailabilityIndicatorView
        android:id="@+id/docks_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_xl"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toEndOf="@id/bikes_label"
        app:layout_constraintTop_toTopOf="@id/bikes_indicator" />

    <TextView
        android:id="@+id/docks_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:text="@string/counterpart_docks"
        android:textAppearance="@style/TextAppearance.RoueLibre.Label"
        app:layout_constraintBottom_toBottomOf="@id/docks_indicator"
        app:layout_constraintStart_toEndOf="@id/docks_indicator"
        app:layout_constraintTop_toTopOf="@id/docks_indicator" />

    <!-- What those bikes are, where the network lends both kinds (SPEC §7.2).
         Hidden everywhere else, and hidden as soon as the feed's breakdown
         cannot be trusted: the figure above is then the only one shown, and it
         is always true. -->
    <TextView
        android:id="@+id/bikes_split"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.RoueLibre.Secondary"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bikes_indicator"
        tools:text="3 mécaniques · 1 électrique"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/capacity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:textAppearance="@style/TextAppearance.RoueLibre.Secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bikes_split"
        app:layout_goneMarginTop="@dimen/space_m"
        tools:text="40 points d'attache · mis à jour il y a 12 secondes" />

    <!--
        Origin and destination side by side: they are two faces of one
        gesture, and separating them would send the user looking for the second
        elsewhere (SPEC §7.2).
    -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/set_as_origin"
        style="@style/Widget.RoueLibre.Toggle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target_min"
        android:layout_marginTop="@dimen/space_l"
        android:layout_marginEnd="@dimen/space_s"
        android:text="@string/station_as_origin"
        app:layout_constraintEnd_toStartOf="@id/set_as_destination"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/capacity" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/set_as_destination"
        style="@style/Widget.RoueLibre.Toggle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target_min"
        android:layout_marginStart="@dimen/space_s"
        android:text="@string/station_as_destination"
        app:layout_constraintBottom_toBottomOf="@id/set_as_origin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/set_as_origin"
        app:layout_constraintTop_toTopOf="@id/set_as_origin" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/open_in_navigation"
        style="@style/Widget.RoueLibre.Toggle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target_min"
        android:layout_marginTop="@dimen/space_s"
        android:text="@string/station_open_in_navigation"
        app:icon="@drawable/ic_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/set_as_origin" />

</androidx.constraintlayout.widget.ConstraintLayout>
