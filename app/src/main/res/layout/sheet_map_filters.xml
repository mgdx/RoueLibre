<?xml version="1.0" encoding="utf-8"?>
<!--
    Which stations the map draws (SPEC §7.1), in a sheet sliding up from the
    bottom — the same idiom as a station's detail, and for the same reason: the
    map stays visible behind it, so one sees what a switch takes away while
    taking it away.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_l"
    android:paddingBottom="@dimen/space_l">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginEnd="@dimen/space_l"
        android:layout_marginBottom="@dimen/space_s"
        android:text="@string/map_filter_title"
        android:textAppearance="@style/TextAppearance.RoueLibre.Title" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/hide_out_of_service"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginEnd="@dimen/space_l"
        android:minHeight="@dimen/touch_target_min"
        android:text="@string/map_filter_hide_out_of_service"
        android:textAppearance="@style/TextAppearance.RoueLibre.Body" />

    <!-- The wording follows the mode toggle: "empty" means no bike while bikes
         are counted, and no free dock while docks are. The code sets it. -->
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/hide_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginEnd="@dimen/space_l"
        android:minHeight="@dimen/touch_target_min"
        android:textAppearance="@style/TextAppearance.RoueLibre.Body" />

    <!--
        The rule that makes these filters honest, said where they are set: what
        the feed is silent about is not what it says is absent.
    -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginTop="@dimen/space_m"
        android:layout_marginEnd="@dimen/space_l"
        android:text="@string/map_filter_keeps_unknown"
        android:textAppearance="@style/TextAppearance.RoueLibre.Secondary" />

</LinearLayout>
