<?xml version="1.0" encoding="utf-8"?>
<!--
    Comment désigner un point de trajet (SPEC §7.3).

    Quatre entrées, alignées, toutes de la même taille : aucune n'est le
    « bon » choix par défaut, cela dépend de ce que l'utilisateur sait de
    l'endroit qu'il vise.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_l"
    android:paddingTop="@dimen/space_l"
    android:paddingEnd="@dimen/space_l"
    android:paddingBottom="@dimen/space_l">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_m"
        android:textAppearance="@style/TextAppearance.RoueLibre.Title"
        tools:text="Partir d'où ?" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/my_position"
        style="@style/Widget.RoueLibre.Toggle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_target_min"
        android:gravity="start|center_vertical"
        android:text="@string/journey_source_my_position"
        app:icon="@drawable/ic_my_location" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/address"
        style="@style/Widget.RoueLibre.Toggle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginTop="@dimen/space_s"
        android:gravity="start|center_vertical"
        android:text="@string/journey_source_address"
        app:icon="@drawable/ic_search" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/favourite"
        style="@style/Widget.RoueLibre.Toggle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginTop="@dimen/space_s"
        android:gravity="start|center_vertical"
        android:text="@string/journey_source_favourite"
        app:icon="@drawable/ic_favourite" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/on_map"
        style="@style/Widget.RoueLibre.Toggle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginTop="@dimen/space_s"
        android:gravity="start|center_vertical"
        android:text="@string/journey_source_on_map"
        app:icon="@drawable/ic_pin" />

</LinearLayout>
