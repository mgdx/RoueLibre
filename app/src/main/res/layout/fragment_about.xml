<?xml version="1.0" encoding="utf-8"?>
<!--
    The "about" screen (SPEC §7.7).

    Three things are owed here, not offered: the attributions of §4.5, the
    privacy policy in plain words, and the application's licence. The rest is
    context.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/about_title"
        app:titleTextAppearance="@style/TextAppearance.RoueLibre.Title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_l"
            android:paddingTop="@dimen/space_s"
            android:paddingEnd="@dimen/space_l"
            android:paddingBottom="@dimen/space_xxl">

            <TextView
                android:id="@+id/version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.RoueLibre.Secondary"
                tools:text="Version 0.1.0-alpha" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/about_privacy_title"
                android:textAppearance="@style/TextAppearance.RoueLibre.Label" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/about_privacy_body"
                android:textAppearance="@style/TextAppearance.RoueLibre.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/about_attributions_title"
                android:textAppearance="@style/TextAppearance.RoueLibre.Label" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/about_attribution_gbfs"
                android:textAppearance="@style/TextAppearance.RoueLibre.Body" />

            <!-- The served network's credit: it comes from the city
                 configuration, never from the code (SPEC §15), and the ODbL
                 licence of the feeds requires it (SPEC §4.5). Set in a
                 secondary style: it is the credit, not the description. -->
            <TextView
                android:id="@+id/network_attribution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.RoueLibre.Secondary"
                tools:text="Données V'lille — Ilevia / MEL, licence ODbL" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/about_attribution_osm"
                android:textAppearance="@style/TextAppearance.RoueLibre.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/about_attribution_ban"
                android:textAppearance="@style/TextAppearance.RoueLibre.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/about_attribution_brouter"
                android:textAppearance="@style/TextAppearance.RoueLibre.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/about_attribution_maplibre"
                android:textAppearance="@style/TextAppearance.RoueLibre.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/about_links_title"
                android:textAppearance="@style/TextAppearance.RoueLibre.Label" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/about_links_body"
                android:textAppearance="@style/TextAppearance.RoueLibre.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/about_licence_title"
                android:textAppearance="@style/TextAppearance.RoueLibre.Label" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/about_licence_body"
                android:textAppearance="@style/TextAppearance.RoueLibre.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_repository"
                style="@style/Widget.RoueLibre.Toggle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/about_open_repository" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_welcome"
                style="@style/Widget.RoueLibre.Toggle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/welcome_open" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_whats_new"
                style="@style/Widget.RoueLibre.Toggle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/whats_new_open" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_licences"
                style="@style/Widget.RoueLibre.Toggle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/about_open_licences" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
