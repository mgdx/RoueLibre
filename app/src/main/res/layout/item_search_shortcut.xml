<?xml version="1.0" encoding="utf-8"?>
<!--
    One way of designating a point other than by typing its address
    (SPEC §7.3): one's position, a favourite station, a point on the map.

    The same grammar as an address row — icon, then label — because these rows
    sit at the head of the same list: they are proposals like the others, and
    the first of them is always there, whatever is typed.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:minHeight="@dimen/touch_target_min"
    android:paddingStart="@dimen/space_l"
    android:paddingTop="@dimen/space_m"
    android:paddingEnd="@dimen/space_l"
    android:paddingBottom="@dimen/space_m">

    <ImageView
        android:id="@+id/shortcut_icon"
        android:layout_width="@dimen/space_xl"
        android:layout_height="@dimen/space_xl"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/signal"
        tools:src="@drawable/ic_my_location" />

    <TextView
        style="@style/Widget.RoueLibre.Name"
        android:id="@+id/shortcut_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:textAppearance="@style/TextAppearance.RoueLibre.Body"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/shortcut_icon"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="My position" />

</androidx.constraintlayout.widget.ConstraintLayout>
