<?xml version="1.0" encoding="utf-8"?>
<!--
    Journey result (SPEC §7.4).

    The two ends stay at the top, where they were asked for and where they can
    be corrected without going back. The map takes whatever room is left, and
    the detail is anchored to the bottom edge: one reads the total time with the
    thumb already on it, and the screen never shows a band of nothing under the
    last line.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- No title: the screen says what it is by what it shows, and a whole bar
         spent repeating the word "journey" pushed the two ends — the part one
         comes here to read and to correct — a row further down. The way back
         stays, on the row of the first field, so nothing is lost but the word. -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_target_min"
        app:layout_constraintBottom_toBottomOf="@id/origin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/origin"
        app:navigationIcon="@drawable/ic_back" />

    <!-- The two ends, in the shape the search screen gave them: a press
         reopens the address search, and the answer recomputes the journey. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/origin"
        style="@style/Widget.RoueLibre.Toggle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:gravity="start|center_vertical"
        android:minHeight="@dimen/touch_target_min"
        app:layout_constraintEnd_toStartOf="@id/swap"
        app:layout_constraintStart_toEndOf="@id/toolbar"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="12 bis Rue Nationale" />

    <!-- No start margin here: this field's edges are those of the one above. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/destination"
        style="@style/Widget.RoueLibre.Toggle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:gravity="start|center_vertical"
        android:minHeight="@dimen/touch_target_min"
        app:layout_constraintEnd_toEndOf="@id/origin"
        app:layout_constraintStart_toStartOf="@id/origin"
        app:layout_constraintTop_toBottomOf="@id/origin"
        tools:text="Gare Lille Flandres" />

    <!-- Origin / destination swap (SPEC §7.3), between the two fields and
         to their right: the position says what the button exchanges. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/swap"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginStart="@dimen/space_s"
        android:layout_marginEnd="@dimen/space_l"
        android:contentDescription="@string/journey_swap"
        app:icon="@drawable/ic_swap"
        app:iconTint="@color/ink"
        app:layout_constraintBottom_toBottomOf="@id/destination"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/origin" />

    <!-- The map takes what the fields and the detail leave: no fixed ratio, so
         a short detail widens the map instead of leaving a gap. -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/map"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_s"
        app:layout_constraintBottom_toTopOf="@id/detail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/destination" />

    <TextView
        android:id="@+id/attribution"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/map_label_halo"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="@dimen/space_s"
        android:paddingTop="2dp"
        android:paddingEnd="@dimen/space_s"
        android:paddingBottom="2dp"
        android:text="@string/map_attribution"
        android:textAppearance="@style/TextAppearance.RoueLibre.Label"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="@id/map"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Back to the whole journey. It undoes what the button under it does:
         once the map has come down onto the walker, or a pan has taken it off
         the track, this is the way back to the shape of the journey without
         recomputing it. Above "locate me" because it is the wider of the two
         views, and it is hidden while there is no track to frame. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/frame_journey"
        style="@style/Widget.Material3.Button.IconButton.Filled"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginBottom="@dimen/space_s"
        android:contentDescription="@string/journey_frame"
        android:visibility="gone"
        app:backgroundTint="@color/surface"
        app:icon="@drawable/ic_frame_journey"
        app:iconTint="@color/ink"
        app:layout_constraintBottom_toTopOf="@id/locate_me"
        app:layout_constraintEnd_toEndOf="@id/locate_me"
        tools:visibility="visible" />

    <!-- Locate me, at the corner of the map the thumb reaches: it brings the
         framing back onto the walker, as close as the tiles allow. The
         permission is asked for here, at the moment it is understood
         (SPEC §10). -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/locate_me"
        style="@style/Widget.Material3.Button.IconButton.Filled"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginEnd="@dimen/space_m"
        android:layout_marginBottom="@dimen/space_s"
        android:contentDescription="@string/map_locate_me"
        app:backgroundTint="@color/surface"
        app:icon="@drawable/ic_my_location"
        app:iconTint="@color/ink"
        app:layout_constraintBottom_toTopOf="@id/attribution"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- How far up the detail may climb when it is long. Below it, the map
         would no longer be a map. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/detail_ceiling"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.45" />

    <!--
        The detail, laid against the bottom edge.

        It is as tall as it needs to be and no taller — hence the wrap, held to
        its constraints — and it is the bottom of the screen it hangs from, so
        the last button sits where the thumb already is. Past the ceiling it
        scrolls rather than eating the map.
    -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/detail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/detail_ceiling"
        app:layout_constraintVertical_bias="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_m"
            android:paddingBottom="@dimen/space_m">

            <!--
                Everything the screen has to say, and the way to the rest of it.

                The block is the button: the time, the summary and the drawing
                are what one reads, and pressing them is how one asks for the
                journey in full. A row spent on a "details" button said the
                same thing in words, below the drawing it was talking about,
                and took the height from the map to say it.

                The horizontal padding sits here rather than on the column, so
                the ripple runs the whole width of the screen: a press near the
                edge is a press on the block, and it must look like one.
            -->
            <LinearLayout
                android:id="@+id/summary_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_l"
                android:paddingTop="@dimen/space_s"
                android:paddingEnd="@dimen/space_l"
                android:paddingBottom="@dimen/space_s">

                <!--
                    The total time, the information one comes for, and beside it
                    what makes it up.

                    On one row rather than two: the summary is the same sentence
                    either way, and set under the figure it pushed the drawing
                    and everything after it a line further down for nothing. The
                    summary takes the width the figure leaves and wraps under
                    itself, and it starts at the figure's own top rather than on
                    its baseline: a summary of two lines then stands beside the
                    figure instead of hanging below it, which is another few
                    pixels the map keeps.
                -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/total_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/bricolage_semibold"
                        android:textAppearance="@style/TextAppearance.RoueLibre.Title"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="24 min" />

                    <!-- A weighted row would have done, were it not for
                         LinearLayout measuring its own height before it hands
                         the summary its share of the width: the second line of
                         a summary that wraps then falls outside the row and is
                         cut off by the drawing under it. -->
                    <TextView
                        android:id="@+id/summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:textAppearance="@style/TextAppearance.RoueLibre.Secondary"
                        app:layout_constraintEnd_toStartOf="@id/detail_chevron"
                        app:layout_constraintStart_toEndOf="@id/total_time"
                        app:layout_constraintTop_toTopOf="@id/total_time"
                        tools:text="dont 9 min à pied et 13 min à vélo · 4,1 km · 45 m de dénivelé" />

                    <!-- The one mark saying the block goes somewhere. It is
                         hidden when there is nothing to open, so the sign never
                         promises a screen that does not exist. -->
                    <ImageView
                        android:id="@+id/detail_chevron"
                        android:layout_width="@dimen/space_xl"
                        android:layout_height="@dimen/space_xl"
                        android:importantForAccessibility="no"
                        app:layout_constraintBottom_toBottomOf="@id/total_time"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/total_time"
                        app:srcCompat="@drawable/ic_chevron"
                        app:tint="@color/ink_soft" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- The whole journey at a glance: how far each leg runs above
                     its stroke, how long it takes below. The detail screen says
                     it again in words, so a screen reader must not read the
                     drawing itself. -->
                <io.github.mgdx.rouelibre.ui.journey.JourneyShapeView
                    android:id="@+id/shape"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- Hands a leg of the journey to whichever application guides
                 along it: this one computes journeys, it does not guide
                 (SPEC §13). Last of the reading — everything the screen offers
                 to do comes after everything it has to say — and absent when
                 there is no journey to hand over. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/navigate"
                style="@style/Widget.RoueLibre.Toggle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginStart="@dimen/space_l"
                android:layout_marginTop="@dimen/space_m"
                android:layout_marginEnd="@dimen/space_l"
                android:text="@string/journey_navigate"
                app:icon="@drawable/ic_navigation"
                app:iconGravity="textStart" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!--
        The wait, while the journey is worked out.

        Declared last so it covers the map and the detail: what is underneath
        belongs to the previous journey, or to none, and showing it half-built
        under a spinner would be showing an answer that is not one yet. The two
        fields stay clear of it: correcting a point is precisely what one does
        while waiting.
    -->
    <LinearLayout
        android:id="@+id/computing"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/colorSurface"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/destination">

        <io.github.mgdx.rouelibre.ui.journey.ComputingBikeView
            android:id="@+id/computing_bike"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/computing_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xxl"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginEnd="@dimen/space_xxl"
            android:gravity="center"
            android:text="@string/journey_computing"
            android:textAppearance="@style/TextAppearance.RoueLibre.Body" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
