<?xml version="1.0" encoding="utf-8"?>
<!--
    Réglages (SPEC §7.6).

    Écrit à la main plutôt qu'avec androidx.preference : cette bibliothèque
    apporte sa propre grammaire visuelle, que les jetons du projet devraient
    ensuite combattre, pour une dizaine de réglages qui tiennent sur un écran.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/settings_title"
        app:titleTextAppearance="@style/TextAppearance.RoueLibre.Title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_l"
            android:paddingTop="@dimen/space_s"
            android:paddingEnd="@dimen/space_l"
            android:paddingBottom="@dimen/space_xxl">

            <!-- La ville sert de cadre à tout le reste, elle vient donc avant. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/city_title"
                android:textAppearance="@style/TextAppearance.RoueLibre.Label" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_city"
                style="@style/Widget.RoueLibre.Toggle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="start|center_vertical"
                android:text="@string/city_open" />

            <!-- Données hors ligne : le réglage le plus consulté, donc en tête. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/settings_data_title"
                android:textAppearance="@style/TextAppearance.RoueLibre.Label" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_storage"
                style="@style/Widget.RoueLibre.Toggle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="start|center_vertical"
                android:text="@string/storage_open"
                app:icon="@drawable/ic_storage" />

            <!-- Thème (SPEC §7.6). -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/settings_theme_title"
                android:textAppearance="@style/TextAppearance.RoueLibre.Label" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/theme_system"
                    style="@style/Widget.RoueLibre.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_weight="1"
                    android:text="@string/settings_theme_system" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/theme_light"
                    style="@style/Widget.RoueLibre.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_weight="1"
                    android:text="@string/settings_theme_light" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/theme_dark"
                    style="@style/Widget.RoueLibre.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_weight="1"
                    android:text="@string/settings_theme_dark" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Temps forfaitaires (SPEC §6). -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/settings_handling_title"
                android:textAppearance="@style/TextAppearance.RoueLibre.Label" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/settings_handling_explanation"
                android:textAppearance="@style/TextAppearance.RoueLibre.Secondary" />

            <include
                android:id="@+id/pickup"
                layout="@layout/item_duration_setting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s" />

            <include
                android:id="@+id/dropoff"
                layout="@layout/item_duration_setting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs" />

            <!-- Sources (SPEC §4.1, §4.4) : l'hébergeur par défaut ne doit
                 jamais être un point de défaillance unique. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/settings_sources_title"
                android:textAppearance="@style/TextAppearance.RoueLibre.Label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/gbfs_field"
                style="@style/Widget.RoueLibre.SearchField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:hint="@string/settings_gbfs_url"
                app:endIconContentDescription="@string/settings_reset_default"
                app:endIconMode="clear_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/gbfs_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.RoueLibre.Secondary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/manifest_field"
                style="@style/Widget.RoueLibre.SearchField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:hint="@string/settings_manifest_url"
                app:endIconContentDescription="@string/settings_reset_default"
                app:endIconMode="clear_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/manifest_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.RoueLibre.Secondary" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/settings_sources_explanation"
                android:textAppearance="@style/TextAppearance.RoueLibre.Secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_about"
                style="@style/Widget.RoueLibre.Toggle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginTop="@dimen/space_l"
                android:gravity="start|center_vertical"
                android:text="@string/about_open" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
