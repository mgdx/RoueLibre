<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings (SPEC §7.6).

    Written by hand rather than with androidx.preference: that library brings
    its own visual grammar, which the project's tokens would then have to fight,
    for a dozen settings that fit on one screen.

    Laid out in sections, in the order SPEC §7.6 fixes: city, journey, display,
    offline data — then the way to "about", which belongs to no section and
    closes the screen. Placing a new setting is meant to be one thing: adding
    its views under the right title, without touching a line above or below.

    A section with nothing in it is not written here at all: a title followed by
    nothing promises a setting the screen does not have, and SPEC §14 wants no
    view built against a feature that has not arrived. "Journey" was that case
    until the walking pace arrived and brought its title with it, between the
    city and the display, exactly as that rule intends.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/settings_title"
        app:titleTextAppearance="@style/TextAppearance.RoueLibre.Title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <!-- No top padding: the first section title carries the air above it
             itself, like every other one. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_l"
            android:paddingEnd="@dimen/space_l"
            android:paddingBottom="@dimen/space_xxl">

            <!-- The city frames everything else — the network served, the data
                 installed, the journeys computed — so it comes first. -->
            <io.github.mgdx.rouelibre.ui.settings.SettingsSectionTitle
                style="@style/Widget.RoueLibre.SettingsSection"
                android:text="@string/settings_section_city" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_city"
                style="@style/Widget.RoueLibre.Toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="start|center_vertical"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/city_open" />

            <!-- Journey: what qualifies a journey before it is asked for
                 (SPEC §7.6). Unlike the display section below, what stands here
                 reaches the algorithm of §6 and changes which stations it
                 chooses — that is what it is for. -->
            <io.github.mgdx.rouelibre.ui.settings.SettingsSectionTitle
                style="@style/Widget.RoueLibre.SettingsSection"
                android:text="@string/settings_section_journey" />

            <!--
                The walking pace (SPEC §6, §7.6). Three named levels in a row,
                like the theme below: no slider and no speed typed in by hand.
                The buttons name a pace in words and never a figure in km/h —
                one knows one walks slowly, and a speed shown here would be read
                as a promise about the minutes announced.
            -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/settings_walking_pace_title"
                android:textAppearance="@style/TextAppearance.RoueLibre.Label" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/walking_pace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:contentDescription="@string/settings_walking_pace_description"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/walking_pace_slow"
                    style="@style/Widget.RoueLibre.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/settings_walking_pace_slow" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/walking_pace_normal"
                    style="@style/Widget.RoueLibre.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/settings_walking_pace_normal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/walking_pace_brisk"
                    style="@style/Widget.RoueLibre.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/settings_walking_pace_brisk" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Display: what the interface looks like and what it writes in.
                 Neither touches the data nor the journeys (SPEC §14). -->
            <io.github.mgdx.rouelibre.ui.settings.SettingsSectionTitle
                style="@style/Widget.RoueLibre.SettingsSection"
                android:text="@string/settings_section_display" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/settings_theme_title"
                android:textAppearance="@style/TextAppearance.RoueLibre.Label" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/theme_system"
                    style="@style/Widget.RoueLibre.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/settings_theme_system" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/theme_light"
                    style="@style/Widget.RoueLibre.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/settings_theme_light" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/theme_dark"
                    style="@style/Widget.RoueLibre.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/settings_theme_dark" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!--
                Units (SPEC §7.6, §9). Four states — the region's own, and the
                three systems that can override it — laid out in a row like the
                theme above. The labels show the units rather than the
                countries: what one gets is what is written, and no system
                belongs to a nation.
            -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/settings_units_title"
                android:textAppearance="@style/TextAppearance.RoueLibre.Label" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/units"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:contentDescription="@string/settings_units_description"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/units_system"
                    style="@style/Widget.RoueLibre.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="@string/settings_units_system_description"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minHeight="@dimen/touch_target_min"
                    android:minWidth="0dp"
                    android:paddingStart="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_xs"
                    android:text="@string/settings_units_system" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/units_metric"
                    style="@style/Widget.RoueLibre.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="@string/settings_units_metric_description"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minHeight="@dimen/touch_target_min"
                    android:minWidth="0dp"
                    android:paddingStart="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_xs"
                    android:text="@string/settings_units_metric" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/units_us"
                    style="@style/Widget.RoueLibre.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="@string/settings_units_us_description"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minHeight="@dimen/touch_target_min"
                    android:minWidth="0dp"
                    android:paddingStart="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_xs"
                    android:text="@string/settings_units_us" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/units_uk"
                    style="@style/Widget.RoueLibre.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="@string/settings_units_uk_description"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minHeight="@dimen/touch_target_min"
                    android:minWidth="0dp"
                    android:paddingStart="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_xs"
                    android:text="@string/settings_units_uk" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!--
                The language the interface speaks (SPEC §7.6, §9). A row that
                opens a list, and not a row of buttons like the theme and the
                units above it: the choices here are the translations that
                actually exist, they grow every time somebody finishes one, and
                each is written in its own language — "Français", "العربية" —
                which no three-across row of buttons would hold. The row carries
                the language in service, so the screen answers the question
                without being pressed.
            -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/settings_language_title"
                android:textAppearance="@style/TextAppearance.RoueLibre.Label" />

            <!-- Its text and its spoken label are both written by the code:
                 what they say is the language chosen, which no resource
                 knows. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/language"
                style="@style/Widget.RoueLibre.Toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="start|center_vertical"
                android:minHeight="@dimen/touch_target_min" />

            <!-- Offline data: what the application occupies, and how to
                 reclaim it (SPEC §4.4). -->
            <io.github.mgdx.rouelibre.ui.settings.SettingsSectionTitle
                style="@style/Widget.RoueLibre.SettingsSection"
                android:text="@string/settings_section_data" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_storage"
                style="@style/Widget.RoueLibre.Toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="start|center_vertical"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/storage_open"
                app:icon="@drawable/ic_storage" />

            <!-- "About" heads no section of its own: it settles nothing and
                 changes nothing, it opens a screen, and a title above it would
                 only repeat the word written on it. What says it belongs to no
                 section is the air above it, one rung wider than the gap a
                 section title takes: read on the phone, at the section's own
                 gap it passed for a second offline-data setting. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_about"
                style="@style/Widget.RoueLibre.Toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxl"
                android:gravity="start|center_vertical"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/about_open" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
