<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings (SPEC §7.6).

    Written by hand rather than with androidx.preference: that library brings
    its own visual grammar, which the project's tokens would then have to fight,
    for a dozen settings that fit on one screen.

    Laid out in sections, in the order SPEC §7.6 fixes: city, display, journey,
    offline data — then the way to "about", which belongs to no section and
    closes the screen. Placing a new setting is meant to be one thing: adding
    its views under the right title, without touching a line above or below.

    A section with nothing in it is not written here at all: a title followed by
    nothing promises a setting the screen does not have, and SPEC §14 wants no
    view built against a feature that has not arrived. "Journey" was that case
    until the walking pace arrived and brought its title with it, exactly as
    that rule intends.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/settings_title"
        app:titleTextAppearance="@style/TextAppearance.RoueLibre.Title" />

    <!-- The id is what keeps the scroll position. Android saves a view's state
         only when it has one, and this screen is long enough that losing it is
         felt: without the id, coming back from "About" or from the offline data
         put the reader back at the top of the settings, every time. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <!-- No top padding: the first section title carries the air above it
             itself, like every other one. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_l"
            android:paddingEnd="@dimen/space_l"
            android:paddingBottom="@dimen/space_xxl">

            <!-- The city frames everything else — the network served, the data
                 installed, the journeys computed — so it comes first. -->
            <io.github.mgdx.rouelibre.ui.settings.SettingsSectionTitle
                style="@style/Widget.RoueLibre.SettingsSection"
                android:text="@string/settings_section_city" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_city"
                style="@style/Widget.RoueLibre.Toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="start|center_vertical"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/city_open" />

            <!-- Display: what the interface looks like and what it writes in.
                 Neither touches the data nor the journeys (SPEC §14). It comes
                 before the journey section because what one settles on arriving
                 is what one is looking at, while a journey has not been asked
                 for yet. -->
            <io.github.mgdx.rouelibre.ui.settings.SettingsSectionTitle
                style="@style/Widget.RoueLibre.SettingsSection"
                android:text="@string/settings_section_display" />

            <!--
                The language the interface speaks (SPEC §7.6, §9). It opens the
                display section because it decides how everything under it is
                read, the labels of the other settings included.

                A row that opens a list, and not a row of buttons like the theme
                and the units under it: the choices here are the translations
                that actually exist, they grow every time somebody finishes one,
                and each is written in its own language — "Français", "العربية" —
                which no three-across row of buttons would hold. The row carries
                the language in service, so the screen answers the question
                without being pressed.
            -->
            <TextView
                style="@style/Widget.RoueLibre.SettingsLabel"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/settings_language_title" />

            <!-- Its text and its spoken label are both written by the code:
                 what they say is the language chosen, which no resource
                 knows. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/language"
                style="@style/Widget.RoueLibre.Toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="start|center_vertical"
                android:minHeight="@dimen/touch_target_min" />

            <TextView
                style="@style/Widget.RoueLibre.SettingsLabel"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/settings_theme_title" />

            <io.github.mgdx.rouelibre.ui.ToggleRow
                android:id="@+id/theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/theme_system"
                    style="@style/Widget.RoueLibre.Toggle.Choice"
                    android:text="@string/settings_theme_system" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/theme_light"
                    style="@style/Widget.RoueLibre.Toggle.Choice"
                    android:text="@string/settings_theme_light" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/theme_dark"
                    style="@style/Widget.RoueLibre.Toggle.Choice"
                    android:text="@string/settings_theme_dark" />
            </io.github.mgdx.rouelibre.ui.ToggleRow>

            <!--
                Units (SPEC §7.6, §9). Four states — the region's own, and the
                three systems that can override it — laid out in a row like the
                theme above. The labels show the units rather than the
                countries: what one gets is what is written, and no system
                belongs to a nation.
            -->
            <TextView
                style="@style/Widget.RoueLibre.SettingsLabel"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/settings_units_title" />

            <io.github.mgdx.rouelibre.ui.ToggleRow
                android:id="@+id/units"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:contentDescription="@string/settings_units_description"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/units_system"
                    style="@style/Widget.RoueLibre.Toggle.Choice"
                    android:contentDescription="@string/settings_units_system_description"
                    android:text="@string/settings_units_system" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/units_metric"
                    style="@style/Widget.RoueLibre.Toggle.Choice"
                    android:contentDescription="@string/settings_units_metric_description"
                    android:text="@string/settings_units_metric" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/units_us"
                    style="@style/Widget.RoueLibre.Toggle.Choice"
                    android:contentDescription="@string/settings_units_us_description"
                    android:text="@string/settings_units_us" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/units_uk"
                    style="@style/Widget.RoueLibre.Toggle.Choice"
                    android:contentDescription="@string/settings_units_uk_description"
                    android:text="@string/settings_units_uk" />
            </io.github.mgdx.rouelibre.ui.ToggleRow>

            <!--
                The screen the application opens on (SPEC §7.0, §7.6). Two
                choices in a row, like the theme and the units above. The map
                is the default and the first of the two: it is what §7.0 opens
                on, and what somebody who never comes here goes on seeing.
            -->
            <TextView
                style="@style/Widget.RoueLibre.SettingsLabel"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/settings_opening_title" />

            <io.github.mgdx.rouelibre.ui.ToggleRow
                android:id="@+id/opening_screen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:contentDescription="@string/settings_opening_description"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/opening_screen_map"
                    style="@style/Widget.RoueLibre.Toggle.Choice"
                    android:text="@string/settings_opening_map" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/opening_screen_list"
                    style="@style/Widget.RoueLibre.Toggle.Choice"
                    android:text="@string/settings_opening_list" />
            </io.github.mgdx.rouelibre.ui.ToggleRow>

            <!--
                Which stations the map draws at all (SPEC §7.1), the sequel to
                the map's own toggle saying what a marker counts.

                They are set here and nowhere else, and the map shows no trace
                of them: no pill, no count, no lit control. That is a decision
                and the compromise it carries is named in SPEC §7.1 — a filter
                outlives the session with nothing on screen to recall it, so
                these lines are the only explanation a user has for a
                neighbourhood short of its stations. They therefore say in full
                what they take away, and what they never take.
            -->
            <TextView
                style="@style/Widget.RoueLibre.SettingsLabel"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/settings_map_filters_title" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/hide_out_of_service_stations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/settings_map_filters_hide_out_of_service"
                android:textAppearance="@style/TextAppearance.RoueLibre.Body" />

            <!-- One switch for both modes, worded to hold in either: the
                 Bikes / Free docks button is a state of the map screen, which
                 this screen knows nothing about. The line under it says what
                 "nothing" is read against. -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/hide_empty_stations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/settings_map_filters_hide_empty"
                android:textAppearance="@style/TextAppearance.RoueLibre.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/settings_map_filters_hide_empty_hint"
                android:textAppearance="@style/TextAppearance.RoueLibre.Secondary" />

            <!-- The rule that makes both filters honest, and now the only place
                 it is written: what the feed is silent about is not what it
                 says is absent. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/settings_map_filters_keeps_unknown"
                android:textAppearance="@style/TextAppearance.RoueLibre.Secondary" />

            <!-- Journey: what qualifies a journey before it is asked for
                 (SPEC §7.6). Unlike the display section above, what stands here
                 reaches the algorithm of §6 and changes which stations it
                 chooses — that is what it is for. -->
            <io.github.mgdx.rouelibre.ui.settings.SettingsSectionTitle
                style="@style/Widget.RoueLibre.SettingsSection"
                android:text="@string/settings_section_journey" />

            <!--
                What the rider's own bike is (SPEC §7.3, §7.6). Three states,
                the leftmost saying nothing, on the pattern of the pace under
                it. It heads the section because it says who the cyclist is
                before the pace says how they walk.

                It is NOT the kind of bike asked of the network, which lives on
                the journey screen, exists only where the network lends both
                kinds, and narrows the stations the algorithm may choose. This
                one is a fact about the rider: their bike belongs to no fleet, it
                is the same in every city, so it is offered everywhere and asks
                nothing of `FleetDescription.isMixed`. Declared as a pedal-assist
                bike it changes what is drawn, what is said and — since
                17 August 2026 — the ride itself, traced with a profile of its
                own; the other two states give the ride of before, to the track
                and to the minute. The line under the buttons says as much.
            -->
            <TextView
                style="@style/Widget.RoueLibre.SettingsLabel"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/settings_own_bike_kind_title" />

            <io.github.mgdx.rouelibre.ui.ToggleRow
                android:id="@+id/own_bike_kind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:contentDescription="@string/settings_own_bike_kind_description"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/own_bike_kind_unspecified"
                    style="@style/Widget.RoueLibre.Toggle.Choice"
                    android:text="@string/settings_own_bike_kind_unspecified" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/own_bike_kind_mechanical"
                    style="@style/Widget.RoueLibre.Toggle.Choice"
                    android:text="@string/settings_own_bike_kind_mechanical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/own_bike_kind_electric"
                    style="@style/Widget.RoueLibre.Toggle.Choice"
                    android:text="@string/settings_own_bike_kind_electric" />
            </io.github.mgdx.rouelibre.ui.ToggleRow>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/settings_own_bike_kind_hint"
                android:textAppearance="@style/TextAppearance.RoueLibre.Secondary" />

            <!--
                The walking pace (SPEC §6, §7.6). Three named levels in a row,
                like the theme above: no slider and no speed typed in by hand.
                The buttons name a pace in words and never a figure in km/h —
                one knows one walks slowly, and a speed shown here would be read
                as a promise about the minutes announced.
            -->
            <TextView
                style="@style/Widget.RoueLibre.SettingsLabel"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/settings_walking_pace_title" />

            <io.github.mgdx.rouelibre.ui.ToggleRow
                android:id="@+id/walking_pace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:contentDescription="@string/settings_walking_pace_description"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/walking_pace_slow"
                    style="@style/Widget.RoueLibre.Toggle.Choice"
                    android:text="@string/settings_walking_pace_slow" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/walking_pace_normal"
                    style="@style/Widget.RoueLibre.Toggle.Choice"
                    android:text="@string/settings_walking_pace_normal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/walking_pace_brisk"
                    style="@style/Widget.RoueLibre.Toggle.Choice"
                    android:text="@string/settings_walking_pace_brisk" />
            </io.github.mgdx.rouelibre.ui.ToggleRow>

            <!-- Offline data: what the application occupies, and how to
                 reclaim it (SPEC §4.4). -->
            <io.github.mgdx.rouelibre.ui.settings.SettingsSectionTitle
                style="@style/Widget.RoueLibre.SettingsSection"
                android:text="@string/settings_section_data" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_storage"
                style="@style/Widget.RoueLibre.Toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="start|center_vertical"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/storage_open"
                app:icon="@drawable/ic_storage" />

            <!--
                What connection a dataset may travel on (SPEC §4.4). Under the
                way to the storage screen, because what it settles is what
                happens there: a city weighs from a few megabytes to more than a
                gigabyte.

                It names the billing and not the Wi-Fi, which is what Android
                actually decides on and the truer word besides: a phone's shared
                connection is Wi-Fi and is a mobile plan. The line under it says
                so in ordinary words, since the accurate one is not the common
                one.
            -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/download_unmetered_only"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/download_unmetered_only"
                android:textAppearance="@style/TextAppearance.RoueLibre.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/download_unmetered_only_description"
                android:textAppearance="@style/TextAppearance.RoueLibre.Secondary" />

            <!-- "About" heads no section of its own: it settles nothing and
                 changes nothing, it opens a screen, and a title above it would
                 only repeat the word written on it. What says it belongs to no
                 section is the air above it, one rung wider than the gap a
                 section title takes: read on the phone, at the section's own
                 gap it passed for a second offline-data setting. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_about"
                style="@style/Widget.RoueLibre.Toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxl"
                android:gravity="start|center_vertical"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/about_open" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
