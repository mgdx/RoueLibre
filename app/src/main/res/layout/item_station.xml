<?xml version="1.0" encoding="utf-8"?>
<!--
    One station row.

    Tonal separation and a one-pixel rule rather than a drop-shadowed card: the
    list must read as a table, not as a stack of floating objects (SPEC §7).

    `start`/`end` throughout, never `left`/`right`: the layouts must hold in a
    right-to-left language (SPEC §9).

    The row does not paint its own background: the list does it, once and for
    all. Repainting it per row would draw the same flat twice per pixel.

    The root is a `StationRow` and not a plain `ConstraintLayout`: the name and
    the count share the row's width, and past a certain text size there is not
    enough of it for both. What happens then, and why it is decided by measuring
    rather than by a font scale, is in that class.
-->
<io.github.mgdx.rouelibre.ui.stations.StationRow
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/touch_target_min"
    android:paddingStart="@dimen/space_l"
    android:paddingTop="@dimen/space_m"
    android:paddingEnd="@dimen/space_l"
    android:paddingBottom="@dimen/space_m">

    <!-- The indicator asks for its own size rather than being given one: it
         holds a figure, and that figure follows the system's font size
         (SPEC §7). -->
    <io.github.mgdx.rouelibre.ui.stations.AvailabilityIndicatorView
        android:id="@+id/indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
        The counterpart count: the docks when the indicator shows bikes, and
        the other way round. Both figures matter — one to leave, one to arrive —
        but only one deserves the indicator.

        Figure and label form one block, so the text on the left stops at the
        wider of the two. Constrained separately, the label "PLACES", wider than
        the figure, slid under the station's name.

        The gap between the two is carried by the name's end margin, not by
        this block's start margin: a margin on a side that carries no
        constraint is ignored, which showed up in Arabic, where name and label
        ended up flush against one another.
    -->
    <LinearLayout
        android:id="@+id/counterpart_block"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/counterpart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:fontFamily="@font/bricolage_semibold"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.RoueLibre.Body"
            android:textColor="@color/ink_soft"
            tools:text="21" />

        <TextView
            android:id="@+id/counterpart_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:textAppearance="@style/TextAppearance.RoueLibre.Label"
            tools:text="places" />
    </LinearLayout>

    <!--
        No line limit and nothing to ellipsize with: a station's name is written
        whole or it names nothing (SPEC §7). At the normal text size it fits on
        one line and the row is the one it always was; past that it takes the
        lines it needs and the row grows taller.

        Its top hangs from the row and not from the indicator beside it, which
        it did while it was one line. The indicator is centred on the row, so
        anchoring the text to it made the row's height depend on where the
        indicator sat and the indicator's position depend on the row's height: a
        one-line row resolved that circle at the right answer because the
        indicator was the taller of the two, and a wrapped one resolved it at
        twice the height it needed. At the normal text size the indicator is
        still the taller, so its top is the row's top and nothing has moved.
    -->
    <TextView
        style="@style/Widget.RoueLibre.Name"
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginEnd="@dimen/space_m"
        android:textAppearance="@style/TextAppearance.RoueLibre.Body"
        app:layout_constraintEnd_toStartOf="@id/counterpart_block"
        app:layout_constraintStart_toEndOf="@id/indicator"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Gare Lille Flandres" />

    <TextView
        style="@style/Widget.RoueLibre.Name"
        android:id="@+id/detail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.RoueLibre.Secondary"
        app:layout_constraintEnd_toEndOf="@id/name"
        app:layout_constraintStart_toStartOf="@id/name"
        app:layout_constraintTop_toBottomOf="@id/name"
        tools:text="59000 · 40 points d'attache" />

</io.github.mgdx.rouelibre.ui.stations.StationRow>
