<?xml version="1.0" encoding="utf-8"?>
<!--
    One station row.

    Tonal separation and a one-pixel rule rather than a drop-shadowed card: the
    list must read as a table, not as a stack of floating objects (SPEC §7).

    `start`/`end` throughout, never `left`/`right`: the layouts must hold in a
    right-to-left language (SPEC §9).

    The row does not paint its own background: the list does it, once and for
    all. Repainting it per row would draw the same flat twice per pixel.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/touch_target_min"
    android:paddingStart="@dimen/space_l"
    android:paddingTop="@dimen/space_m"
    android:paddingEnd="@dimen/space_l"
    android:paddingBottom="@dimen/space_m">

    <io.github.mgdx.rouelibre.ui.stations.AvailabilityIndicatorView
        android:id="@+id/indicator"
        android:layout_width="@dimen/indicator_size"
        android:layout_height="@dimen/indicator_size"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
        The counterpart count: the docks when the indicator shows bikes, and
        the other way round. Both figures matter — one to leave, one to arrive —
        but only one deserves the indicator.

        Figure and label form one block, so the text on the left stops at the
        wider of the two. Constrained separately, the label "PLACES", wider than
        the figure, slid under the station's name.
    -->
    <LinearLayout
        android:id="@+id/counterpart_block"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:gravity="end"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/counterpart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:fontFamily="@font/bricolage_semibold"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.RoueLibre.Body"
            android:textColor="@color/ink_soft"
            tools:text="21" />

        <TextView
            android:id="@+id/counterpart_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:textAppearance="@style/TextAppearance.RoueLibre.Label"
            tools:text="places" />
    </LinearLayout>

    <TextView
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.RoueLibre.Body"
        app:layout_constraintEnd_toStartOf="@id/counterpart_block"
        app:layout_constraintStart_toEndOf="@id/indicator"
        app:layout_constraintTop_toTopOf="@id/indicator"
        tools:text="Gare Lille Flandres" />

    <TextView
        android:id="@+id/detail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.RoueLibre.Secondary"
        app:layout_constraintEnd_toEndOf="@id/name"
        app:layout_constraintStart_toStartOf="@id/name"
        app:layout_constraintTop_toBottomOf="@id/name"
        tools:text="59000 · 40 points d'attache" />

</androidx.constraintlayout.widget.ConstraintLayout>
