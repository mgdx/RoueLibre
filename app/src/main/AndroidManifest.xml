<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Permissions demandées, et aucune autre (SPEC §10).
        INTERNET sert au seul flux GBFS et au téléchargement, sur action
        explicite, des jeux de données hors ligne.
        Les permissions de localisation seront demandées au moment de l'usage,
        jamais au lancement, et leur refus ne doit bloquer aucun écran.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        Localisation : demandée au moment de l'usage, sur appui du bouton « me
        localiser », et jamais au lancement. Son refus ne bloque aucun écran —
        l'utilisateur désigne alors ses points à la main (SPEC §10).
        La position est obtenue du fournisseur du système, jamais des services
        de localisation fusionnés de Google, et ne quitte pas l'appareil.
        L'application n'est PAS déclarée exigeante en localisation : elle doit
        s'installer sur un appareil sans GPS.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />

    <application
        android:name=".RoueLibreApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RoueLibre">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Ouverture d'un lieu depuis une autre application (SPEC §7.8).
                L'application apparaît dans le sélecteur d'Android et peut y
                être retenue par défaut — mais elle ne se déclare jamais
                elle-même comme gestionnaire : ce choix appartient à
                l'utilisateur.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>

            <!-- Encore émis par de nombreuses applications. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="google.navigation" />
            </intent-filter>

            <!--
                Liens web cartographiques. Ils NE SONT PAS vérifiés
                automatiquement — les domaines n'appartiennent pas au projet —
                donc depuis Android 12 ils ne parviennent à l'application que
                si l'utilisateur l'autorise dans les paramètres du système.
                La marche à suivre est expliquée dans l'écran « À propos » et
                dans le README, faute de quoi le comportement passerait pour un
                défaut.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Un attribut par balise : Android les combine entre elles,
                     et les mélanger ferait accepter des adresses qu'on ne
                     croyait pas déclarer. -->
                <data android:scheme="https" />
                <data android:host="www.openstreetmap.org" />
                <data android:host="openstreetmap.org" />
                <data android:host="maps.google.com" />
            </intent-filter>

            <!--
                Partage de texte : le cas le plus fréquent en pratique, une
                adresse reçue par messagerie. Le texte est analysé sur
                l'appareil, et résolu par l'index d'adresses local.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>

</manifest>
